# The formatting every file in this repository already follows, said once
# so an editor keeps to it. Formatting only: no analyzer severities, so this
# changes nothing a build reports.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

# Markdown keeps trailing spaces: two of them are a line break.
[*.md]
trim_trailing_whitespace = false
