{
  "trees": {
    "work": {
      "path": ".",
      "can": ["list", "read", "create", "update", "rename", "delete", "execute"]}
  },
  "tasks": {
    "build":                { "run": "bash build.sh build",    "cwd": "." },
    "test":                 { "run": "bash build.sh test",     "cwd": "." },
    "check":                { "run": "bash build.sh check",    "cwd": "." },
    "all":                  { "run": "bash build.sh all",      "cwd": "." },
    "machines":             { "run": "bash build.sh machines", "cwd": "." },
    "stage":                { "run": "bash build.sh stage",    "cwd": "." },
    "vsix":                 { "run": "bash build.sh vsix",     "cwd": "." },
    "install":              { "run": "bash build.sh install",  "cwd": "." },
    "build-clean":          { "run": "bash build.sh clean",    "cwd": "." },
    "run":                  { "run": "bash build.sh run {shoddy-mill}",   "cwd": "." },
    "weave":                { "run": "bash build.sh weave {shoddy-mill}", "cwd": "." },
    "status":               { "run": "bash scripts/shoddy-status.sh {release-version}", "cwd": "." },

    "feature":              { "run": "bash scripts/shoddy-branch.sh feature {feature-branch}", "cwd": "." },
    "bug":                  { "run": "bash scripts/shoddy-branch.sh bug {bug-branch}", "cwd": "." },
    "sync":                 { "run": "bash scripts/shoddy-branch.sh sync", "cwd": "." },
    "land":                 { "run": "bash scripts/shoddy-branch.sh land -Yes", "cwd": "." },
    "checkin":              { "run": "bash scripts/shoddy-commit.sh -Message {commit-note}", "cwd": "." },
    "pr":                   { "run": "bash scripts/shoddy-pr.sh", "cwd": "." },
    "ship":                 { "run": "bash scripts/shoddy-ship.sh {release-version} -Yes", "cwd": "." },
    "display":              { "run": "bash scripts/shoddy-display.sh", "cwd": "." },
    "display-list":         { "run": "bash scripts/shoddy-display.sh -List", "cwd": "." },
    "sitemap":              { "run": "bash scripts/shoddy-make-sitemap.sh", "cwd": "." },

    "mcp-build":            { "run": "bash hosts/mcp/build.sh build",   "cwd": "." },
    "mcp-test":             { "run": "bash hosts/mcp/build.sh test",    "cwd": "." },
    "mcp-release":          { "run": "bash hosts/mcp/build.sh release", "cwd": "." },
    "mcp-publish":          { "run": "bash hosts/mcp/build.sh publish {release-version}", "cwd": "." },

    "maui-build":           { "run": "bash hosts/maui/build.sh build",   "cwd": "." },
    "maui-test":            { "run": "bash hosts/maui/build.sh test",    "cwd": "." },
    "maui-release":         { "run": "bash hosts/maui/build.sh release", "cwd": "." },

    "mill-demographics-build": { "run": "bash mills/demographics/build.sh build", "cwd": "." },
    "mill-demographics-train": { "run": "bash mills/demographics/build.sh train", "cwd": "." },
    "mill-demographics-test":  { "run": "bash mills/demographics/build.sh test",  "cwd": "." },
    "mill-demographics-clean": { "run": "bash mills/demographics/build.sh clean", "cwd": "." },

    "mill-devils-dust-test":   { "run": "bash mills/devils-dust/build.sh test", "cwd": "." },

    "mill-emley-moor-build":   { "run": "bash mills/emley-moor/build.sh build", "cwd": "." },
    "mill-emley-moor-test":    { "run": "bash mills/emley-moor/build.sh test",  "cwd": "." },
    "mill-emley-moor-clean":   { "run": "bash mills/emley-moor/build.sh clean", "cwd": "." },

    "mill-halifax-build":      { "run": "bash mills/halifax/build.sh build", "cwd": "." },
    "mill-halifax-test":       { "run": "bash mills/halifax/build.sh test",  "cwd": "." },
    "mill-halifax-demo":       { "run": "bash mills/halifax/build.sh demo",  "cwd": "." },

    "mill-invaders-test":      { "run": "bash mills/invaders/build.sh test", "cwd": "." },

    "mill-iris-build":         { "run": "bash mills/iris/build.sh build", "cwd": "." },
    "mill-iris-train":         { "run": "bash mills/iris/build.sh train", "cwd": "." },
    "mill-iris-test":          { "run": "bash mills/iris/build.sh test",  "cwd": "." },
    "mill-iris-clean":         { "run": "bash mills/iris/build.sh clean", "cwd": "." },

    "mill-mungo-caverns-test": { "run": "bash mills/mungo-caverns/build.sh test", "cwd": "." },
    "mill-oregon-test":        { "run": "bash mills/oregon/build.sh test",        "cwd": "." },
    "mill-pac-vt100-test":     { "run": "bash mills/pac-vt100/build.sh test",     "cwd": "." },

    "mill-simplex-build":      { "run": "bash mills/simplex-from-mps/build.sh build", "cwd": "." },
    "mill-simplex-test":       { "run": "bash mills/simplex-from-mps/build.sh test",  "cwd": "." },
    "mill-simplex-clean":      { "run": "bash mills/simplex-from-mps/build.sh clean", "cwd": "." },

    "mill-sparky-build":       { "run": "bash mills/sparky/build.sh build", "cwd": "." },
    "mill-sparky-test":        { "run": "bash mills/sparky/build.sh test",  "cwd": "." },

    "mill-tally-build":        { "run": "bash mills/tally/build.sh build",   "cwd": "." },
    "mill-tally-test":         { "run": "bash mills/tally/build.sh test",    "cwd": "." },
    "mill-tally-capture":      { "run": "bash mills/tally/build.sh capture", "cwd": "." },
    "mill-tally-clean":        { "run": "bash mills/tally/build.sh clean",   "cwd": "." },

    "mill-weather-glass-build": { "run": "bash mills/weather-glass/build.sh build", "cwd": "." },
    "mill-weather-glass-test":  { "run": "bash mills/weather-glass/build.sh test",  "cwd": "." },
    "mill-weather-glass-clean": { "run": "bash mills/weather-glass/build.sh clean", "cwd": "." },

    "spiro-test":              { "run": "bash tutorials/spiro/build.sh test", "cwd": "." }
  }

}
