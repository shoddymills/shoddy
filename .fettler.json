{
  "trees": {
    "work": {
      "path": ".",
      "can": ["list", "read", "create", "update", "rename", "delete", "execute"]}
  },
  "tasks": {
   "verify-manifests":     { "run": "node scripts/verify-manifests.js", "cwd": "." },
    "survey-readability":   { "run": "node scripts/survey-readability.js", "cwd": "." },
    "build":                { "run": "pwsh -NoProfile -File build.ps1 build",    "cwd": "." },
    "test":                 { "run": "pwsh -NoProfile -File build.ps1 test",     "cwd": "." },
    "check":                { "run": "pwsh -NoProfile -File build.ps1 check",    "cwd": "." },
    "all":                  { "run": "pwsh -NoProfile -File build.ps1 all",      "cwd": "." },
    "machines":             { "run": "pwsh -NoProfile -File build.ps1 machines", "cwd": "." },
    "stage":                { "run": "pwsh -NoProfile -File build.ps1 stage",    "cwd": "." },
    "vsix":                 { "run": "pwsh -NoProfile -File build.ps1 vsix",     "cwd": "." },
    "install":              { "run": "pwsh -NoProfile -File build.ps1 install",  "cwd": "." },
    "build-clean":          { "run": "pwsh -NoProfile -File build.ps1 clean",    "cwd": "." },
    "run":                  { "run": "pwsh -NoProfile -File build.ps1 run {shoddy-mill}",   "cwd": "." },
    "weave":                { "run": "pwsh -NoProfile -File build.ps1 weave {shoddy-mill}", "cwd": "." },
    "status":               { "run": "pwsh -NoProfile -File scripts/shoddy-status.ps1 {release-version}", "cwd": "." },

    "feature":              { "run": "pwsh -NoProfile -File scripts/shoddy-branch.ps1 feature {feature-branch}", "cwd": "." },
    "bug":                  { "run": "pwsh -NoProfile -File scripts/shoddy-branch.ps1 bug {bug-branch}", "cwd": "." },
    "sync":                 { "run": "pwsh -NoProfile -File scripts/shoddy-branch.ps1 sync", "cwd": "." },
    "land":                 { "run": "pwsh -NoProfile -File scripts/shoddy-branch.ps1 land -Yes", "cwd": "." },
    "checkin":              { "run": "pwsh -NoProfile -File scripts/shoddy-commit.ps1 -Message {commit-note}", "cwd": "." },
    "pr":                   { "run": "pwsh -NoProfile -File scripts/shoddy-pr.ps1", "cwd": "." },
    "ship":                 { "run": "pwsh -NoProfile -File scripts/shoddy-ship.ps1 {release-version} -Yes", "cwd": "." },
    "display":              { "run": "pwsh -NoProfile -File scripts/shoddy-display.ps1", "cwd": "." },
    "display-list":         { "run": "pwsh -NoProfile -File scripts/shoddy-display.ps1 -List", "cwd": "." },
    "sitemap":              { "run": "pwsh -NoProfile -File scripts/shoddy-make-sitemap.ps1", "cwd": "." },

    "mcp-build":            { "run": "pwsh -NoProfile -File hosts/mcp/build.ps1 build",   "cwd": "." },
    "mcp-test":             { "run": "pwsh -NoProfile -File hosts/mcp/build.ps1 test",    "cwd": "." },
    "mcp-release":          { "run": "pwsh -NoProfile -File hosts/mcp/build.ps1 release", "cwd": "." },
    "mcp-publish":          { "run": "pwsh -NoProfile -File hosts/mcp/build.ps1 publish {release-version}", "cwd": "." },

    "maui-build":           { "run": "pwsh -NoProfile -File hosts/maui/build.ps1 build",   "cwd": "." },
    "maui-test":            { "run": "pwsh -NoProfile -File hosts/maui/build.ps1 test",    "cwd": "." },
    "maui-release":         { "run": "pwsh -NoProfile -File hosts/maui/build.ps1 release", "cwd": "." },

    "mill-demographics-build": { "run": "pwsh -NoProfile -File mills/demographics/build.ps1 build", "cwd": "." },
    "mill-demographics-train": { "run": "pwsh -NoProfile -File mills/demographics/build.ps1 train", "cwd": "." },
    "mill-demographics-test":  { "run": "pwsh -NoProfile -File mills/demographics/build.ps1 test",  "cwd": "." },
    "mill-demographics-clean": { "run": "pwsh -NoProfile -File mills/demographics/build.ps1 clean", "cwd": "." },

    "mill-devils-dust-test":   { "run": "pwsh -NoProfile -File mills/devils-dust/build.ps1 test", "cwd": "." },

    "mill-emley-moor-build":   { "run": "pwsh -NoProfile -File mills/emley-moor/build.ps1 build", "cwd": "." },
    "mill-emley-moor-test":    { "run": "pwsh -NoProfile -File mills/emley-moor/build.ps1 test",  "cwd": "." },
    "mill-emley-moor-clean":   { "run": "pwsh -NoProfile -File mills/emley-moor/build.ps1 clean", "cwd": "." },

    "mill-halifax-build":      { "run": "pwsh -NoProfile -File mills/halifax/build.ps1 build", "cwd": "." },
    "mill-halifax-test":       { "run": "pwsh -NoProfile -File mills/halifax/build.ps1 test",  "cwd": "." },
    "mill-halifax-demo":       { "run": "pwsh -NoProfile -File mills/halifax/build.ps1 demo",  "cwd": "." },

    "mill-invaders-test":      { "run": "pwsh -NoProfile -File mills/invaders/build.ps1 test", "cwd": "." },

    "mill-iris-build":         { "run": "pwsh -NoProfile -File mills/iris/build.ps1 build", "cwd": "." },
    "mill-iris-train":         { "run": "pwsh -NoProfile -File mills/iris/build.ps1 train", "cwd": "." },
    "mill-iris-test":          { "run": "pwsh -NoProfile -File mills/iris/build.ps1 test",  "cwd": "." },
    "mill-iris-clean":         { "run": "pwsh -NoProfile -File mills/iris/build.ps1 clean", "cwd": "." },

    "mill-mungo-caverns-test": { "run": "pwsh -NoProfile -File mills/mungo-caverns/build.ps1 test", "cwd": "." },
    "mill-oregon-test":        { "run": "pwsh -NoProfile -File mills/oregon/build.ps1 test",        "cwd": "." },
    "mill-pac-vt100-test":     { "run": "pwsh -NoProfile -File mills/pac-vt100/build.ps1 test",     "cwd": "." },

    "mill-simplex-build":      { "run": "pwsh -NoProfile -File mills/simplex-from-mps/build.ps1 build", "cwd": "." },
    "mill-simplex-test":       { "run": "pwsh -NoProfile -File mills/simplex-from-mps/build.ps1 test",  "cwd": "." },
    "mill-simplex-clean":      { "run": "pwsh -NoProfile -File mills/simplex-from-mps/build.ps1 clean", "cwd": "." },

    "mill-sparky-build":       { "run": "pwsh -NoProfile -File mills/sparky/build.ps1 build", "cwd": "." },
    "mill-sparky-test":        { "run": "pwsh -NoProfile -File mills/sparky/build.ps1 test",  "cwd": "." },

    "mill-tally-build":        { "run": "pwsh -NoProfile -File mills/tally/build.ps1 build",   "cwd": "." },
    "mill-tally-test":         { "run": "pwsh -NoProfile -File mills/tally/build.ps1 test",    "cwd": "." },
    "mill-tally-capture":      { "run": "pwsh -NoProfile -File mills/tally/build.ps1 capture", "cwd": "." },
    "mill-tally-clean":        { "run": "pwsh -NoProfile -File mills/tally/build.ps1 clean",   "cwd": "." },

    "mill-weather-glass-build": { "run": "pwsh -NoProfile -File mills/weather-glass/build.ps1 build", "cwd": "." },
    "mill-weather-glass-test":  { "run": "pwsh -NoProfile -File mills/weather-glass/build.ps1 test",  "cwd": "." },
    "mill-weather-glass-clean": { "run": "pwsh -NoProfile -File mills/weather-glass/build.ps1 clean", "cwd": "." },

    "spiro-test":              { "run": "pwsh -NoProfile -File tutorials/spiro/build.ps1 test", "cwd": "." }
  }

}
