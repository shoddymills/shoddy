{
  "trees": {
    "work": { "path": ".", "can": ["list", "read", "create", "update", "rename", "delete", "execute"] }
  },
  "tasks": {
    "doctor":          { "run": "pwsh -File scripts/shoddy.ps1 doctor",        "cwd": "." },
    "preflight":       { "run": "pwsh -File scripts/shoddy.ps1 preflight",     "cwd": "." },
    "status":          { "run": "pwsh -File scripts/shoddy.ps1 status",        "cwd": "." },
    "selftest":        { "run": "pwsh -File scripts/shoddy.ps1 selftest",      "cwd": "." },
    "gate":            { "run": "pwsh -File scripts/shoddy.ps1 gate --resume", "cwd": "." },

    "build":           { "run": "pwsh -File build.ps1 build",    "cwd": "." },
    "test":            { "run": "pwsh -File build.ps1 test",     "cwd": "." },
    "machines":        { "run": "pwsh -File build.ps1 machines", "cwd": "." },

    "fettler-build":   { "run": "pwsh -File fettler/build.ps1 build",   "cwd": "." },
    "fettler-test":    { "run": "pwsh -File fettler/build.ps1 test",    "cwd": "." },
    "fettler-release": { "run": "pwsh -File fettler/build.ps1 release", "cwd": "." },

    "feature":         { "run": "pwsh -File scripts/shoddy-feature.ps1 new {feature-branch}", "cwd": "." },
    "commit":          { "run": "pwsh -File scripts/shoddy-commit.ps1 -Message {commit-note}", "cwd": "." },
    "ship":            { "run": "pwsh -File scripts/shoddy-feature.ps1 ship -Yes", "cwd": "." },
    "release":         { "run": "pwsh -File scripts/shoddy.ps1 release {release-version}", "cwd": "." }
  }
}
