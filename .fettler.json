{
  "trees": {
    "work": { 
      "path": ".", 
      "can": ["list", "read", "create", "update", "rename", "delete", "execute"],
      "screen": ["phi","pii"]}
  },
  "tasks": {
    "doctor":               { "run": "pwsh -File scripts/shoddy.ps1 doctor",                    "cwd": "." },
    "preflight":            { "run": "pwsh -File scripts/shoddy.ps1 preflight",                 "cwd": "." },
    "gate":                 { "run": "pwsh -File scripts/shoddy.ps1 gate --resume",             "cwd": "." },
    "status":               { "run": "pwsh -File scripts/shoddy.ps1 status",                    "cwd": "." },
    "selftest":             { "run": "pwsh -File scripts/shoddy.ps1 selftest",                  "cwd": "." },
    "clean":                { "run": "pwsh -File scripts/shoddy.ps1 clean",                     "cwd": "." },
    "package":              { "run": "pwsh -File scripts/shoddy.ps1 package {release-version}", "cwd": "." },
    "publish":              { "run": "pwsh -File scripts/shoddy.ps1 publish {release-version} --yes", "cwd": "." },
    "release":              { "run": "pwsh -File scripts/shoddy.ps1 release {release-version}", "cwd": "." },

    "feature":              { "run": "pwsh -File scripts/shoddy-feature.ps1 new {feature-branch}", "cwd": "." },
    "checkin":              { "run": "pwsh -File scripts/shoddy-commit.ps1 -Message {commit-note}", "cwd": "." },
    "ship":                 { "run": "pwsh -File scripts/shoddy-feature.ps1 ship -Yes",         "cwd": "." },
    "display":              { "run": "pwsh -File scripts/shoddy-display.ps1",                   "cwd": "." },
    "display-list":         { "run": "pwsh -File scripts/shoddy-display.ps1 -List",             "cwd": "." },

    "all":                  { "run": "pwsh -File build.ps1 all",      "cwd": "." },
    "build":                { "run": "pwsh -File build.ps1 build",    "cwd": "." },
    "test":                 { "run": "pwsh -File build.ps1 test",     "cwd": "." },
    "machines":             { "run": "pwsh -File build.ps1 machines", "cwd": "." },
    "stage":                { "run": "pwsh -File build.ps1 stage",    "cwd": "." },
    "vsix":                 { "run": "pwsh -File build.ps1 vsix",     "cwd": "." },
    "install":              { "run": "pwsh -File build.ps1 install",  "cwd": "." },
    "build-clean":          { "run": "pwsh -File build.ps1 clean",    "cwd": "." },
    "run":                  { "run": "pwsh -File build.ps1 run {shoddy-file}",   "cwd": "." },
    "weave":                { "run": "pwsh -File build.ps1 weave {shoddy-file}", "cwd": "." },

    "fettler-build":        { "run": "pwsh -File fettler/build.ps1 build",   "cwd": "." },
    "fettler-test":         { "run": "pwsh -File fettler/build.ps1 test",    "cwd": "." },
    "fettler-release":      { "run": "pwsh -File fettler/build.ps1 release", "cwd": "." },
    "fettler-publish":      { "run": "pwsh -File fettler/build.ps1 publish {release-version}", "cwd": "." },

    "mcp-build":            { "run": "pwsh -File hosts/mcp/build.ps1 build",   "cwd": "." },
    "mcp-test":             { "run": "pwsh -File hosts/mcp/build.ps1 test",    "cwd": "." },
    "mcp-release":          { "run": "pwsh -File hosts/mcp/build.ps1 release", "cwd": "." },
    "mcp-publish":          { "run": "pwsh -File hosts/mcp/build.ps1 publish {release-version}", "cwd": "." },

    "maui-build":           { "run": "pwsh -File hosts/maui/build.ps1 build",   "cwd": "." },
    "maui-test":            { "run": "pwsh -File hosts/maui/build.ps1 test",    "cwd": "." },
    "maui-release":         { "run": "pwsh -File hosts/maui/build.ps1 release", "cwd": "." },

    "mill-demographics-build": { "run": "pwsh -File mills/demographics/build.ps1 build", "cwd": "." },
    "mill-demographics-train": { "run": "pwsh -File mills/demographics/build.ps1 train", "cwd": "." },
    "mill-demographics-test":  { "run": "pwsh -File mills/demographics/build.ps1 test",  "cwd": "." },
    "mill-demographics-clean": { "run": "pwsh -File mills/demographics/build.ps1 clean", "cwd": "." },

    "mill-devils-dust-test":   { "run": "pwsh -File mills/devils-dust/build.ps1 test", "cwd": "." },

    "mill-emley-moor-build":   { "run": "pwsh -File mills/emley-moor/build.ps1 build", "cwd": "." },
    "mill-emley-moor-test":    { "run": "pwsh -File mills/emley-moor/build.ps1 test",  "cwd": "." },
    "mill-emley-moor-clean":   { "run": "pwsh -File mills/emley-moor/build.ps1 clean", "cwd": "." },

    "mill-halifax-build":      { "run": "pwsh -File mills/halifax/build.ps1 build", "cwd": "." },
    "mill-halifax-test":       { "run": "pwsh -File mills/halifax/build.ps1 test",  "cwd": "." },
    "mill-halifax-demo":       { "run": "pwsh -File mills/halifax/build.ps1 demo",  "cwd": "." },

    "mill-invaders-test":      { "run": "pwsh -File mills/invaders/build.ps1 test", "cwd": "." },

    "mill-iris-build":         { "run": "pwsh -File mills/iris/build.ps1 build", "cwd": "." },
    "mill-iris-train":         { "run": "pwsh -File mills/iris/build.ps1 train", "cwd": "." },
    "mill-iris-test":          { "run": "pwsh -File mills/iris/build.ps1 test",  "cwd": "." },
    "mill-iris-clean":         { "run": "pwsh -File mills/iris/build.ps1 clean", "cwd": "." },

    "mill-mungo-caverns-test": { "run": "pwsh -File mills/mungo-caverns/build.ps1 test", "cwd": "." },
    "mill-oregon-test":        { "run": "pwsh -File mills/oregon/build.ps1 test",        "cwd": "." },
    "mill-pac-vt100-test":     { "run": "pwsh -File mills/pac-vt100/build.ps1 test",     "cwd": "." },

    "mill-simplex-build":      { "run": "pwsh -File mills/simplex-from-mps/build.ps1 build", "cwd": "." },
    "mill-simplex-test":       { "run": "pwsh -File mills/simplex-from-mps/build.ps1 test",  "cwd": "." },
    "mill-simplex-clean":      { "run": "pwsh -File mills/simplex-from-mps/build.ps1 clean", "cwd": "." },

    "mill-sparky-build":       { "run": "pwsh -File mills/sparky/build.ps1 build", "cwd": "." },
    "mill-sparky-test":        { "run": "pwsh -File mills/sparky/build.ps1 test",  "cwd": "." },

    "mill-tally-build":        { "run": "pwsh -File mills/tally/build.ps1 build",   "cwd": "." },
    "mill-tally-test":         { "run": "pwsh -File mills/tally/build.ps1 test",    "cwd": "." },
    "mill-tally-capture":      { "run": "pwsh -File mills/tally/build.ps1 capture", "cwd": "." },
    "mill-tally-clean":        { "run": "pwsh -File mills/tally/build.ps1 clean",   "cwd": "." },

    "mill-weather-glass-build": { "run": "pwsh -File mills/weather-glass/build.ps1 build", "cwd": "." },
    "mill-weather-glass-test":  { "run": "pwsh -File mills/weather-glass/build.ps1 test",  "cwd": "." },
    "mill-weather-glass-clean": { "run": "pwsh -File mills/weather-glass/build.ps1 clean", "cwd": "." },

    "spiro-test":              { "run": "pwsh -File tutorials/spiro/build.ps1 test", "cwd": "." }
  }
}
