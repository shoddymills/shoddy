{
  "trees": {
    "work": { "path": ".", "can": ["list", "read", "create", "update", "rename", "delete", "execute"] }
  },
  "tasks": {
    "doctor":         { "run": "pwsh -File scripts/shoddy.ps1 doctor", "cwd": "." },
    "preflight":      { "run": "pwsh -File scripts/shoddy.ps1 preflight", "cwd": "." },
    "feature":        { "run": "pwsh -File scripts/shoddy-feature.ps1 new gomersal", "cwd": "." },

    "gate":           { "run": "pwsh -File scripts/shoddy.ps1 gate --resume", "cwd": "." },
    "status":         { "run": "pwsh -File scripts/shoddy.ps1 status", "cwd": "." },
    "selftest":       { "run": "pwsh -File scripts/shoddy.ps1 selftest", "cwd": "." },

    "build":          { "run": "pwsh -File build.ps1 build", "cwd": "." },
    "commit":         { "run": "pwsh -Command \"git add -A; git commit -m 'docs rewritten to the Heathkit readability standard'\"", "cwd": "." },    
    "ship":           { "run": "pwsh -File scripts/shoddy-feature.ps1 ship -Yes", "cwd": "." },

    "test":           { "run": "pwsh -File build.ps1 test", "cwd": "." },
    "machines":       { "run": "pwsh -File build.ps1 machines", "cwd": "." },

    "fettler-build":   { "run": "pwsh -File fettler/build.ps1 build", "cwd": "." },
    "fettler-test":    { "run": "pwsh -File fettler/build.ps1 test", "cwd": "." },
    "fettler-release": { "run": "pwsh -File fettler/build.ps1 release", "cwd": "." },
    
    "demographics-test":     { "run": "pwsh -File mills/demographics/build.ps1 test", "cwd": "." },
    "devils-dust-test":      { "run": "pwsh -File mills/devils-dust/build.ps1 test", "cwd": "." },
    "emley-moor-test":       { "run": "pwsh -File mills/emley-moor/build.ps1 test", "cwd": "." },
    "halifax-test":          { "run": "pwsh -File mills/halifax/build.ps1 test", "cwd": "." },
    "invaders-test":         { "run": "pwsh -File mills/invaders/build.ps1 test", "cwd": "." },
    "iris-test":             { "run": "pwsh -File mills/iris/build.ps1 test", "cwd": "." },
    "mungo-caverns-test":    { "run": "pwsh -File mills/mungo-caverns/build.ps1 test", "cwd": "." },
    "oregon-test":           { "run": "pwsh -File mills/oregon/build.ps1 test", "cwd": "." },
    "pac-vt100-test":        { "run": "pwsh -File mills/pac-vt100/build.ps1 test", "cwd": "." },
    "simplex-from-mps-test": { "run": "pwsh -File mills/simplex-from-mps/build.ps1 test", "cwd": "." },
    "sparky-test":           { "run": "pwsh -File mills/sparky/build.ps1 test", "cwd": "." },
    "tally-test":            { "run": "pwsh -File mills/tally/build.ps1 test", "cwd": "." },
    "weather-glass-test":    { "run": "pwsh -File mills/weather-glass/build.ps1 test", "cwd": "." },
    "seedscribbler-test":    { "run": "bin/mill.exe --no-window run tst/seedscribblertest.shoddy", "cwd": "." },
    "seedturtle-test":       { "run": "bin/mill.exe --no-window run tst/seedturtletest.shoddy", "cwd": "." },
    "seedplotter-test":      { "run": "bin/mill.exe --no-window run tst/seedplottertest.shoddy", "cwd": "." }
  }
}
