{
  "guardrails": {
    "trees": {
      "branding": {
        "path": "../shoddy-planning/branding",
        "can": ["list", "read"]
      },

      "requirements": {
        "path": "../shoddy-planning/requirements",
        "can": ["list", "read"],
        "scopes": {
          "branding":   { "can": ["list", "read"] },
          "backlog":    { "can": ["list", "read", "create", "update", "rename"] },
          "inprogress": { "can": ["list", "read", "create", "update", "rename"] },
          "evaluation": { "can": ["list", "read", "create", "update", "rename", "delete", "execute"] },
          "cancelled":  { "can": [] },
          "completed":  { "can": [] }
        }
      },
      "fettler": {
        "path": "../shoddy-fettler",
        "can": ["list", "read"]
      }
    },
    "replacements": {
      "feature-branch":   "thornle",
      "bug-branch":       "thornle01",
      "release-version":  "2.11.1",
      "previous-release": "v2.10.0",
      "commit-note":      "thornle - 'cause words are a thorn in our side!",
      "shoddy-file":      "thornle.shoddy"
    }
  }
}
