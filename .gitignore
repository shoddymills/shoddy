## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.tmp
*.tmp.idx
.DS_Store
**/.DS_Store


# The toolchain `build.ps1 stage` copies into the extension for packaging.
vscode-shoddy/mill/
vscode-shoddy/machines/
vscode-shoddy/THIRD-PARTY-NOTICES.md
vscode-shoddy/AUTHORSHIP.md

# The packaged extension is build output, not source: the Release workflow
# rebuilds it from the tag and attaches it to the GitHub Release. Committing it
# added ~10 MB to the clone per release, permanently, for a file already
# published elsewhere.
vscode-shoddy/*.vsix

# the save-format round trip in mills/mungo-caverns leaves this behind
mills/mungo-caverns/tests/roundtrip.adv

# Weaving a mill leaves its woven output beside the source: the shell and
# machine DLLs and the runtimeconfig. They are build results, not source —
# the proof suite regenerates them on every run.
mills/**/*.dll
mills/**/*.runtimeconfig.json

# Weaving a suite in tst/ leaves the same trail beside it. These were being
# left untracked-but-visible, which is one `git add -A` away from shipping
# build output in a commit.
tst/*.dll
tst/*.runtimeconfig.json

# The release driver's receipts and per-step logs - a fact about THIS
# machine's runs. They must stay ignored: receipts are keyed to a fingerprint
# of the working tree, so a receipts file that showed up in `git status` would
# change the key every time it was written and invalidate itself.
.release-state/

# Fettler: a personal overlay naming trees that exist only on this
# machine, and the backup setup leaves beside a client configuration
# before it changes one.
*.fettler-backup
