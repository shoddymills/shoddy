{
  // Fettler, as VS Code registers an MCP server. Checked in, because the
  // documentation instructs a reader to create one and a repository that
  // does not have its own has never tested its own instructions.
  //
  // `command` names `fettle` plainly, which is the portable form and the
  // one every contributor should have: put the binary from the release
  // archive somewhere on PATH. If you have not, `fettle doctor` says so
  // in as many words, and `fettle setup vscode-copilot --local --force`
  // rewrites this to the absolute path of your own build.
  //
  // No root or config flag appears here, and none can: the trees come
  // from .fettler.json in this folder, which the model cannot write.
  "servers": {
    "fettler": {
      "command": "fettle",
      "args": ["serve"]
    }
  }
}
