{
    // Mill tasks — see doc/vscode.html section 5. Shell tasks quote the
    // mill path per-shell, so these work in PowerShell, cmd, and POSIX.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Shoddy: run current file",
            "type": "shell",
            "command": "${workspaceFolder}/bin/mill",
            "windows": { "command": "${workspaceFolder}/bin/mill.exe" },
            "args": ["run", "${file}"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Shoddy: weave current file",
            "type": "shell",
            "command": "${workspaceFolder}/bin/mill",
            "windows": { "command": "${workspaceFolder}/bin/mill.exe" },
            "args": ["weave", "${file}"],
            "problemMatcher": []
        },
        {
            "label": "Shoddy: build machine from current file",
            "type": "shell",
            "command": "${workspaceFolder}/bin/mill",
            "windows": { "command": "${workspaceFolder}/bin/mill.exe" },
            "args": ["machine", "${file}"],
            "problemMatcher": []
        },
        {
            "label": "Shoddy: show generated C# for current file",
            "type": "shell",
            "command": "${workspaceFolder}/bin/mill",
            "windows": { "command": "${workspaceFolder}/bin/mill.exe" },
            "args": ["gen", "${file}"],
            "problemMatcher": []
        },
        {
            "label": "Shoddy: golden conformance tests",
            "type": "shell",
            "command": "dotnet",
            "args": ["test", "src/Shoddy.Tests"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Shoddy: rebuild mill into bin/",
            "type": "shell",
            "command": "dotnet",
            "args": ["publish", "src/Shoddy.Mill", "-c", "Release", "-o", "bin"],
            "problemMatcher": []
        }
    ]
}
