<Project>

  <!-- Centralize every project's build output into artifacts/ instead of
       each project's own src/<Project>/bin and obj. Keeps Shoddy.Runtime.dll,
       Shoddy.Compiler.dll, Shoddy.Devil.dll, and mill.dll in one predictable
       place for plain `dotnet build`/`dotnet test` runs. The mill's published
       bin/ (dotnet publish -o bin) and the machines/*.shoddy machine DLLs
       (which land in a bin/ subdirectory beside their .shoddy source, where
       the Include resolver looks) are unaffected â€” both use explicit output
       paths. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <!-- ONE version for everything this repository ships. It reaches src/,
       hosts/mcp/ and fettler/ alike, so the mill's version banner,
       sparky's serverInfo and fettle's version line all answer the same
       number: the one printed on the archive somebody downloaded.

       Before this, nothing stamped a version at all. Every binary
       reported the MSBuild default of 1.0.0 while the repository shipped
       2.x, which made the smoke test in RELEASING.md report a number
       that meant nothing.

       shoddy-release.ps1/.sh rewrites this line beside
       vscode-shoddy/package.json. Two places, one act. -->
  <PropertyGroup>
    <Version>2.3.1</Version>
  </PropertyGroup>

</Project>
