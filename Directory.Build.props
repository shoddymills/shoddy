<Project>

  <!-- Every project's build output goes under artifacts/ — the .NET
       SDK's artifacts layout — instead of a bin/ and obj/ beside each
       project. The toolchain, the machine library, the hosts, the proofs
       and the tests all land in one predictable place, and nothing a
       build writes lands in a source folder. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <!-- What every C# project here assumes, said once. The target
       framework stays in each project: a project that multi-targets
       (the MAUI head) must own it. -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Reproducible builds. Deterministic is the compiler default and is
       named here so nobody has to wonder; under CI the build also drops
       absolute paths from the PDBs and marks itself a CI build, so two
       clean builds of one commit are byte-identical. Portable PDBs ship
       with every assembly, Source Link embeds what git does not track,
       and the package graph is pinned by lock files restored in locked
       mode under CI, so a restore cannot drift between two runs. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- ONE version for everything this repository ships. It reaches src/
       and hosts/mcp/ alike, so the mill's version banner and sparky's
       serverInfo answer the same number: the one printed on the archive
       somebody downloaded.

       The number here is a DEVELOPMENT DEFAULT. A release takes its
       version from the git tag: release.yml stamps this line and
       vscode-shoddy/package.json on the runner before building, and
       nothing commits a bump. -->
  <PropertyGroup>
    <Version>2.5.1</Version>
  </PropertyGroup>

</Project>
