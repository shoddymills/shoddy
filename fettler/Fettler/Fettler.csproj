<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fettler: the file, search and edit operations, the two front ends
       over them, and nothing else.

       R1.2 is the load-bearing decision in this file and it is visible
       as an ABSENCE: there is no ProjectReference and no PackageReference
       here, and there must never be one. Fettler shares this repository,
       its release and its version number with what else lives here, and
       shares nothing else. Fettler.Tests asserts that from outside, by
       reading the built assembly's references (R1.4), because a
       constraint that is not tested lasts until somebody is in a hurry.

       Note what is NOT imported: src/Shoddy.Build/build/Shoddy.Build.props,
       which every other host project in this repository imports to weave
       a mill. Fettler compiles no Shoddy and runs none. It is a tool for
       working on the tree, not a thing built out of it.

       Inside this one assembly the layering of R3.1 is kept by namespace
       and asserted by test: Fettler.Core may not name System.Text.Json,
       System.Console or an exit code, because a core that knows about a
       protocol has already stopped being one. The two front ends live
       beside it in Fettler.Cli and Fettler.Mcp and are ordinary classes,
       so the tests drive both without a process. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fettler</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
