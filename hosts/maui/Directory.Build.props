<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- The MAUI lane restores a graph that depends on the workload and
       the platform it is built on; its lock files could only be
       generated on the Windows workstation, so this lane restores
       unlocked and the rest of the repository stays pinned. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

</Project>
