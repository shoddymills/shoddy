<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- The host test project (B4.1, D13): proves the calculator's Mode N
       loop and the every-seed surface with no view anywhere — the same
       woven halifax the app consumes, woven here by the same
       ShoddyWeave. Windows TFM because it references Shoddy.Maui's
       session types; nothing in it opens a window. -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The audio render tests replicate the sink's unsafe fill path
         byte for byte — the point is to run the exact code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Windows runs the published apphost; everywhere else publish
         drops 'mill' with no extension - same tool, two spellings. -->
    <ShoddyToolPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\..\bin\mill.exe</ShoddyToolPath>
    <ShoddyToolPath Condition="'$(ShoddyToolPath)' == ''">$(MSBuildThisFileDirectory)../../../bin/mill</ShoddyToolPath>
    <!-- This lane builds the same mills in Debug (the gate's maui-test)
         and Release (maui-release), back to back. A test host from the
         first can still hold a woven DLL open when the second starts, and
         Windows refuses the rename until it exits - so each configuration
         weaves into its own subdirectory of the mill's bin/ and they never
         meet. Prefixed, because bin/debug/ already means the instrumented
         weave rather than a configuration. -->
    <ShoddyBinScope>cfg-$(Configuration)</ShoddyBinScope>
  </PropertyGroup>

  <ItemGroup>
    <ShoddyMill Include="..\..\..\mills\halifax" Mode="N"
                Grant="file;terminal;clock;random;keys;vt100;scribbler;buzzer;net" />
    <ShoddyMill Include="..\..\..\mills\halifax" Mode="T"
                Grant="file;terminal;clock;random;keys;vt100;scribbler;buzzer;net" />
    <ShoddyMill Include="..\..\..\mills\pac-vt100" Mode="T"
                Grant="terminal;clock;random;vt100" />
    <ShoddyMill Include="..\..\..\mills\invaders" Mode="T"
                Grant="scribbler;buzzer;keys" />
    <ShoddyMill Include="..\..\..\mills\oregon" Mode="T"
                Grant="terminal;clock;random" />
    <ShoddyMill Include="..\..\..\mills\mungo-caverns" Mode="T"
                Grant="terminal;file" />
    <ShoddyMill Include="..\..\..\mills\devils-dust" Mode="T"
                Grant="scribbler;buzzer;keys" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Maui\Shoddy.Maui.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
