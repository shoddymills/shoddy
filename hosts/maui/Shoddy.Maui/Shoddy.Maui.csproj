<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reusable MAUI host pieces (D9): the calculator session loop,
       the transcript view it feeds, the scribbler canvas view and the
       per-platform audio sinks. The app project (shoddy-reckoner) is
       wiring around these; anything a second MAUI app would want lives
       here, and anything host-blind lives further down still, in
       src/Shoddy.Hosting.

       TargetFrameworks carries only the Windows lane today: this
       machine is the Windows workstation, and the Mac Catalyst / iOS /
       Android frameworks are added on the Mac workstation (rollout
       plan §3) by extending the list — the Platforms/ layout is
       already the multi-targeted shape MAUI expects.

       One-way dependency rule (B2.2): this project references src/
       and nothing in src/ may ever reference it. It must never
       reference Shoddy.Mill (B2.4); mobile targets must never
       reference Shoddy.Compiler. -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Shoddy.Maui</RootNamespace>
    <!-- One unsafe block: the Windows audio sink's quantum fill writes
         through WinRT's IMemoryBufferByteAccess, which has no safe
         projection. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Runtime\Shoddy.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- The one third-party SDK, and only for the canvas (D10): the
         scribbler seam hands over a raw RGBA buffer, and SkiaSharp's
         InstallPixels presents it zero-copy. An app that draws nothing
         references Shoddy.Maui and links this anyway — if that ever
         matters, the canvas splits into its own package; today the
         only app is Reckoner and Reckoner draws. -->
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.116.1" />
  </ItemGroup>

</Project>
