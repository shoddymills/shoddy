<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShoddyReckoner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ShoddyReckoner"
    Title="Shoddy Reckoner">

    <ShellContent
        Title="Calculator"
        ContentTemplate="{DataTemplate local:CalculatorPage}"
        Route="CalculatorPage" />

    <ShellContent
        Title="Pac-Man"
        ContentTemplate="{DataTemplate local:PacPage}"
        Route="PacPage" />

    <ShellContent
        Title="Invaders"
        ContentTemplate="{DataTemplate local:InvadersPage}"
        Route="InvadersPage" />

    <ShellContent
        Title="Oregon Trail"
        ContentTemplate="{DataTemplate local:OregonPage}"
        Route="OregonPage" />

    <ShellContent
        Title="Mungo Caverns"
        ContentTemplate="{DataTemplate local:MungoPage}"
        Route="MungoPage" />

    <ShellContent
        Title="Devil's Dust"
        ContentTemplate="{DataTemplate local:DevilsDustPage}"
        Route="DevilsDustPage" />

</Shell>
