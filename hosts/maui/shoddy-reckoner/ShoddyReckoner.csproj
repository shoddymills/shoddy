<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- Shoddy Reckoner (B1.3): the Halifax calculator behind a
       terminal-like face of ordinary MAUI controls, Mode N. The woven
       core and its machine closure arrive through ShoddyWeave exactly
       as they do in any plain .NET consumer — the MAUI build adds only
       presentation.

       TargetFrameworks carries the Windows lane only today; the Mac
       workstation adds net10.0-maccatalyst / -ios / -android (rollout
       plan §3) by extending the list. Platforms/ already holds all
       four heads. -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShoddyReckoner</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Shoddy Reckoner</ApplicationTitle>
    <!-- Store identity is decided in the rollout plan (§1, B7.6) and
         is still TBD there. This value is a development placeholder —
         it MUST be reconciled with the rollout plan's table before the
         first upload to any store, because a store identity is
         permanent once uploaded. -->
    <ApplicationId>com.shoddymills.shoddyreckoner</ApplicationId>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <ShoddyToolPath>$(MSBuildThisFileDirectory)..\..\..\bin\mill.exe</ShoddyToolPath>
    <!-- Debug builds carry the Perch attach service (B3.8, D11);
         release builds provably carry neither transport nor
         instrumented core (B7.4). -->
    <ShoddyPerchProject>$(MSBuildThisFileDirectory)..\..\..\src\Shoddy.Perch\Shoddy.Perch.csproj</ShoddyPerchProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- halifax, Mode N, every capability its manifest declares
         (B4.8): the fold ships whole, and the app supplies a real
         resource behind every entry (B4.10). The grant is long on
         purpose — it is this app's capability statement. -->
    <ShoddyMill Include="..\..\..\mills\halifax" Mode="N"
                Grant="file;terminal;clock;random;keys;vt100;scribbler;buzzer;net" />
    <!-- The games shelf, all Mode T, each woven whole: the same DLLs
         `mill run` executes at a console. Each grant is that game's
         own capability statement, gate-checked against its manifest. -->
    <ShoddyMill Include="..\..\..\mills\pac-vt100" Mode="T"
                Grant="terminal;clock;random;vt100" />
    <ShoddyMill Include="..\..\..\mills\invaders" Mode="T"
                Grant="scribbler;buzzer;keys" />
    <ShoddyMill Include="..\..\..\mills\oregon" Mode="T"
                Grant="terminal;clock;random" />
    <ShoddyMill Include="..\..\..\mills\mungo-caverns" Mode="T"
                Grant="terminal;file" />
    <ShoddyMill Include="..\..\..\mills\devils-dust" Mode="T"
                Grant="scribbler;buzzer;keys" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand mark (docs/media/brand/shoddy-icon.svg, copied —
         resizetizer wants its inputs in-project) on the docs' paper
         color; the same mark seeds the splash. The Besley semibold the
         docs' headings use, converted losslessly from the brand woff2,
         OFL license alongside. -->
    <MauiIcon Include="Resources\AppIcon\shoddyicon.svg" Color="#efece4" />
    <MauiSplashScreen Include="Resources\AppIcon\shoddyicon.svg" Color="#efece4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Maui\Shoddy.Maui.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
