<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reusable MCP host pieces: the session loop, the headless
       canvas backend, the grounding index, the tool surface and the
       protocol loop. The executable (sparky) is wiring around these.

       One-way dependency rule (B2.2): this project references src/ and
       nothing in src/ may ever reference it. It must never reference
       Shoddy.Mill or Shoddy.Compiler (B2.4) — the weave arrives through
       ShoddyWeave, driven by the published bin/mill.exe, exactly as the
       MAUI lane does.

       Plain net10.0 and no platform head: there is no window, no audio
       and no UI framework anywhere in this lane. The one third-party
       dependency count is zero — the protocol is hand-rolled over
       System.Text.Json, which ships with the framework. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Shoddy.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Runtime\Shoddy.Runtime.csproj" />
  </ItemGroup>

  <!-- The subject prose a lesson is built from, embedded rather than
       read from a path: the server is installed somewhere and the docs
       tree is not shipped beside it. These are the SAME files the site
       publishes — the alternative, an authored word table inside this
       project, is exactly the copied detail that goes stale. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\machines\*.html"
                      LogicalName="subject.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
