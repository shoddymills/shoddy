<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- The executable: argument handling, the working directory, and the
       stdio streams. Everything else is Shoddy.Mcp.

       The woven mill arrives through ShoddyWeave exactly as it does in
       any plain .NET consumer — the MCP lane adds only a protocol. The
       toolchain that weaves it is a build-only project reference, never
       linked (B2.4); the machine library is an ordinary reference. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>sparky</AssemblyName>
    <RootNamespace>Sparky</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- sparky, Mode N, every capability its manifest declares — and a
         real resource behind every one: a root on disk, the session's
         own output stream, a pixel buffer with no window, the clock,
         the generator, and outbound sockets. buzzer, keys and vt100 are
         neither granted NOR seeded, so their absence is a fact about
         the dictionary rather than a warning in a build log. -->
    <ShoddyMill Include="..\..\..\mills\sparky" Mode="N"
                Grant="file;terminal;clock;random;scribbler;net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Mcp\Shoddy.Mcp.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
    <ProjectReference Include="..\..\..\machines\Shoddy.Machines.csproj" OutputItemType="ShoddyLibrary" />
    <ProjectReference Include="..\..\..\machines\seeds\Shoddy.Machines.Seeds.csproj" OutputItemType="ShoddyLibrary" />
  </ItemGroup>

  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
