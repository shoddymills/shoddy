<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standard library: every machine in this folder, one assembly.
       The toolchain generates the C#; this project compiles it, in Debug
       (instrumented, for the debugger) and Release, under artifacts/.
       Consumers reference it like any .NET library. The full mill
       carries both configurations beside itself in lib/, so `mill run`
       and the debugger find it without a project. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Shoddy.Machines</AssemblyName>
    <RootNamespace>Shoddy.Machines</RootNamespace>
    <!-- Where these sources sit relative to the installed DLL: a
         toolchain carries the library in lib/debug/ and the sources in
         machines/. -->
    <ShoddyInstalledSources>../../machines</ShoddyInstalledSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Shoddy.Runtime\Shoddy.Runtime.csproj" />
    <!-- The generator: built from this checkout, never referenced. -->
    <ProjectReference Include="..\src\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
  </ItemGroup>

  <Import Project="..\src\Shoddy.Build\build\Shoddy.Library.targets" />
</Project>
