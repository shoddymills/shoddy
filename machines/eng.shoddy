Rem ---- physical constants ----------------------------------------------
Rem Each carries its own units in the record, because a bare number here
Rem is the mistake these are meant to prevent. Value(EngLightSpeed()) is
Rem the number; the record is what you pass around.
Rem
Rem Written as a mantissa times a power of ten rather than as one long
Rem literal: 6.02214076 * (10 ^ 23) is exactly what the CODATA sheet says,
Rem and a digit dropped from a run of twenty-four is invisible.

Let constLightSpeed = EngConst("SPEED OF LIGHT", 299792458, "M/S")

Def EngLightSpeed() As EngConst
    constLightSpeed

Let constPlanck = EngConst("PLANCK CONSTANT", 6.62607015 * (10 ^ (0 - 34)), "J S")

Def EngPlanck() As EngConst
    constPlanck

Let constGravitation = EngConst("GRAVITATIONAL CONSTANT", 6.67430 * (10 ^ (0 - 11)), "M^3/KG S^2")

Def EngGravitation() As EngConst
    constGravitation

Let constStdGravity = EngConst("STANDARD GRAVITY", 9.80665, "M/S^2")

Def EngStdGravity() As EngConst
    constStdGravity

Let constElectronCharge = EngConst("ELEMENTARY CHARGE", 1.602176634 * (10 ^ (0 - 19)), "C")

Def EngElectronCharge() As EngConst
    constElectronCharge

Let constElectronMass = EngConst("ELECTRON MASS", 9.1093837015 * (10 ^ (0 - 31)), "KG")

Def EngElectronMass() As EngConst
    constElectronMass

Let constProtonMass = EngConst("PROTON MASS", 1.67262192369 * (10 ^ (0 - 27)), "KG")

Def EngProtonMass() As EngConst
    constProtonMass

Let constAvogadro = EngConst("AVOGADRO CONSTANT", 6.02214076 * (10 ^ 23), "1/MOL")

Def EngAvogadro() As EngConst
    constAvogadro

Let constBoltzmann = EngConst("BOLTZMANN CONSTANT", 1.380649 * (10 ^ (0 - 23)), "J/K")

Def EngBoltzmann() As EngConst
