Rem The two mathematical constants the runtime does not supply. Pi is a
Rem builtin and needs no wrapper.
Def EngE() As Number
    E()

Def EngTau() As Number
    Tau()

Rem ---- presentation ----------------------------------------------------
Rem The last mile: rounding a result for a report, and printing it in the
Rem notation an engineer reads. Every word here returns a Number unless its
Rem name says otherwise, and the three that return String say so.

Def EngRoundTo(x As Number, n As Number) As Number
    RoundTo(x, n)

Def EngFracOf(x As Number) As Number
    Frac(x)

Def EngClamp(x As Number, lo As Number, hi As Number) As Number
    Clamp(x, lo, hi)

Def EngLerp(a As Number, b As Number, t As Number) As Number
    Lerp(a, b, t)

Def EngInvLerp(a As Number, b As Number, x As Number) As Number
    InvLerp(a, b, x)

Def EngRemap(x As Number, inLo As Number, inHi As Number,
             outLo As Number, outHi As Number) As Number
    Remap(x, inLo, inHi, outLo, outHi)

Def EngSmoothstep(edge0 As Number, edge1 As Number, x As Number) As Number
    Smoothstep(edge0, edge1, x)

Def EngSign(x As Number) As Number
    If x > 0 Then
        1
    Else
        If x < 0 Then
            0 - 1
        Else
            0

Rem The scalar counterpart of EngCNear, and the same warning applies: two
Rem doubles that ought to be equal usually are not.
Def EngNear(a As Number, b As Number, tol As Number) As Boolean
    Abs(a - b) <= tol

Rem Significant figures, not decimal places. EngSigFig(0.00123456, 3) is
Rem 0.00123; EngRoundTo(0.00123456, 3) is 0.001.
Def EngSigFig(x As Number, n As Number) As Number
    If n < 1 Then
        Error("ENGSIGFIG: NEEDS N >= 1")
    Else
        If x = 0 Then
            0
        Else
            RoundTo(x, n - 1 - Floor(LogBase(10, Abs(x))))

Rem Scientific notation: one digit before the point, p after it.
Def EngSci(x As Number, p As Number) As String
    If x = 0 Then
        ToFixed(0, p) & "E+0"
    Else
        Let ex = Floor(LogBase(10, Abs(x)))
        ToFixed(x / (10 ^ ex), p) & "E" & Ifte(ex < 0, "", "+") & Str(ex)

Let siPrefixes = { "y", "z", "a", "f", "p", "n", "u", "m", "",
                   "k", "M", "G", "T", "P", "E", "Z", "Y" }

Def EngPrefixes() As List Of String
    siPrefixes

Def EngMetricPrefix(k As Number) As String
    If k < 0 - 8 Or k > 8 Then
        Error("ENGMETRICPREFIX: NO SI PREFIX OUTSIDE 10^-24 TO 10^24")
    Else
        Nth(EngPrefixes(), k + 9)

Rem Engineering notation: the exponent moves in threes so the mantissa
Rem lands between 1 and 1000 and carries an SI prefix. 47000 ohms prints
Rem as 47k, which is what is written on the part.
Def EngMetric(x As Number, p As Number) As String
    If x = 0 Then
        ToFixed(0, p)
    Else
        Let k = Clamp(Floor(Floor(LogBase(10, Abs(x))) / 3), 0 - 8, 8)
        ToFixed(x / (1000 ^ k), p) & EngMetricPrefix(k)

Def EngCommas(x As Number, p As Number) As String
    Commas(x, p)
