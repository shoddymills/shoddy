Rem ==================================================================
Rem isam.shoddy — Shoddy standard library: indexed-sequential files
Rem
Rem Fixed-length records in a binary file, plus a sorted key -> slot
Rem index carried purely inside the handle record: every mutating word
Rem returns a new handle. Thread it like any other value —
Rem
Rem     Let db  = IsamOpen("staff.dat", 20, RdPair, WrPair, Fst)
Rem     Let db2 = IsamInsert(db, Pair("ADA", 96))
Rem     Snd(IsamGet(db2, "ADA"))                    ' 96
Rem
Rem — and don't reuse a stale handle after a mutation.
Rem
Rem On disk, each slot is 1 + RecSize bytes: a live flag byte, then the
Rem payload written by your writer. Deletes tombstone the flag and put
Rem the slot on a free list for reuse; opens scan the file once to
Rem rebuild the index. Keys come from your KeyOf function and must be
Rem NUMBERs or STRINGs (they are ordered with < ). No crash safety, no
Rem concurrent access — one live handle at a time.
Rem ==================================================================

Include "seq.shoddy"

Type Isam
    Fh      As Number               ' binary file handle
    RecSize As Number               ' payload bytes (excludes flag byte)
    Rd      As [ Number -- t ]      ' reader, as in recio
    Wr      As [ Number t -- ]      ' writer
    KeyOf   As [ t -- k ]           ' record -> key
    Index   As List Of Pair         ' key -> slot, sorted by key
    Free    As List Of Number       ' tombstoned slots

Rem ---- slot geometry --------------------------------------------------

Def SlotPos(n As Number, size As Number) As Number
    1 + (n - 1) * (size + 1)

Def NSlots(h As Number, size As Number) As Number
    Floor(BSize(h) / (size + 1))

Rem ---- sorted-index helpers -------------------------------------------

Def IdxIns(ix As List Of Pair, k As t, n As Number) As List Of Pair
    If IsEmpty(ix) Then
        { Pair(k, n) }
    Else
        If k < Fst(First(ix)) Then
            Prepend(Pair(k, n), ix)
        Else
            Prepend(First(ix), IdxIns(Rest(ix), k, n))

Def IdxDel(ix As List Of Pair, k As t) As List Of Pair
    Filter(ix, Fn(p) => Fst(p) <> k)

Def IdxFind(ix As List Of Pair, k As t) As Number
    If IsEmpty(ix) Then
        0
    Else
        If Fst(First(ix)) = k Then
            Snd(First(ix))
        Else
            IdxFind(Rest(ix), k)

Rem ---- raw slot i/o ----------------------------------------------------

Def ReadRec(db As Isam, n As Number) As t
    Seek(Fh(db), SlotPos(n, RecSize(db)) + 1)       ' skip the live flag
    Call(Rd(db), Fh(db))

Def WriteSlot(db As Isam, n As Number, rec As t)
    Seek(Fh(db), SlotPos(n, RecSize(db)))
    PutBool(Fh(db), True)
    Call(Wr(db), Fh(db), rec)

Rem ---- open: scan every slot, rebuilding index and free list -----------

Def IsamScan(db As Isam, n As Number, total As Number) As Isam
    If n > total Then
        db
    Else
        Seek(Fh(db), SlotPos(n, RecSize(db)))
        If GetBool(Fh(db)) Then
            Let rec = Call(Rd(db), Fh(db))
            IsamScan(With(db, Index = IdxIns(Index(db), Call(KeyOf(db), rec), n)), n + 1, total)
        Else
            IsamScan(With(db, Free = Prepend(n, Free(db))), n + 1, total)

Def IsamOpen(path As String, size As Number, rd0 As [ Number -- t ], wr0 As [ Number t -- ], keyof0 As [ t -- k ]) As Isam
    Let h = BOpen(path)
    IsamScan(Isam(h, size, rd0, wr0, keyof0, { }, { }), 1, NSlots(h, size))

Def IsamClose(db As Isam)
    BClose(Fh(db))

Rem ---- lookups -----------------------------------------------------------

Def IsamHas(db As Isam, k As t) As Boolean
    IdxFind(Index(db), k) <> 0

Def IsamCount(db As Isam) As Number
    Length(Index(db))

Def IsamGet(db As Isam, k As t) As u
    Let n = IdxFind(Index(db), k)
    If n = 0 Then
        Error("ISAMGET: KEY NOT FOUND")
    Else
        ReadRec(db, n)

Def IsamGetOr(db As Isam, k As t, dflt As u) As u
    If IsamHas(db, k) Then
        IsamGet(db, k)
    Else
        dflt

Rem ---- mutation: each returns the new handle ------------------------------

Def NextSlot(db As Isam) As Number
    If IsEmpty(Free(db)) Then
        NSlots(Fh(db), RecSize(db)) + 1
    Else
        First(Free(db))

Def DropFree(db As Isam) As Isam
    If IsEmpty(Free(db)) Then
        db
    Else
        With(db, Free = Rest(Free(db)))

Def IsamInsert(db As Isam, rec As t) As Isam
    Let k = Call(KeyOf(db), rec)
    If IsamHas(db, k) Then
        Error("ISAMINSERT: DUPLICATE KEY")
    Else
        Let n = NextSlot(db)
        WriteSlot(db, n, rec)
        With(DropFree(db), Index = IdxIns(Index(db), k, n))

Def IsamUpdate(db As Isam, rec As t) As Isam
    Let n = IdxFind(Index(db), Call(KeyOf(db), rec))
    If n = 0 Then
        Error("ISAMUPDATE: KEY NOT FOUND")
    Else
        WriteSlot(db, n, rec)
        db

Def IsamDelete(db As Isam, k As t) As Isam
    Let n = IdxFind(Index(db), k)
    If n = 0 Then
        Error("ISAMDELETE: KEY NOT FOUND")
    Else
        Seek(Fh(db), SlotPos(n, RecSize(db)))
        PutBool(Fh(db), False)
        With(db, Index = IdxDel(Index(db), k), Free = Prepend(n, Free(db)))

Rem ---- sequential access (in key order, cursorless) -----------------------

Def IsamAll(db As Isam) As List Of t
    Map(Index(db), Fn(p) => ReadRec(db, Snd(p)))

Def IsamRange(db As Isam, lo As k, hi As k) As List Of t
    Map(Filter(Index(db), Fn(p) => Fst(p) >= lo And Fst(p) <= hi), Fn(p) => ReadRec(db, Snd(p)))

Def IsamFirst(db As Isam) As t
    If IsamCount(db) = 0 Then
        Error("ISAMFIRST: EMPTY FILE")
    Else
        ReadRec(db, Snd(First(Index(db))))

Def IsamLast(db As Isam) As t
    If IsamCount(db) = 0 Then
        Error("ISAMLAST: EMPTY FILE")
    Else
        ReadRec(db, Snd(Last(Index(db))))

Def IsamNext(db As Isam, k As t) As u
    Let nx = Filter(Index(db), Fn(p) => Fst(p) > k)
    If IsEmpty(nx) Then
        Error("ISAMNEXT: NO NEXT KEY")
    Else
        ReadRec(db, Snd(First(nx)))

Def IsamPrev(db As Isam, k As t) As u
    Let pv = Filter(Index(db), Fn(p) => Fst(p) < k)
    If IsEmpty(pv) Then
        Error("ISAMPREV: NO PREVIOUS KEY")
    Else
        ReadRec(db, Snd(Last(pv)))
