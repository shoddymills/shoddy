<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reckoner seeds: the machines that bridge the standard library
       to the calculator, one assembly beside the library's. They include
       the machines they bridge, so this project references the library
       and the generator weaves against it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Shoddy.Machines.Seeds</AssemblyName>
    <RootNamespace>Shoddy.Machines</RootNamespace>
    <ShoddyInstalledSources>../../machines/seeds</ShoddyInstalledSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shoddy.Runtime\Shoddy.Runtime.csproj" />
    <ProjectReference Include="..\Shoddy.Machines.csproj" OutputItemType="ShoddyLibrary" />
    <ProjectReference Include="..\..\src\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
  </ItemGroup>

  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Library.targets" />
</Project>
