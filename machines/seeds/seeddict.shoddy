Rem ==================================================================
Rem seeddict.shoddy — reckoner seed: dict.shoddy over a LIST of PAIRs
Rem
Rem DPUT, DGET, DHAS, DKEYS and DPATH. A "dict" at the keyboard is an ordinary
Rem LIST cell whose elements are PAIR cells — no new stack case, per
Rem R4.16's discipline applied to association lists rather than arrays:
Rem "rate" 0.05 PAIR 1 GATHER is a one-entry dict, and DPUT grows it.
Rem
Rem NOT DELEGATED TO dict.shoddy's OWN WORDS, on purpose. DictGet,
Rem DictHas and DictPut compare keys with the language's native =. This
Rem seed keys by CutEqual, the comparison that knows every cell's kind.
Rem The two agree on a LIST key now that = compares lists by their
Rem items; a PROGRAM cell still compares by identity under =, and
Rem CutEqual is what lets a computed { 1 2 } key and a program key alike
Rem behave the way DUP EQUAL already promised they would.
Rem
Rem DGET IS GUARDED WHERE DictGet ISN'T: DictGet Errors on a missing
Rem key; DGET answers a refusal instead, naming the key.
Rem ==================================================================

Include "cuttle.shoddy"
Include "reckoner.shoddy"
Include "seq.shoddy"

Rem ---- a LIST cell as a list of PAIR cells ---------------------------

Def DcPairs(word As String, c As Cell) As Result
    Select Case RckListArg(word, c)
        Case Ok(xs)
            DcPairsAt(word, xs, { })
        Case Err(w, at)
            Err(w, at)
        Case Else
            Err(word & " did not answer", 0)

Def DcPairsAt(word As String, xs As List Of Cell, acc As List Of Cell) As Result
    If IsEmpty(xs) Then
        Ok(acc)
    Else
        DcPairsNext(word, xs, acc, First(xs))

Def DcPairsNext(word As String, xs As List Of Cell, acc As List Of Cell, c As Cell) As Result
    Select Case c
        Case CutPair(p)
            DcPairsAt(word, Rest(xs), Append(acc, c))
        Case Else
            Err(RckKindWhy(word, "a LIST of PAIRs", c), 0)

Def DcKeyOf(c As Cell) As Cell
    Select Case c
        Case CutPair(p)
            Fst(p)
        Case Else
            c

Def DcValOf(c As Cell) As Cell
    Select Case c
        Case CutPair(p)
            Snd(p)
        Case Else
            c

Rem ---- DHAS -----------------------------------------------------------

Def DcSeedDhas(st As RckState) As RckState
    RckReg(st, "DHAS", 2, RckPure(Fn(vs) => DcHas(vs)), "( d k -- flag )", "Whether the dict has an entry for key k.")

Def DcHas(vs As List Of Cell) As RckWork
    Select Case DcPairs("DHAS", Nth(vs, 1))
        Case Ok(ps)
            RckVals({ CutBool(Any(ps, Fn(p) => CutEqual(DcKeyOf(p), Nth(vs, 2)))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("DHAS did not answer")

Rem ---- DGET -------------------------------------------------------------

Def DcSeedDget(st As RckState) As RckState
    RckReg(st, "DGET", 2, RckPure(Fn(vs) => DcGet(vs)), "( d k -- v )", "The value stored under key k.")

Def DcGet(vs As List Of Cell) As RckWork
    Select Case DcPairs("DGET", Nth(vs, 1))
        Case Ok(ps)
            DcGetAt(ps, Nth(vs, 2))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("DGET did not answer")

Def DcGetAt(ps As List Of Cell, k As Cell) As RckWork
    If IsEmpty(ps) Then
        RckWorkBad("DGET found no entry for that key")
    Else
        DcGetOne(ps, k, First(ps))

Def DcGetOne(ps As List Of Cell, k As Cell, p As Cell) As RckWork
    If CutEqual(DcKeyOf(p), k) Then
        RckVals({ DcValOf(p) })
    Else
        DcGetAt(Rest(ps), k)

Rem ---- DPUT -----------------------------------------------------------
Rem Replaces the entry under k if there is one, otherwise appends —
Rem DictPut's own shape, on CutEqual keys instead of native =.

Def DcSeedDput(st As RckState) As RckState
    RckReg(st, "DPUT", 3, RckPure(Fn(vs) => DcPut(vs)), "( d k v -- d )", "The dict with key k set to v, added if it was not already there.")

Def DcPut(vs As List Of Cell) As RckWork
    Select Case DcPairs("DPUT", Nth(vs, 1))
        Case Ok(ps)
            RckVals({ CutList(Append(DcWithout(ps, Nth(vs, 2)), CutPair(Pair(Nth(vs, 2), Nth(vs, 3))))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("DPUT did not answer")

Def DcWithout(ps As List Of Cell, k As Cell) As List Of Cell
    Filter(ps, Fn(p) => Not CutEqual(DcKeyOf(p), k))

Rem ---- DKEYS ------------------------------------------------------------

Def DcSeedDkeys(st As RckState) As RckState
    RckReg(st, "DKEYS", 1, RckPure(Fn(vs) => DcKeys(vs)), "( d -- list )", "The dict's keys, in the order they were entered.")

Def DcKeys(vs As List Of Cell) As RckWork
    Select Case DcPairs("DKEYS", First(vs))
        Case Ok(ps)
            RckVals({ CutList(Map(ps, DcKeyOf)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("DKEYS did not answer")

Rem ---- DPATH ------------------------------------------------------------
Rem A path through nested dicts and lists in one word: a STRING step reads
Rem a key as DGET would, a NUMBER step reads an element as NTH would, and
Rem the value so far is what the next step reads. One line reaches a leaf
Rem that took a line per step before, and every refusal names the step,
Rem because a caller that cannot see the value needs to know where the
Rem walk stopped. A parsed JSON, XML or HTML document, a CSVPAIRS row and
Rem an HTTP header dict all have this shape, which is why the word is
Rem seed-dict's and not json's.

Def DcSeedDpath(st As RckState) As RckState
    RckReg(st, "DPATH", 2, RckPure(Fn(vs) => DcPath(vs)), "( d path -- v )", "The value at the end of a path: a LIST of STRING keys and NUMBER indices, each step a DGET or an NTH on the value so far. Refuses naming the step that failed. An empty path answers d itself.")

Def DcPath(vs As List Of Cell) As RckWork
    Select Case RckListArg("DPATH", Nth(vs, 2))
        Case Ok(steps)
            DcPathWalk(Nth(vs, 1), steps, 1)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("DPATH did not answer")

Def DcPathWalk(c As Cell, steps As List Of Cell, n As Number) As RckWork
    If IsEmpty(steps) Then
        RckVals({ c })
    Else
        DcPathStep(c, First(steps), Rest(steps), n)

Def DcPathStep(c As Cell, step As Cell, onward As List Of Cell, n As Number) As RckWork
    Select Case step
        Case CutStr(k)
            DcPathKey(c, k, onward, n)
        Case CutNum(i)
            DcPathIndex(c, i, onward, n)
        Case Else
            RckWorkBad("DPATH: step " & Str(n) & " must be a STRING key or a NUMBER index, got " & CutKindOf(step))

Def DcPathKey(c As Cell, k As String, onward As List Of Cell, n As Number) As RckWork
    Select Case DcPairs("DPATH", c)
        Case Ok(ps)
            DcPathFound(ps, k, onward, n)
        Case Else
            RckWorkBad("DPATH: step " & Str(n) & " asks for " & Chr(34) & k & Chr(34) & " of " & CutKindOf(c) & ", not a dict")

Rem The same walk DcGetAt makes, carrying the path so the next step can
Rem start from the value found.
Def DcPathFound(ps As List Of Cell, k As String, onward As List Of Cell, n As Number) As RckWork
    If IsEmpty(ps) Then
        RckWorkBad("DPATH: no entry " & Chr(34) & k & Chr(34) & " at step " & Str(n))
    Else
        DcPathFoundAt(ps, k, onward, n, First(ps))

Def DcPathFoundAt(ps As List Of Cell, k As String, onward As List Of Cell, n As Number, p As Cell) As RckWork
    If CutEqual(DcKeyOf(p), CutStr(k)) Then
        DcPathWalk(DcValOf(p), onward, n + 1)
    Else
        DcPathFound(Rest(ps), k, onward, n)

Def DcPathIndex(c As Cell, i As Number, onward As List Of Cell, n As Number) As RckWork
    Select Case c
        Case CutList(xs)
            DcPathAt(xs, i, onward, n)
        Case Else
            RckWorkBad("DPATH: step " & Str(n) & " asks for element " & Str(i) & " of " & CutKindOf(c) & ", not a list")

Def DcPathAt(xs As List Of Cell, i As Number, onward As List Of Cell, n As Number) As RckWork
    If i < 1 Or i <> Floor(i) Or i > Length(xs) Then
        RckWorkBad("DPATH: step " & Str(n) & " asks for element " & Str(i) & " of a list of " & Str(Length(xs)))
    Else
        DcPathWalk(Nth(xs, i), onward, n + 1)

Rem ---- the seed -----------------------------------------------------------

Def RckSeedDict(st As RckState) As RckState
    Let st1 = DcSeedDhas(RckSeeding(st, "seed-dict"))
    Let st2 = DcSeedDget(st1)
    Let st3 = DcSeedDput(st2)
    Let st4 = DcSeedDkeys(st3)
    DcSeedDpath(st4)
