Rem ==================================================================
Rem seedfin.shoddy — reckoner seed: fin.shoddy, converting at the
Rem bridge
Rem
Rem Rates, time value of money, growth, statistics, budgeting, loan
Rem amortization and payoff, NPV/IRR/payback, CAGR/ROI, dollar-cost
Rem averaging, margin and markup, break-even, payroll, and
Rem depreciation. Per R4.16 there is no RECORD cell at the keyboard:
Rem every Fin* record fin.shoddy returns is a dict here, the same
Rem LIST-of-PAIR shape seeddict.shoddy already established, one entry
Rem per field, named for the field — FinGrowth becomes
Rem { ("interest" n) ("total" n) }, FinAmort becomes
Rem { ("principal" n) ("interest" n) ("balance" n) }, and so on.
Rem
Rem AND THE DAY COUNTS, AND THE BOND PRICER STANDING ON THEM:
Rem FinDays360, FinDateDiff, FinYearFrac, FinCouponsBefore,
Rem FinLastCoupon, FinAccrued, FinBondPrice, FinYtm and FinMdur. That
Rem is a second subsystem rather than more of the first, which is why
Rem it has a section of its own at the foot of this file and its own
Rem account of why each guard is there.
Rem
Rem THE CALENDAR WORDS LIVE IN seedjulian NOW — JULDATE, JULSERIAL and
Rem the rest moved there when the calendar itself moved from fin to
Rem julian.shoddy, renamed to say whose they are. A date is still the
Rem same dict both seeds have always spelled —
Rem { ("yr" n) ("mon" n) ("day" n) } — so a date built by JULDATE flows
Rem straight into FINDAYS360 and the bond words, and the day-count
Rem bases and coupon frequencies are still registered as zero-argument
Rem words, so a session names FIN360 and FINSEMI rather than
Rem remembering that they are 1 and 2.
Rem ==================================================================

Include "fin.shoddy"
Include "julian.shoddy"
Include "cuttle.shoddy"
Include "reckoner.shoddy"
Include "seq.shoddy"

Rem ---- shared conversions -----------------------------------------------

Def FsListNum(word As String, c As Cell) As Result
    Select Case RckListArg(word, c)
        Case Ok(xs)
            FsNumsAt(word, xs, { })
        Case Err(w, at)
            Err(w, at)
        Case Else
            Err(word & " did not answer", 0)

Def FsNumsAt(word As String, xs As List Of Cell, acc As List Of Number) As Result
    If IsEmpty(xs) Then
        Ok(acc)
    Else
        FsNumsNext(word, xs, acc, First(xs))

Def FsNumsNext(word As String, xs As List Of Cell, acc As List Of Number, c As Cell) As Result
    Select Case c
        Case CutNum(x)
            FsNumsAt(word, Rest(xs), Append(acc, x))
        Case Else
            Err(RckKindWhy(word, "a LIST of NUMBERs", c), 0)

Def FsEntry(k As String, v As Cell) As Cell
    CutPair(Pair(CutStr(k), v))

Def FsListOf(ns As List Of Number) As Cell
    CutList(Map(ns, CutNum))

Def FsGrowthCell(g As FinGrowth) As Cell
    CutList({ FsEntry("interest", CutNum(Interest(g))), FsEntry("total", CutNum(Total(g))) })

Def FsStatCell(s As FinStat) As Cell
    CutList({ FsEntry("avg", CutNum(Avg(s))), FsEntry("sd", CutNum(Sd(s))), FsEntry("total", CutNum(Total(s))) })

Def FsAmortCell(a As FinAmort) As Cell
    CutList({ FsEntry("principal", CutNum(Principal(a))), FsEntry("interest", CutNum(Interest(a))), FsEntry("balance", CutNum(Balance(a))) })

Def FsPayoffCell(p As FinPayoff) As Cell
    CutList({ FsEntry("periods", CutNum(Periods(p))), FsEntry("interest", CutNum(Interest(p))) })

Def FsBudgetCell(b As FinBudget) As Cell
    CutList({ FsEntry("net", CutNum(Net(b))), FsEntry("savingsrate", CutNum(SavingsRate(b))) })

Def FsDcaCell(d As FinDca) As Cell
    CutList({ FsEntry("dca", CutNum(Dca(d))), FsEntry("lump", CutNum(Lump(d))) })

Def FsReturnsCell(r As FinReturns) As Cell
    CutList({ FsEntry("avgreturn", CutNum(AvgReturn(r))), FsEntry("sd", CutNum(Sd(r))) })

Def FsBreakEvenCell(b As FinBreakEven) As Cell
    CutList({ FsEntry("units", CutNum(Units(b))), FsEntry("margin", CutNum(Margin(b))) })

Def FsPayrollCell(p As FinPayroll) As Cell
    CutList({ FsEntry("net", CutNum(Net(p))), FsEntry("withheld", CutNum(Withheld(p))) })

Def FsDepCell(d As FinDep) As Cell
    CutList({ FsEntry("amount", CutNum(Amount(d))), FsEntry("book", CutNum(Book(d))), FsEntry("method", CutNum(Method(d))) })

Def FsFitCell(f As FinFit) As Cell
    CutList({ FsEntry("intercept", CutNum(Intercept(f))), FsEntry("slope", CutNum(Slope(f))), FsEntry("rfit", CutNum(RFit(f))) })

Rem ---- rates and conversion ---------------------------------------------

Def FsSeedRates(st As RckState) As RckState
    Let s1 = RckReg(st, "FINPCT", 1, RckPure(Fn(vs) => FsN1("FINPCT", First(vs), FinPct)), "( p -- r )", "p percent as a rate: 5 -> 0.05.")
    Let s2 = RckReg(s1, "FINASPCT", 1, RckPure(Fn(vs) => FsN1("FINASPCT", First(vs), FinAsPct)), "( r -- p )", "A rate as percent: 0.05 -> 5.")
    Let s3 = RckReg(s2, "FINEFF", 2, RckPure(Fn(vs) => FsN2("FINEFF", vs, FinEff)), "( nom m -- eff )", "The effective annual rate from a nominal rate compounded m times a year.")
    Let s4 = RckReg(s3, "FINNOM", 2, RckPure(Fn(vs) => FsN2("FINNOM", vs, FinNom)), "( eff m -- nom )", "The nominal rate that compounds m times a year to eff.")
    Let s5 = RckReg(s4, "FINRULE72", 1, RckPure(Fn(vs) => FsN1("FINRULE72", First(vs), FinRule72)), "( rate -- years )", "The Rule of 72 estimate of years to double.")
    Let s6 = RckReg(s5, "FINREAL", 2, RckPure(Fn(vs) => FsN2("FINREAL", vs, FinReal)), "( nominal inflation -- real )", "The inflation-adjusted rate.")
    Let s7 = RckReg(s6, "FINPCTCHG", 2, RckPure(Fn(vs) => FsN2("FINPCTCHG", vs, FinPctChg)), "( old new -- pct )", "Percent change from old to new.")
    Let s8 = RckReg(s7, "FINTOBPS", 1, RckPure(Fn(vs) => FsN1("FINTOBPS", First(vs), FinToBps)), "( pct -- bps )", "Percent to basis points.")
    RckReg(s8, "FINFROMBPS", 1, RckPure(Fn(vs) => FsN1("FINFROMBPS", First(vs), FinFromBps)), "( bps -- pct )", "Basis points to percent.")

Def FsN1(word As String, c As Cell, f As [ Number -- Number ]) As RckWork
    Select Case RckNumArg(word, c)
        Case Ok(x)
            RckVals({ CutNum(Call(f, x)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsN2(word As String, vs As List Of Cell, f As [ Number Number -- Number ]) As RckWork
    Select Case Pair(RckNumArg(word, Nth(vs, 1)), RckNumArg(word, Nth(vs, 2)))
        Case Pair(Ok(a), Ok(b))
            RckVals({ CutNum(Call(f, a, b)) })
        Case Else
            RckWorkBad(word & " did not answer")

Def FsN3(word As String, vs As List Of Cell, f As [ Number Number Number -- Number ]) As RckWork
    Select Case FsListNum(word, CutList(vs))
        Case Ok(ns)
            RckVals({ CutNum(Call(f, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsN4(word As String, vs As List Of Cell, f As [ Number Number Number Number -- Number ]) As RckWork
    Select Case FsListNum(word, CutList(vs))
        Case Ok(ns)
            RckVals({ CutNum(Call(f, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Rem ---- time value of money ------------------------------------------------

Def FsSeedTvm(st As RckState) As RckState
    Let s1 = RckReg(st, "FINPV", 3, RckPure(Fn(vs) => FsN3("FINPV", vs, FinPv)), "( fv rate n -- pv )", "Present value of a future sum.")
    Let s2 = RckReg(s1, "FINFV", 3, RckPure(Fn(vs) => FsN3("FINFV", vs, FinFv)), "( pv rate n -- fv )", "Future value of a present sum.")
    Let s3 = RckReg(s2, "FINPVANN", 3, RckPure(Fn(vs) => FsN3("FINPVANN", vs, FinPvAnn)), "( pmt rate n -- pv )", "Present value of an ordinary annuity.")
    Let s4 = RckReg(s3, "FINFVANN", 3, RckPure(Fn(vs) => FsN3("FINFVANN", vs, FinFvAnn)), "( pmt rate n -- fv )", "Future value of an ordinary annuity.")
    Let s5 = RckReg(s4, "FINPVANNDUE", 3, RckPure(Fn(vs) => FsN3("FINPVANNDUE", vs, FinPvAnnDue)), "( pmt rate n -- pv )", "Present value of an annuity due (payments at the start of each period).")
    Let s6 = RckReg(s5, "FINFVANNDUE", 3, RckPure(Fn(vs) => FsN3("FINFVANNDUE", vs, FinFvAnnDue)), "( pmt rate n -- fv )", "Future value of an annuity due.")
    Let s7 = RckReg(s6, "FINPMT", 4, RckPure(Fn(vs) => FsN4("FINPMT", vs, FinPmt)), "( pv fv rate n -- pmt )", "The level payment that carries pv to fv over n periods.")
    Let s8 = RckReg(s7, "FINPMTDUE", 4, RckPure(Fn(vs) => FsN4("FINPMTDUE", vs, FinPmtDue)), "( pv fv rate n -- pmt )", "FINPMT for an annuity due.")
    Let s9 = RckReg(s8, "FINNPER", 4, RckPure(Fn(vs) => FsNper(vs)), "( pv fv pmt rate -- n )", "The number of periods to carry pv to fv at a level payment. Refuses when it never gets there.")
    Let s10 = RckReg(s9, "FINSIMPLE", 3, RckPure(Fn(vs) => FsSimple(vs)), "( principal rate years -- growth )", "Simple interest: a dict with interest and total.")
    RckReg(s10, "FINCOMPOUND", 4, RckPure(Fn(vs) => FsCompound(vs)), "( principal rate m years -- growth )", "Compound interest, m compounds a year: a dict with interest and total.")

Def FsNper(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINNPER", CutList(vs))
        Case Ok(ns)
            FsNperAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINNPER did not answer")

Rem FinNper itself Errors when rate <> 0 and pmt <= pv * rate — the
Rem payment does not even cover the first period's interest, so the
Rem balance can never reach fv. Checked here, refused instead.
Def FsNperAt(pv As Number, fv As Number, pmt As Number, rate As Number) As RckWork
    If rate <= -1 Then
        RckWorkBad("FINNPER: RATE MUST BE GREATER THAN -1")
    Else
        If rate <> 0 And pmt <= pv * rate Then
            RckWorkBad("FINNPER: PAYMENT NEVER CLEARS THE INTEREST")
        Else
            RckVals({ CutNum(FinNper(pv, fv, pmt, rate)) })

Def FsSimple(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINSIMPLE", CutList(vs))
        Case Ok(ns)
            RckVals({ FsGrowthCell(FinSimple(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINSIMPLE did not answer")

Def FsCompound(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINCOMPOUND", CutList(vs))
        Case Ok(ns)
            RckVals({ FsGrowthCell(FinCompound(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINCOMPOUND did not answer")

Rem ---- statistics -----------------------------------------------------

Def FsSeedStats(st As RckState) As RckState
    Let s1 = RckReg(st, "FINSUM", 1, RckPure(Fn(vs) => FsL1("FINSUM", First(vs), FinSum)), "( list -- n )", "The sum.")
    Let s2 = RckReg(s1, "FINMEAN", 1, RckPure(Fn(vs) => FsL1G("FINMEAN", First(vs), FinMean)), "( list -- n )", "The mean. Refuses on an empty list.")
    Let s3 = RckReg(s2, "FINSTDDEV", 1, RckPure(Fn(vs) => FsL1G2("FINSTDDEV", First(vs), FinStdDev)), "( list -- n )", "The sample standard deviation. Refuses on fewer than 2 values.")
    Let s4 = RckReg(s3, "FINSTDDEVP", 1, RckPure(Fn(vs) => FsL1G("FINSTDDEVP", First(vs), FinStdDevP)), "( list -- n )", "The population standard deviation. Refuses on an empty list.")
    Let s5 = RckReg(s4, "FINVAR", 1, RckPure(Fn(vs) => FsL1G2("FINVAR", First(vs), FinVar)), "( list -- n )", "The sample variance. Refuses on fewer than 2 values.")
    Let s6 = RckReg(s5, "FINVARP", 1, RckPure(Fn(vs) => FsL1G("FINVARP", First(vs), FinVarP)), "( list -- n )", "The population variance. Refuses on an empty list.")
    Let s7 = RckReg(s6, "FINMEDIAN", 1, RckPure(Fn(vs) => FsL1G("FINMEDIAN", First(vs), FinMedian)), "( list -- n )", "The median. Refuses on an empty list.")
    Let s8 = RckReg(s7, "FINQUANTILE", 2, RckPure(Fn(vs) => FsQuantile(vs)), "( list p -- n )", "The p-quantile (p in [0, 1]).")
    Let s9 = RckReg(s8, "FINMINIMUM", 1, RckPure(Fn(vs) => FsL1G("FINMINIMUM", First(vs), FinMinimum)), "( list -- n )", "The minimum. Refuses on an empty list.")
    Let s10 = RckReg(s9, "FINMAXIMUM", 1, RckPure(Fn(vs) => FsL1G("FINMAXIMUM", First(vs), FinMaximum)), "( list -- n )", "The maximum. Refuses on an empty list.")
    Let s11 = RckReg(s10, "FINRANGEOF", 1, RckPure(Fn(vs) => FsL1G("FINRANGEOF", First(vs), FinRangeOf)), "( list -- n )", "Maximum minus minimum. Refuses on an empty list.")
    Let s12 = RckReg(s11, "FINSKEWNESS", 1, RckPure(Fn(vs) => FsL1G2("FINSKEWNESS", First(vs), FinSkewness)), "( list -- n )", "The sample skewness. Refuses on fewer than 2 values.")
    Let s13 = RckReg(s12, "FINKURTOSIS", 1, RckPure(Fn(vs) => FsL1G2("FINKURTOSIS", First(vs), FinKurtosis)), "( list -- n )", "The excess kurtosis. Refuses on fewer than 2 values.")
    Let s14 = RckReg(s13, "FINWEIGHTEDMEAN", 2, RckPure(Fn(vs) => FsL2("FINWEIGHTEDMEAN", vs, FinWeightedMean)), "( xs ws -- n )", "The mean of xs weighted by ws. Same length required.")
    Let s15 = RckReg(s14, "FINGEOMEAN", 1, RckPure(Fn(vs) => FsL1G("FINGEOMEAN", First(vs), FinGeoMean)), "( list -- n )", "The geometric mean. Refuses on an empty list or a non-positive value.")
    Let s16 = RckReg(s15, "FINCORREL", 2, RckPure(Fn(vs) => FsL2("FINCORREL", vs, FinCorrel)), "( xs ys -- n )", "The Pearson correlation. Same length required.")
    Let s17 = RckReg(s16, "FINCOV", 2, RckPure(Fn(vs) => FsL2("FINCOV", vs, FinCov)), "( xs ys -- n )", "The sample covariance. Same length required.")
    Let s18 = RckReg(s17, "FINSPEARMAN", 2, RckPure(Fn(vs) => FsL2("FINSPEARMAN", vs, FinSpearman)), "( xs ys -- n )", "The Spearman rank correlation. Same length required.")
    Let s19 = RckReg(s18, "FINNORMP", 3, RckPure(Fn(vs) => FsN3("FINNORMP", vs, FinNormP)), "( x mean sd -- p )", "The normal cumulative distribution at x.")
    Let s20 = RckReg(s19, "FINTDIST", 2, RckPure(Fn(vs) => FsN2("FINTDIST", vs, FinTDist)), "( t df -- p )", "Student's t cumulative distribution.")
    RckReg(s20, "FINSTAT1", 1, RckPure(Fn(vs) => FsStat1(vs)), "( list -- stat )", "avg, sd and total together, one pass: a dict.")

Def FsL1(word As String, c As Cell, f As [ List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, c)
        Case Ok(xs)
            RckVals({ CutNum(Call(f, xs)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL1G(word As String, c As Cell, f As [ List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, c)
        Case Ok(xs)
            FsL1GAt(word, xs, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL1GAt(word As String, xs As List Of Number, f As [ List Of Number -- Number ]) As RckWork
    If IsEmpty(xs) Then
        RckWorkBad(word & ": THE LIST IS EMPTY")
    Else
        RckVals({ CutNum(Call(f, xs)) })

Def FsL1G2(word As String, c As Cell, f As [ List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, c)
        Case Ok(xs)
            FsL1G2At(word, xs, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL1G2At(word As String, xs As List Of Number, f As [ List Of Number -- Number ]) As RckWork
    If Length(xs) < 2 Then
        RckWorkBad(word & ": NEEDS AT LEAST 2 VALUES")
    Else
        RckVals({ CutNum(Call(f, xs)) })

Def FsL2(word As String, vs As List Of Cell, f As [ List Of Number List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, First(vs))
        Case Ok(xs)
            FsL2With(word, xs, Nth(vs, 2), f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL2With(word As String, xs As List Of Number, yc As Cell, f As [ List Of Number List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, yc)
        Case Ok(ys)
            FsL2At(word, xs, ys, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL2At(word As String, xs As List Of Number, ys As List Of Number, f As [ List Of Number List Of Number -- Number ]) As RckWork
    If Length(xs) <> Length(ys) Then
        RckWorkBad(word & ": BOTH LISTS MUST BE THE SAME LENGTH")
    Else
        RckVals({ CutNum(Call(f, xs, ys)) })

Def FsQuantile(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINQUANTILE", First(vs))
        Case Ok(xs)
            FsQuantileP(xs, Nth(vs, 2))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINQUANTILE did not answer")

Def FsQuantileP(xs As List Of Number, pc As Cell) As RckWork
    Select Case RckNumArg("FINQUANTILE", pc)
        Case Ok(p)
            FsQuantileAt(xs, p)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINQUANTILE did not answer")

Def FsQuantileAt(xs As List Of Number, p As Number) As RckWork
    If IsEmpty(xs) Then
        RckWorkBad("FINQUANTILE: THE LIST IS EMPTY")
    Else
        If p < 0 Or p > 1 Then
            RckWorkBad("FINQUANTILE: P MUST BE BETWEEN 0 AND 1")
        Else
            RckVals({ CutNum(FinQuantile(xs, p)) })

Def FsStat1(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINSTAT1", First(vs))
        Case Ok(xs)
            FsStat1At(xs)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINSTAT1 did not answer")

Def FsStat1At(xs As List Of Number) As RckWork
    If IsEmpty(xs) Then
        RckWorkBad("FINSTAT1: THE LIST IS EMPTY")
    Else
        RckVals({ FsStatCell(FinStat1(xs)) })

Rem ---- FINFITOF, and the four models it fits ----------------------------
Rem
Rem THE MODEL IS A WORD, not a number to remember, for the same reason the
Rem day-count bases at the foot of this file are: a session reads
Rem FINLOGMODEL rather than 2, and a mistyped model is an unknown word
Rem instead of a different curve fitted in silence.
Rem
Rem FOUR OF THE FIVE GUARDS ARE ABORTS FinFitOf STATES. It Errors by name
Rem on the three model domains — a logarithm of a non-positive x, an
Rem exponential of a non-positive y, a power model needing both — and on
Rem a model it does not recognise. Each is asked here and refused instead.
Rem
Rem THE FIFTH IS THE ONE FIN.SHODDY DOES NOT STATE, and it is the one a
Rem session meets first. LinFit divides by Var(xs) and Correl divides by
Rem StdDev(xs) * StdDev(ys), so a column that does not vary divides by
Rem zero and the runtime ends the run. The test is exact equality of
Rem every element rather than a tolerance, because that is exactly when
Rem those denominators are exactly zero: a nearly-constant column gives a
Rem very large slope, which is fin.shoddy's answer and not this seed's to
Rem overrule.
Rem
Rem ONE VARIATION CHECK COVERS ALL FOUR MODELS, because Log is injective —
Rem a transformed column varies exactly when the column it came from does,
Rem so there is no need to transform before asking.
Rem
Rem A LENGTH CHECK, THOUGH NOTHING ABORTS ON ONE. Cov zips the two lists
Rem and Zip stops at the shorter, so a mismatched pair answers a fit of
Rem the overlap against the means of the whole — a wrong number rather
Rem than a refusal, which is the failure this layer exists for.

Def FsSeedFit(st As RckState) As RckState
    Let s1 = RckReg(st, "FINLINEAR", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinLinear()) })), "( -- model )", "The straight line, y = a + b x.")
    Let s2 = RckReg(s1, "FINLOGMODEL", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinLogModel()) })), "( -- model )", "The logarithmic model, y = a + b ln x. Needs every x above zero.")
    Let s3 = RckReg(s2, "FINEXPMODEL", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinExpModel()) })), "( -- model )", "The exponential model, y = a e^(b x). Needs every y above zero.")
    Let s4 = RckReg(s3, "FINPOWERMODEL", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinPowerModel()) })), "( -- model )", "The power model, y = a x^b. Needs every x and every y above zero.")
    RckReg(s4, "FINFITOF", 3, RckPure(Fn(vs) => FsFitof(vs)), "( xs ys model -- fit )", "Least squares through the points: a dict with intercept, slope and rfit. rfit is the correlation in the FITTED space, which is the R every spreadsheet reports.")

Def FsFitof(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINFITOF", Nth(vs, 1))
        Case Ok(xs)
            FsFitofYs(xs, Nth(vs, 2), Nth(vs, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINFITOF did not answer")

Def FsFitofYs(xs As List Of Number, yc As Cell, mc As Cell) As RckWork
    Select Case FsListNum("FINFITOF", yc)
        Case Ok(ys)
            FsFitofModel(xs, ys, mc)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINFITOF did not answer")

Def FsFitofModel(xs As List Of Number, ys As List Of Number, mc As Cell) As RckWork
    Select Case RckNumArg("FINFITOF", mc)
        Case Ok(model)
            FsFitofWhy(xs, ys, model, FsWhyFit("FINFITOF", xs, ys, model))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINFITOF did not answer")

Def FsFitofWhy(xs As List Of Number, ys As List Of Number, model As Number, why As String) As RckWork
    If why <> "" Then
        RckWorkBad(why)
    Else
        RckVals({ FsFitCell(FinFitOf(xs, ys, model)) })

Rem The guard chain, in the order the failures happen: the pair has to
Rem line up before its length means anything, the length before the model
Rem can be applied, the model before its domain can be checked, and the
Rem domain before a logarithm is taken of anything.

Def FsWhyFit(word As String, xs As List Of Number, ys As List Of Number, model As Number) As String
    If Length(xs) <> Length(ys) Then
        word & ": " & Str(Length(xs)) & " X VALUES AND " & Str(Length(ys)) & " Y VALUES — THEY MUST PAIR UP"
    Else
        FsWhyFitSized(word, xs, ys, model)

Def FsWhyFitSized(word As String, xs As List Of Number, ys As List Of Number, model As Number) As String
    If Length(xs) < 2 Then
        word & ": NEEDS AT LEAST 2 POINTS, AND A LINE THROUGH ONE IS NOT A FIT"
    Else
        FsWhyFitModel(word, xs, ys, model)

Def FsWhyFitModel(word As String, xs As List Of Number, ys As List Of Number, model As Number) As String
    If FsKnownModel(model) Then
        FsWhyFitDomain(word, xs, ys, model)
    Else
        word & ": THAT IS NOT A MODEL — USE FINLINEAR, FINLOGMODEL, FINEXPMODEL OR FINPOWERMODEL"

Def FsKnownModel(model As Number) As Boolean
    model = FinLinear() Or model = FinLogModel() Or model = FinExpModel() Or model = FinPowerModel()

Def FsWhyFitDomain(word As String, xs As List Of Number, ys As List Of Number, model As Number) As String
    If FsLogsX(model) And FinMinimum(xs) <= 0 Then
        word & ": THE " & FsModelName(model) & " MODEL TAKES THE LOGARITHM OF X, SO IT NEEDS EVERY X ABOVE ZERO"
    Else
        If FsLogsY(model) And FinMinimum(ys) <= 0 Then
            word & ": THE " & FsModelName(model) & " MODEL TAKES THE LOGARITHM OF Y, SO IT NEEDS EVERY Y ABOVE ZERO"
        Else
            FsWhyFitVaries(word, xs, ys)

Def FsLogsX(model As Number) As Boolean
    model = FinLogModel() Or model = FinPowerModel()

Def FsLogsY(model As Number) As Boolean
    model = FinExpModel() Or model = FinPowerModel()

Rem Only ever reached for a model that logs one side or the other, so the
Rem linear case never arrives here and the last arm is the power model.
Def FsModelName(model As Number) As String
    If model = FinLogModel() Then
        "LOGARITHMIC"
    Else
        If model = FinExpModel() Then
            "EXPONENTIAL"
        Else
            "POWER"

Def FsWhyFitVaries(word As String, xs As List Of Number, ys As List Of Number) As String
    If FsFlat(xs) Then
        word & ": EVERY X IS THE SAME, SO THERE IS NO LINE TO FIT"
    Else
        If FsFlat(ys) Then
            word & ": EVERY Y IS THE SAME, SO THE CORRELATION HAS NO SPREAD TO DIVIDE BY"
        Else
            ""

Def FsFlat(xs As List Of Number) As Boolean
    All(xs, Fn(x) => x = First(xs))

Rem ---- budgeting, saving and investing ------------------------------

Def FsSeedBudget(st As RckState) As RckState
    Let s1 = RckReg(st, "FINGOALPMT", 4, RckPure(Fn(vs) => FsN4("FINGOALPMT", vs, FinGoalPmt)), "( targetfv pv rate n -- pmt )", "The level payment that reaches targetfv.")
    Let s2 = RckReg(s1, "FINRETIRE", 5, RckPure(Fn(vs) => FsRetire(vs)), "( start contribution peryear rate years -- fv )", "A savings projection: a starting balance plus regular contributions, compounded at the contribution frequency.")
    Let s3 = RckReg(s2, "FINNETWORTH", 2, RckPure(Fn(vs) => FsL2Plain("FINNETWORTH", vs, FinNetWorth)), "( assets liabilities -- n )", "Total assets minus total liabilities.")
    Let s4 = RckReg(s3, "FINBUDGETOF", 2, RckPure(Fn(vs) => FsBudgetof(vs)), "( income expenses -- budget )", "A dict with net and savingsrate.")
    RckReg(s4, "FINDCAOF", 3, RckPure(Fn(vs) => FsDcaof(vs)), "( total intervals prices -- dca )", "Dollar-cost averaging against a lump sum: a dict with dca and lump.")

Def FsRetire(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINRETIRE", CutList(vs))
        Case Ok(ns)
            RckVals({ CutNum(FinRetire(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4), Nth(ns, 5))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINRETIRE did not answer")

Def FsL2Plain(word As String, vs As List Of Cell, f As [ List Of Number List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, First(vs))
        Case Ok(a)
            FsL2PlainWith(word, a, Nth(vs, 2), f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsL2PlainWith(word As String, a As List Of Number, bc As Cell, f As [ List Of Number List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, bc)
        Case Ok(b)
            RckVals({ CutNum(Call(f, a, b)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsBudgetof(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINBUDGETOF", First(vs))
        Case Ok(income)
            FsBudgetofWith(income, Nth(vs, 2))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINBUDGETOF did not answer")

Def FsBudgetofWith(income As List Of Number, expensesC As Cell) As RckWork
    Select Case FsListNum("FINBUDGETOF", expensesC)
        Case Ok(expenses)
            RckVals({ FsBudgetCell(FinBudgetOf(income, expenses)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINBUDGETOF did not answer")

Def FsDcaof(vs As List Of Cell) As RckWork
    Select Case Pair(RckNumArg("FINDCAOF", Nth(vs, 1)), RckWholeArg("FINDCAOF", Nth(vs, 2)))
        Case Pair(Ok(total), Ok(intervals))
            FsDcaofPrices(total, intervals, Nth(vs, 3))
        Case Else
            RckWorkBad("FINDCAOF did not answer")

Def FsDcaofPrices(total As Number, intervals As Number, pricesC As Cell) As RckWork
    Select Case FsListNum("FINDCAOF", pricesC)
        Case Ok(prices)
            RckVals({ FsDcaCell(FinDcaOf(total, intervals, prices)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINDCAOF did not answer")

Rem ---- loans: amortization and payoff ------------------------------------

Def FsSeedLoans(st As RckState) As RckState
    Let s1 = RckReg(st, "FINBALANCE", 4, RckPure(Fn(vs) => FsN4("FINBALANCE", vs, FinBalance)), "( pv rate pmt k -- balance )", "The balance remaining after k payments.")
    Let s2 = RckReg(s1, "FINAMORTAT", 4, RckPure(Fn(vs) => FsAmortat(vs)), "( pv rate pmt k -- amort )", "Payment k's split of principal and interest, and the balance after: a dict.")
    Let s3 = RckReg(s2, "FINSCHEDULE", 4, RckPure(Fn(vs) => FsSchedule(vs)), "( pv rate n pmt -- list )", "The full amortization schedule, one dict per payment.")
    Let s4 = RckReg(s3, "FINEXTRAPAYOFF", 4, RckPure(Fn(vs) => FsExtrapayoff(vs)), "( pv rate pmt extra -- payoff )", "Payoff with an extra amount added to every payment: a dict with periods and interest.")
    Let s5 = RckReg(s4, "FINCARDPAYOFF", 3, RckPure(Fn(vs) => FsCardpayoff(vs)), "( balance apr pmt -- payoff )", "A credit card paid off at a fixed payment: a dict with periods and interest. Refuses if the payment never covers the interest.")
    RckReg(s5, "FINCARDMINPAYOFF", 3, RckPure(Fn(vs) => FsCardminpayoff(vs)), "( balance apr minrate -- payoff )", "Paid off at a percent-of-balance minimum payment: a dict with periods and interest. Refuses if the minimum never exceeds the periodic interest rate.")

Def FsAmortat(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINAMORTAT", CutList(vs))
        Case Ok(ns)
            RckVals({ FsAmortCell(FinAmortAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINAMORTAT did not answer")

Def FsSchedule(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINSCHEDULE", CutList(vs))
        Case Ok(ns)
            FsScheduleAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINSCHEDULE did not answer")

Def FsScheduleAt(pv As Number, rate As Number, n As Number, pmt As Number) As RckWork
    If n < 1 Then
        RckWorkBad("FINSCHEDULE: NEEDS N >= 1")
    Else
        RckVals({ CutList(Map(FinSchedule(pv, rate, n, pmt), FsAmortCell)) })

Rem FinExtraPayoff calls FinNper twice, which Errors when pmt does not
Rem clear the interest (see FINNPER above); the base payment (without
Rem extra) is the binding case.
Def FsExtrapayoff(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINEXTRAPAYOFF", CutList(vs))
        Case Ok(ns)
            FsExtrapayoffAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINEXTRAPAYOFF did not answer")

Def FsExtrapayoffAt(pv As Number, rate As Number, pmt As Number, extra As Number) As RckWork
    If rate <> 0 And pmt <= pv * rate Then
        RckWorkBad("FINEXTRAPAYOFF: PAYMENT NEVER CLEARS THE INTEREST")
    Else
        RckVals({ FsPayoffCell(FinExtraPayoff(pv, rate, pmt, extra)) })

Def FsCardpayoff(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINCARDPAYOFF", CutList(vs))
        Case Ok(ns)
            FsCardpayoffAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINCARDPAYOFF did not answer")

Def FsCardpayoffAt(balance As Number, apr As Number, pmt As Number) As RckWork
    If pmt <= balance * apr / 12 Then
        RckWorkBad("FINCARDPAYOFF: THE PAYMENT NEVER COVERS THE INTEREST")
    Else
        RckVals({ FsPayoffCell(FinCardPayoff(balance, apr, pmt)) })

Rem FinCardMinPayoff simulates up to 1200 months and Errors past that.
Rem Whether it clears within that horizon depends on the balance, not
Rem just the rates, so this guards the one condition that makes
Rem non-payoff certain rather than merely possible: a minimum rate at
Rem or below the periodic interest rate can never reduce a large
Rem balance at all.
Def FsCardminpayoff(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINCARDMINPAYOFF", CutList(vs))
        Case Ok(ns)
            FsCardminpayoffAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINCARDMINPAYOFF did not answer")

Def FsCardminpayoffAt(balance As Number, apr As Number, minRate As Number) As RckWork
    If minRate <= apr / 12 Then
        RckWorkBad("FINCARDMINPAYOFF: MINIMUM NEVER CLEARS THE INTEREST")
    Else
        RckVals({ FsPayoffCell(FinCardMinPayoff(balance, apr, minRate)) })

Rem ---- capital budgeting: NPV, IRR, payback --------------------------

Def FsSeedCapital(st As RckState) As RckState
    Let s1 = RckReg(st, "FINNPV", 3, RckPure(Fn(vs) => FsNpv(vs)), "( outlay cfs rate -- n )", "Net present value: -outlay plus the discounted cash flows.")
    Let s2 = RckReg(s1, "FINNPVOF", 2, RckPure(Fn(vs) => FsCfsRate("FINNPVOF", vs, FinNpvOf)), "( cfs rate -- n )", "The present value of the cash flows alone, no outlay subtracted.")
    Let s3 = RckReg(s2, "FINIRR", 1, RckPure(Fn(vs) => FsIrr(vs)), "( cfs -- rate )", "The internal rate of return. Refuses when none is found in a wide bracket.")
    Let s4 = RckReg(s3, "FINNFV", 2, RckPure(Fn(vs) => FsCfsRate("FINNFV", vs, FinNfv)), "( cfs rate -- n )", "The net future value: every cash flow compounded to the final period.")
    Let s5 = RckReg(s4, "FINMIRR", 3, RckPure(Fn(vs) => FsMirr(vs)), "( cfs financerate reinvestrate -- rate )", "The modified internal rate of return.")
    Let s6 = RckReg(s5, "FINPAYBACK", 2, RckPure(Fn(vs) => FsCfsPlain("FINPAYBACK", vs, FinPayback)), "( outlay cfs -- periods )", "The simple payback period. Refuses if the outlay is never recovered.")
    RckReg(s6, "FINPAYBACKDISC", 3, RckPure(Fn(vs) => FsPaybackdisc(vs)), "( outlay cfs rate -- periods )", "The discounted payback period. Refuses if the outlay is never recovered.")

Def FsNpv(vs As List Of Cell) As RckWork
    Select Case RckNumArg("FINNPV", Nth(vs, 1))
        Case Ok(outlay)
            FsNpvCfs(outlay, Nth(vs, 2), Nth(vs, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINNPV did not answer")

Def FsNpvCfs(outlay As Number, cfsC As Cell, rateC As Cell) As RckWork
    Select Case FsListNum("FINNPV", cfsC)
        Case Ok(cfs)
            FsNpvRate(outlay, cfs, rateC)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINNPV did not answer")

Def FsNpvRate(outlay As Number, cfs As List Of Number, rateC As Cell) As RckWork
    Select Case RckNumArg("FINNPV", rateC)
        Case Ok(rate)
            RckVals({ CutNum(FinNpv(outlay, cfs, rate)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINNPV did not answer")

Def FsCfsRate(word As String, vs As List Of Cell, f As [ List Of Number Number -- Number ]) As RckWork
    Select Case FsListNum(word, First(vs))
        Case Ok(cfs)
            FsCfsRateAt(word, cfs, Nth(vs, 2), f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsCfsRateAt(word As String, cfs As List Of Number, rateC As Cell, f As [ List Of Number Number -- Number ]) As RckWork
    Select Case RckNumArg(word, rateC)
        Case Ok(rate)
            RckVals({ CutNum(Call(f, cfs, rate)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsCfsPlain(word As String, vs As List Of Cell, f As [ Number List Of Number -- Number ]) As RckWork
    Select Case RckNumArg(word, First(vs))
        Case Ok(outlay)
            FsCfsPlainWith(word, outlay, Nth(vs, 2), f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsCfsPlainWith(word As String, outlay As Number, cfsC As Cell, f As [ Number List Of Number -- Number ]) As RckWork
    Select Case FsListNum(word, cfsC)
        Case Ok(cfs)
            FsCfsPlainAt(word, outlay, cfs, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Rem FinPayback answers -1 when the outlay is never recovered (its own
Rem "no payback within the series" sentinel); this refuses instead so a
Rem missing payback reads as a refusal, not a nonsense negative period.
Def FsCfsPlainAt(word As String, outlay As Number, cfs As List Of Number, f As [ Number List Of Number -- Number ]) As RckWork
    Let n = Call(f, outlay, cfs)
    If n < 0 Then
        RckWorkBad(word & ": THE OUTLAY IS NEVER RECOVERED")
    Else
        RckVals({ CutNum(n) })

Def FsIrr(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINIRR", First(vs))
        Case Ok(cfs)
            FsIrrAt(cfs)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINIRR did not answer")

Rem FinIrr itself Errors when the bracket -0.9999..10 shows no sign
Rem change; the same test, checked here first, turns that abort into a
Rem refusal.
Def FsIrrAt(cfs As List Of Number) As RckWork
    If FinNpvOf(cfs, -0.9999) * FinNpvOf(cfs, 10) > 0 Then
        RckWorkBad("FINIRR: NO SIGN CHANGE IN -0.9999..10 - NO RATE TO FIND")
    Else
        RckVals({ CutNum(FinIrr(cfs)) })

Def FsMirr(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINMIRR", First(vs))
        Case Ok(cfs)
            FsMirrRates(cfs, Nth(vs, 2), Nth(vs, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINMIRR did not answer")

Def FsMirrRates(cfs As List Of Number, financeC As Cell, reinvestC As Cell) As RckWork
    Select Case Pair(RckNumArg("FINMIRR", financeC), RckNumArg("FINMIRR", reinvestC))
        Case Pair(Ok(financeRate), Ok(reinvestRate))
            FsMirrShaped(cfs, financeRate, reinvestRate)
        Case Else
            RckWorkBad("FINMIRR did not answer")

Rem FinMirr itself Errors when there is no negative cash flow to
Rem discount (pvNeg = 0) — nothing to finance, so no rate answers.
Def FsMirrShaped(cfs As List Of Number, financeRate As Number, reinvestRate As Number) As RckWork
    If Not Any(cfs, Fn(c) => c < 0) Then
        RckWorkBad("FINMIRR: NO NEGATIVE CASH FLOW TO FINANCE")
    Else
        RckVals({ CutNum(FinMirr(cfs, financeRate, reinvestRate)) })

Def FsPaybackdisc(vs As List Of Cell) As RckWork
    Select Case RckNumArg("FINPAYBACKDISC", Nth(vs, 1))
        Case Ok(outlay)
            FsPaybackdiscCfs(outlay, Nth(vs, 2), Nth(vs, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINPAYBACKDISC did not answer")

Def FsPaybackdiscCfs(outlay As Number, cfsC As Cell, rateC As Cell) As RckWork
    Select Case FsListNum("FINPAYBACKDISC", cfsC)
        Case Ok(cfs)
            FsPaybackdiscRate(outlay, cfs, rateC)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINPAYBACKDISC did not answer")

Def FsPaybackdiscRate(outlay As Number, cfs As List Of Number, rateC As Cell) As RckWork
    Select Case RckNumArg("FINPAYBACKDISC", rateC)
        Case Ok(rate)
            FsPaybackdiscAt(outlay, cfs, rate)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINPAYBACKDISC did not answer")

Def FsPaybackdiscAt(outlay As Number, cfs As List Of Number, rate As Number) As RckWork
    Let n = FinPaybackDisc(outlay, cfs, rate)
    If n < 0 Then
        RckWorkBad("FINPAYBACKDISC: THE OUTLAY IS NEVER RECOVERED")
    Else
        RckVals({ CutNum(n) })

Rem ---- growth measures, margin, break-even, payroll, depreciation ----

Def FsSeedMisc(st As RckState) As RckState
    Let s1 = RckReg(st, "FINCAGR", 3, RckPure(Fn(vs) => FsN3("FINCAGR", vs, FinCagr)), "( begin end years -- rate )", "Compound annual growth rate.")
    Let s2 = RckReg(s1, "FINROI", 2, RckPure(Fn(vs) => FsN2("FINROI", vs, FinRoi)), "( initial final -- pct )", "Return on investment, as a percent.")
    Let s3 = RckReg(s2, "FINRSTAT", 1, RckPure(Fn(vs) => FsRstat(vs)), "( returns -- dict )", "A series' average return and standard deviation: a dict with avgreturn and sd. Refuses on fewer than 2 values.")
    Let s4 = RckReg(s3, "FINYIELD", 2, RckPure(Fn(vs) => FsN2("FINYIELD", vs, FinYield)), "( annualdividend price -- pct )", "Dividend yield.")
    Let s5 = RckReg(s4, "FINDIVGROWTH", 1, RckPure(Fn(vs) => FsL1G2("FINDIVGROWTH", First(vs), FinDivGrowth)), "( series -- rate )", "The compound growth rate of a dividend series. Refuses on fewer than 2 values.")
    Let s6 = RckReg(s5, "FINMARGINOF", 2, RckPure(Fn(vs) => FsN2("FINMARGINOF", vs, FinMarginOf)), "( cost sell -- pct )", "Gross margin as a percent of sell.")
    Let s7 = RckReg(s6, "FINMARKUPOF", 2, RckPure(Fn(vs) => FsN2("FINMARKUPOF", vs, FinMarkupOf)), "( cost sell -- pct )", "Markup as a percent of cost.")
    Let s8 = RckReg(s7, "FINSELLFROMMARGIN", 2, RckPure(Fn(vs) => FsN2("FINSELLFROMMARGIN", vs, FinSellFromMargin)), "( cost margin -- sell )", "The sell price that gives cost the target margin.")
    Let s9 = RckReg(s8, "FINCOSTFROMMARGIN", 2, RckPure(Fn(vs) => FsN2("FINCOSTFROMMARGIN", vs, FinCostFromMargin)), "( sell margin -- cost )", "The cost that gives sell the target margin.")
    Let s10 = RckReg(s9, "FINBREAKEVENOF", 4, RckPure(Fn(vs) => FsBreakevenof(vs)), "( fixedcosts varcost price targetprofit -- breakeven )", "A dict with units (to reach targetprofit, 0 for plain break-even) and margin. Refuses unless price exceeds varcost.")
    Let s11 = RckReg(s10, "FINPAYROLLOF", 2, RckPure(Fn(vs) => FsPayrollof(vs)), "( gross rates -- payroll )", "A dict with net and withheld.")
    Let s12 = RckReg(s11, "FINSL", 3, RckPure(Fn(vs) => FsN3("FINSL", vs, FinSl)), "( cost salvage life -- n )", "The straight-line depreciation per period.")
    Let s13 = RckReg(s12, "FINSLBOOK", 3, RckPure(Fn(vs) => FsSlbook(vs)), "( cost salvage life -- list )", "The book value at the end of every period, straight-line.")
    Let s14 = RckReg(s13, "FINSYD", 4, RckPure(Fn(vs) => FsSyd(vs)), "( cost salvage life period -- dep )", "Sum-of-years-digits depreciation for one period: a dict with amount, book and method.")
    Let s15 = RckReg(s14, "FINDB", 4, RckPure(Fn(vs) => FsDb(vs)), "( cost salvage life period -- n )", "Declining-balance depreciation for one period.")
    Let s16 = RckReg(s15, "FINFACT", 1, RckPure(Fn(vs) => FsGuardWhole1N("FINFACT", First(vs), FinFact)), "( n -- n! )", "The factorial. Refuses unless n >= 0.")
    Let s17 = RckReg(s16, "FINCOMB", 2, RckPure(Fn(vs) => FsCombperm(vs, "FINCOMB", FinComb)), "( n r -- count )", "n choose r.")
    RckReg(s17, "FINPERM", 2, RckPure(Fn(vs) => FsCombperm(vs, "FINPERM", FinPerm)), "( n r -- count )", "The number of ways to arrange r of n, order mattering.")

Def FsGuardWhole1N(word As String, c As Cell, f As [ Number -- Number ]) As RckWork
    Select Case RckWholeArg(word, c)
        Case Ok(n)
            FsGuardWhole1NAt(word, n, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsGuardWhole1NAt(word As String, n As Number, f As [ Number -- Number ]) As RckWork
    If n < 0 Then
        RckWorkBad(word & ": NEEDS N >= 0")
    Else
        RckVals({ CutNum(Call(f, n)) })

Def FsCombperm(vs As List Of Cell, word As String, f As [ Number Number -- Number ]) As RckWork
    Select Case Pair(RckWholeArg(word, Nth(vs, 1)), RckWholeArg(word, Nth(vs, 2)))
        Case Pair(Ok(n), Ok(r))
            FsCombpermAt(word, n, r, f)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsCombpermAt(word As String, n As Number, r As Number, f As [ Number Number -- Number ]) As RckWork
    If n < 0 Or r < 0 Or r > n Then
        RckWorkBad(word & ": NEEDS 0 <= R <= N")
    Else
        RckVals({ CutNum(Call(f, n, r)) })

Def FsRstat(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINRSTAT", First(vs))
        Case Ok(returns)
            FsRstatAt(returns)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINRSTAT did not answer")

Def FsRstatAt(returns As List Of Number) As RckWork
    If Length(returns) < 2 Then
        RckWorkBad("FINRSTAT: NEEDS AT LEAST 2 VALUES")
    Else
        RckVals({ FsReturnsCell(FinRStat(returns)) })

Def FsBreakevenof(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINBREAKEVENOF", CutList(vs))
        Case Ok(ns)
            FsBreakevenofAt(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINBREAKEVENOF did not answer")

Def FsBreakevenofAt(fixedCosts As Number, varCost As Number, price As Number, targetProfit As Number) As RckWork
    If price <= varCost Then
        RckWorkBad("FINBREAKEVENOF: PRICE DOES NOT COVER THE VARIABLE COST")
    Else
        RckVals({ FsBreakEvenCell(FinBreakEvenOf(fixedCosts, varCost, price, targetProfit)) })

Def FsPayrollof(vs As List Of Cell) As RckWork
    Select Case RckNumArg("FINPAYROLLOF", Nth(vs, 1))
        Case Ok(gross)
            FsPayrollofRates(gross, Nth(vs, 2))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINPAYROLLOF did not answer")

Def FsPayrollofRates(gross As Number, ratesC As Cell) As RckWork
    Select Case FsListNum("FINPAYROLLOF", ratesC)
        Case Ok(rates)
            RckVals({ FsPayrollCell(FinPayrollOf(gross, rates)) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINPAYROLLOF did not answer")

Def FsSlbook(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINSLBOOK", CutList(vs))
        Case Ok(ns)
            RckVals({ FsListOf(FinSlBook(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINSLBOOK did not answer")

Def FsSyd(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINSYD", CutList(vs))
        Case Ok(ns)
            RckVals({ FsDepCell(FinSyd(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINSYD did not answer")

Def FsDb(vs As List Of Cell) As RckWork
    Select Case FsListNum("FINDB", CutList(vs))
        Case Ok(ns)
            RckVals({ CutNum(FinDb(Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4))) })
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINDB did not answer")

Rem ---- the day counts, and the bond pricer standing on them -------------
Rem
Rem A DATE IS A DICT — { ("yr" n) ("mon" n) ("day" n) } — built by
Rem seedjulian's JULDATE and read back by its JULDATESHOW. The calendar
Rem words lived here while fin carried the calendar; they moved with
Rem it. What is registered below is what stayed in fin: the day-count
Rem bases, and the bond pricer.
Rem
Rem THE BASIS AND THE FREQUENCY ARE WORDS, not numbers to remember.
Rem fin.shoddy spells them as zero-argument Defs because Shoddy has no
Rem enum; the same choice here means a session reads
Rem "SETTLE MAT 0.05 P FINSEMI FIN360 FINYTM" rather than "... 2 1 ...",
Rem and a mistyped basis is an unknown word instead of a wrong answer.
Rem
Rem WHY THE DATE IS STILL VALIDATED HERE. A dict can arrive hand-built,
Rem and JulSerial is pure integer arithmetic with no opinion about
Rem whether a date exists — the raw constructor serializes a 30th of
Rem February perfectly happily to the 2nd of March. A wrong ANSWER
Rem rather than a refusal is the one outcome these seeds exist to
Rem prevent, so every word that takes a date checks it on the way in,
Rem exactly as JULDATE checked it on the way out.
Rem
Rem THE SAME REASONING SETS THE OTHER GUARDS. FinYearFrac falls through
Rem to ACT/365.25 for any basis it does not recognise, so an unknown
Rem basis is refused rather than silently treated as one. FinLastCoupon
Rem steps back by 12/freq MONTHS, so a frequency that does not divide 12
Rem walks the wrong calendar. FinBondPrice raises (1 + yld/freq) to a
Rem power, so a yield at or below -freq is a zero or negative base. And
Rem FinYtm Errors outright when no yield in 0..2 prices the bond — the
Rem one abort in this subsystem, and the same shape FINIRR already
Rem guards: the test asked here first, and refused instead.

Def FsDateCell(d As JulDate) As Cell
    CutList({ FsEntry("yr", CutNum(JulYear(d))), FsEntry("mon", CutNum(JulMonth(d))), FsEntry("day", CutNum(JulDay(d))) })

Def FsDateWhy(word As String) As String
    word & ": NOT A DATE — USE JULDATE, OR JULDATEOF ON " & RckQuoteMark() & "YYYY-MM-DD" & RckQuoteMark()

Def FsDateOf(word As String, c As Cell) As Result
    Select Case RckListArg(word, c)
        Case Ok(fields)
            FsDateFields(word, fields)
        Case Err(w, at)
            Err(w, at)
        Case Else
            Err(word & " did not answer", 0)

Def FsDateFields(word As String, fields As List Of Cell) As Result
    If Length(fields) <> 3 Then
        Err(FsDateWhy(word), 0)
    Else
        FsDateNums(word, Map(fields, FsPairVal))

Def FsPairVal(entry As Cell) As Cell
    Select Case entry
        Case CutPair(p)
            Snd(p)
        Case Else
            entry

Def FsDateNums(word As String, vals As List Of Cell) As Result
    Select Case FsListNum(word, CutList(vals))
        Case Ok(ns)
            FsDateMade(word, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))
        Case Err(w, at)
            Err(FsDateWhy(word), 0)
        Case Else
            Err(word & " did not answer", 0)

Rem The one calendar check, used by every date-taking word on a dict
Rem that may have been built by hand. The rules are julian's.
Def FsDateMade(word As String, y As Number, m As Number, d As Number) As Result
    If y <> Floor(y) Or m <> Floor(m) Or d <> Floor(d) Then
        Err(word & ": A YEAR, MONTH AND DAY MUST ALL BE WHOLE NUMBERS", 0)
    Else
        FsDateReal(word, y, m, d)

Def FsDateReal(word As String, y As Number, m As Number, d As Number) As Result
    If m < 1 Or m > 12 Then
        Err(word & ": THERE IS NO MONTH " & Str(m), 0)
    Else
        FsDateDay(word, y, m, d)

Def FsDateDay(word As String, y As Number, m As Number, d As Number) As Result
    If d < 1 Or d > JulDaysInMonth(y, m) Then
        Err(word & ": " & Str(m) & "/" & Str(y) & " HAS " & Str(JulDaysInMonth(y, m)) & " DAYS, SO THERE IS NO DAY " & Str(d), 0)
    Else
        Ok(JulDate(y, m, d))

Rem ---- the basis and frequency words ------------------------------------

Def FsSeedConsts(st As RckState) As RckState
    Let s1 = RckReg(st, "FINACTUAL", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinActual()) })), "( -- basis )", "The actual/365.25 day-count basis, for FINDATEDIFF, FINYEARFRAC and the bond words.")
    Let s2 = RckReg(s1, "FIN360", 0, RckPure(Fn(vs) => RckVals({ CutNum(Fin360()) })), "( -- basis )", "The NASD 30/360 day-count basis, where every month is 30 days and every year 360.")
    Let s3 = RckReg(s2, "FIN365", 0, RckPure(Fn(vs) => RckVals({ CutNum(Fin365()) })), "( -- basis )", "The actual/365 day-count basis.")
    Let s4 = RckReg(s3, "FINANNUAL", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinAnnual()) })), "( -- freq )", "One coupon a year.")
    Let s5 = RckReg(s4, "FINSEMI", 0, RckPure(Fn(vs) => RckVals({ CutNum(FinSemi()) })), "( -- freq )", "Two coupons a year, which is what most bonds pay.")
    RckReg(s5, "FINQUARTERLY", 0, RckPure(Fn(vs) => RckVals({ CutNum(4) })), "( -- freq )", "Four coupons a year.")

Rem A basis fin.shoddy does not know is not an error there — FinYearFrac
Rem falls through to actual/365.25 — so an unrecognised one would be a
Rem quietly different answer. Named here, refused here.
Def FsWhyBasis(word As String, basis As Number) As String
    If basis <> FinActual() And basis <> Fin360() And basis <> Fin365() Then
        word & ": THAT IS NOT A DAY-COUNT BASIS — USE FINACTUAL, FIN360 OR FIN365"
    Else
        ""

Rem FinLastCoupon steps back by 12 / freq whole months, so a frequency
Rem that does not divide 12 lands between months and prices a bond that
Rem does not exist.
Def FsWhyFreq(word As String, freq As Number) As String
    If freq < 1 Or freq <> Floor(freq) Or 12 Mod freq <> 0 Then
        word & ": A COUPON FREQUENCY MUST DIVIDE 12 EVENLY — USE FINANNUAL, FINSEMI, FINQUARTERLY, OR 6 OR 12"
    Else
        ""

Rem ---- the day-count words ------------------------------------------------

Def FsSeedDates(st As RckState) As RckState
    Let s1 = RckReg(st, "FINDAYS360", 2, RckPure(Fn(vs) => FsDays360(vs)), "( a b -- n )", "Days from a to b on the NASD 30/360 rule.")
    Let s2 = RckReg(s1, "FINDATEDIFF", 3, RckPure(Fn(vs) => FsDatediff(vs)), "( a b basis -- n )", "Days from a to b, counted on the given basis.")
    RckReg(s2, "FINYEARFRAC", 3, RckPure(Fn(vs) => FsYearfrac(vs)), "( a b basis -- n )", "The fraction of a year from a to b on the given basis.")

Def FsDays360(vs As List Of Cell) As RckWork
    FsOnTwoDates("FINDAYS360", vs, Fn(a, b) => RckVals({ CutNum(FinDays360(a, b)) }))

Def FsDatediff(vs As List Of Cell) As RckWork
    FsOnTwoDates("FINDATEDIFF", vs, Fn(a, b) => FsBasisThen("FINDATEDIFF", vs, Fn(basis) => CutNum(FinDateDiff(a, b, basis))))

Def FsYearfrac(vs As List Of Cell) As RckWork
    FsOnTwoDates("FINYEARFRAC", vs, Fn(a, b) => FsBasisThen("FINYEARFRAC", vs, Fn(basis) => CutNum(FinYearFrac(a, b, basis))))

Def FsOnTwoDates(word As String, vs As List Of Cell, f As [ JulDate JulDate -- RckWork ]) As RckWork
    Select Case FsDateOf(word, Nth(vs, 1))
        Case Ok(a)
            FsOnTwoDatesAt(word, a, Nth(vs, 2), f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsOnTwoDatesAt(word As String, a As JulDate, c As Cell, f As [ JulDate JulDate -- RckWork ]) As RckWork
    Select Case FsDateOf(word, c)
        Case Ok(b)
            Call(f, a, b)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Rem The basis is always the last argument, so it is read off the end.
Def FsBasisThen(word As String, vs As List Of Cell, f As [ Number -- Cell ]) As RckWork
    Select Case RckNumArg(word, Last(vs))
        Case Ok(basis)
            FsBasisAt(word, basis, f)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsBasisAt(word As String, basis As Number, f As [ Number -- Cell ]) As RckWork
    If FsWhyBasis(word, basis) <> "" Then
        RckWorkBad(FsWhyBasis(word, basis))
    Else
        RckVals({ Call(f, basis) })

Rem ---- the bonds ---------------------------------------------------------

Def FsSeedBonds(st As RckState) As RckState
    Let s1 = RckReg(st, "FINCOUPONSBEFORE", 3, RckPure(Fn(vs) => FsCouponsbefore(vs)), "( settle maturity freq -- n )", "How many coupons are still to come between settlement and maturity.")
    Let s2 = RckReg(s1, "FINLASTCOUPON", 3, RckPure(Fn(vs) => FsLastcoupon(vs)), "( settle maturity freq -- date )", "The coupon date on or before settlement — what FINACCRUED accrues from.")
    Let s3 = RckReg(s2, "FINACCRUED", 5, RckPure(Fn(vs) => FsAccrued(vs)), "( settle lastcoupon coupon freq basis -- n )", "Interest earned since the last coupon and not yet paid, per 100 of face. coupon is a rate: 0.05 for a five percent bond.")
    Let s4 = RckReg(s3, "FINBONDPRICE", 6, RckPure(Fn(vs) => FsBondprice(vs)), "( settle maturity coupon yld freq basis -- price )", "The clean price per 100 of face — accrued interest excluded, which is what a quoted price means. FINACCRUED is the rest of it.")
    Let s5 = RckReg(s4, "FINYTM", 6, RckPure(Fn(vs) => FsYtm(vs)), "( settle maturity coupon price freq basis -- yield )", "The yield to maturity that prices the bond at price. Refuses when no yield between 0 and 2 does.")
    RckReg(s5, "FINMDUR", 5, RckPure(Fn(vs) => FsMdur(vs)), "( settle maturity coupon yld freq -- years )", "Modified duration in years: roughly how much the price moves for a one-point move in yield.")

Rem Every bond word starts the same way — two dates and then numbers —
Rem so the reading is done once and each word says what to do with what
Rem came out. settle must come BEFORE maturity: FinCouponsBefore would
Rem otherwise answer zero or fewer coupons, and the price walk would run
Rem over an empty range and answer the redemption alone.
Def FsBond(word As String, vs As List Of Cell, f As [ JulDate JulDate List Of Number -- RckWork ]) As RckWork
    FsOnTwoDates(word, vs, Fn(a, b) => FsBondOrdered(word, a, b, DropN(vs, 2), f))

Def FsBondOrdered(word As String, a As JulDate, b As JulDate, rest As List Of Cell, f As [ JulDate JulDate List Of Number -- RckWork ]) As RckWork
    If JulSerial(a) >= JulSerial(b) Then
        RckWorkBad(word & ": SETTLEMENT MUST FALL BEFORE MATURITY")
    Else
        FsBondNums(word, a, b, rest, f)

Def FsBondNums(word As String, a As JulDate, b As JulDate, rest As List Of Cell, f As [ JulDate JulDate List Of Number -- RckWork ]) As RckWork
    Select Case FsListNum(word, CutList(rest))
        Case Ok(ns)
            Call(f, a, b, ns)
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad(word & " did not answer")

Def FsCouponsbefore(vs As List Of Cell) As RckWork
    FsBond("FINCOUPONSBEFORE", vs, Fn(s, m, ns) => FsFreqThen("FINCOUPONSBEFORE", Nth(ns, 1), Fn(freq) => CutNum(FinCouponsBefore(s, m, freq))))

Def FsLastcoupon(vs As List Of Cell) As RckWork
    FsBond("FINLASTCOUPON", vs, Fn(s, m, ns) => FsFreqThen("FINLASTCOUPON", Nth(ns, 1), Fn(freq) => FsDateCell(FinLastCoupon(s, m, freq))))

Def FsFreqThen(word As String, freq As Number, f As [ Number -- Cell ]) As RckWork
    If FsWhyFreq(word, freq) <> "" Then
        RckWorkBad(FsWhyFreq(word, freq))
    Else
        RckVals({ Call(f, freq) })

Rem ( settle lastcoupon coupon freq basis -- n ). The two dates here are
Rem the other way round from the rest — accrual runs from the last coupon
Rem forward to settlement — so this one does not use FsBond's ordering
Rem check, and asks its own.
Def FsAccrued(vs As List Of Cell) As RckWork
    FsOnTwoDates("FINACCRUED", vs, Fn(s, lc) => FsAccruedNums(s, lc, DropN(vs, 2)))

Def FsAccruedNums(settle As JulDate, lastCoupon As JulDate, rest As List Of Cell) As RckWork
    Select Case FsListNum("FINACCRUED", CutList(rest))
        Case Ok(ns)
            FsAccruedAt(settle, lastCoupon, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3))
        Case Err(w, at)
            RckWorkBad(w)
        Case Else
            RckWorkBad("FINACCRUED did not answer")

Def FsAccruedAt(settle As JulDate, lastCoupon As JulDate, coupon As Number, freq As Number, basis As Number) As RckWork
    If FsWhyFreq("FINACCRUED", freq) & FsWhyBasis("FINACCRUED", basis) <> "" Then
        RckWorkBad(FsWhyFreq("FINACCRUED", freq) & FsWhyBasis("FINACCRUED", basis))
    Else
        FsAccruedOrdered(settle, lastCoupon, coupon, freq, basis)

Def FsAccruedOrdered(settle As JulDate, lastCoupon As JulDate, coupon As Number, freq As Number, basis As Number) As RckWork
    If JulSerial(lastCoupon) > JulSerial(settle) Then
        RckWorkBad("FINACCRUED: THE LAST COUPON MUST FALL ON OR BEFORE SETTLEMENT")
    Else
        RckVals({ CutNum(FinAccrued(settle, lastCoupon, coupon, freq, basis)) })

Def FsBondprice(vs As List Of Cell) As RckWork
    FsBond("FINBONDPRICE", vs, Fn(s, m, ns) => FsBondpriceAt(s, m, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4)))

Rem (1 + yld/freq) is the discount base raised to every coupon's power,
Rem so a yield at or below -freq makes it zero or negative — a division
Rem by zero, or a fractional power of a negative, neither of which is a
Rem price.
Def FsBondpriceAt(settle As JulDate, maturity As JulDate, coupon As Number, yld As Number, freq As Number, basis As Number) As RckWork
    If FsWhyBond("FINBONDPRICE", yld, freq, basis) <> "" Then
        RckWorkBad(FsWhyBond("FINBONDPRICE", yld, freq, basis))
    Else
        RckVals({ CutNum(FinBondPrice(settle, maturity, coupon, yld, freq, basis)) })

Def FsWhyBond(word As String, yld As Number, freq As Number, basis As Number) As String
    If FsWhyFreq(word, freq) & FsWhyBasis(word, basis) <> "" Then
        FsWhyFreq(word, freq) & FsWhyBasis(word, basis)
    Else
        FsWhyYield(word, yld, freq)

Def FsWhyYield(word As String, yld As Number, freq As Number) As String
    If yld <= 0 - freq Then
        word & ": A YIELD AT OR BELOW MINUS THE COUPON FREQUENCY HAS NO DISCOUNT FACTOR"
    Else
        ""

Def FsYtm(vs As List Of Cell) As RckWork
    FsBond("FINYTM", vs, Fn(s, m, ns) => FsYtmAt(s, m, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3), Nth(ns, 4)))

Rem FinYtm itself Errors when the bracket 0..2 shows no sign change; the
Rem same test, run here first, turns that abort into a refusal — exactly
Rem what FINIRR already does for the internal rate of return.
Def FsYtmAt(settle As JulDate, maturity As JulDate, coupon As Number, price As Number, freq As Number, basis As Number) As RckWork
    If FsWhyBond("FINYTM", 0, freq, basis) <> "" Then
        RckWorkBad(FsWhyBond("FINYTM", 0, freq, basis))
    Else
        FsYtmBracket(settle, maturity, coupon, price, freq, basis)

Def FsYtmBracket(settle As JulDate, maturity As JulDate, coupon As Number, price As Number, freq As Number, basis As Number) As RckWork
    If (FinBondPrice(settle, maturity, coupon, 0, freq, basis) - price) * (FinBondPrice(settle, maturity, coupon, 2, freq, basis) - price) > 0 Then
        RckWorkBad("FINYTM: NO YIELD BETWEEN 0 AND 2 PRICES THIS BOND AT " & Str(price))
    Else
        RckVals({ CutNum(FinYtm(settle, maturity, coupon, price, freq, basis)) })

Def FsMdur(vs As List Of Cell) As RckWork
    FsBond("FINMDUR", vs, Fn(s, m, ns) => FsMdurAt(s, m, Nth(ns, 1), Nth(ns, 2), Nth(ns, 3)))

Rem FinMdur divides by the price it computes, so a bond priced at zero
Rem would divide by it. FIN360 is the basis FinMdur uses internally, so
Rem that is the basis the price is checked at.
Def FsMdurAt(settle As JulDate, maturity As JulDate, coupon As Number, yld As Number, freq As Number) As RckWork
    If FsWhyBond("FINMDUR", yld, freq, Fin360()) <> "" Then
        RckWorkBad(FsWhyBond("FINMDUR", yld, freq, Fin360()))
    Else
        FsMdurPriced(settle, maturity, coupon, yld, freq)

Def FsMdurPriced(settle As JulDate, maturity As JulDate, coupon As Number, yld As Number, freq As Number) As RckWork
    If FinBondPrice(settle, maturity, coupon, yld, freq, Fin360()) = 0 Then
        RckWorkBad("FINMDUR: THAT BOND PRICES AT ZERO, SO IT HAS NO DURATION")
    Else
        RckVals({ CutNum(FinMdur(settle, maturity, coupon, yld, freq)) })

Rem ---- the seed -----------------------------------------------------------

Def RckSeedFin(st As RckState) As RckState
    Let s1 = FsSeedRates(RckSeeding(st, "seed-fin"))
    Let s2 = FsSeedTvm(s1)
    Let s3 = FsSeedStats(s2)
    Let s3a = FsSeedFit(s3)
    Let s4 = FsSeedBudget(s3a)
    Let s5 = FsSeedLoans(s4)
    Let s6 = FsSeedCapital(s5)
    Let s7 = FsSeedMisc(s6)
    Let s8 = FsSeedConsts(s7)
    Let s9 = FsSeedDates(s8)
    FsSeedBonds(s9)
