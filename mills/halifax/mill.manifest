    "math",
    "matrix",
    "mip",
    "money",
    "mps",
    "net",
    "neural",
    "plotter",
    "random",
    "recio",
    "reckoner",
    "regex",
    "scribbler",
    "seedalg",
    "seedbool",
    "seedbuiltin",
    "seedbuzzer",
    "seedclock",
    "seedcsv",
    "seeddict",
    "seedeng",
    "seedfile",
    "seedfin",
    "seedhtml",
    "seedhttps",
    "seedisam",
    "seedjson",
    "seedkeys",
    "seedlin",
    "seedmath",
    "seedmatrix",
    "seedmip",
    "seedmoney",
    "seednet",
    "seedneural",
    "seedplotter",
    "seedrandom",
    "seedrecio",
    "seedregex",
    "seedscribbler",
    "seedseq",
    "seedshaker",
    "seedsimplex",
    "seedsparse",
    "seedstats",
    "seedstr",
    "seedturtle",
    "seedvt100",
    "seedxml",
    "seq",
    "shaker",
    "simplex",
    "sparse",
    "stats",
    "str",
    "turtle",
    "vt100",
    "xml"
  ],
  "capabilities": {
    "file": {
      "read": ["halifaxrc"],
      "write": ["halifaxrc", "*.calc", "*.tape"]
    },
    "terminal": true,
    "clock": { "optional": true },
    "random": { "optional": true },
    "keys": { "optional": true },
    "vt100": { "optional": true },
    "scribbler": { "optional": true },
    "buzzer": { "optional": true },
    "net": { "optional": true }
  },
  "assets": [],
  "goldens": [
    "test.shoddy"
  ]
}
