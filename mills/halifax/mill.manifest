{
  "$schema": "https://shoddymills.github.io/shoddy/schemas/mill.manifest.json",
  "name": "halifax",
  "version": "1.0",
  "core": "halifax-core.shoddy",
  "shell": "halifax.shoddy",
  "modes": [
    "T",
    "N"
  ],
  "machines": [
    "alg",
