Rem ==================================================================
Rem invaders-core.shoddy — Space Invaders, the pure model.
Rem
Rem Everything the game IS that does not touch a window: the state record,
Rem the per-frame simulation, and the input actions. It includes no
Rem scribbler, so it runs headless and is unit-tested that way
Rem (src/Shoddy.Tests/InvadersTests.cs). invaders.shoddy adds the drawing
Rem and the event loop on top. RandInt/Clamp/Dist come from math; Any from
Rem seq; GameKey from keys.
Rem ==================================================================

Include "seq.shoddy"
Include "math.shoddy"
Include "keys.shoddy"

Rem ---- tunables ------------------------------------------------------

Let gameW = 480
Let gameH = 640
Let cannonY = 606
Let cannonHalf = 18
Let cannonStep = 7
Let laserSpeed = 16
Let alienSpeed = 2
Let alienR = 14
Let spawnMs = 950
Let gutter = 30
Let hitDist = 22

Rem ---- state ---------------------------------------------------------

Type Alien
    Ax As Number
    Ay As Number
    Cr As Number
    Cg As Number
    Cb As Number

Type Laser
    Lx As Number
    Ly As Number

Type Game
    Cx        As Number         Rem cannon centre x
    Vel       As Number         Rem -1 / 0 / 1
    Lasers    As List Of Laser
    Aliens    As List Of Alien
    Score     As Number
    NextSpawn As Number         Rem Ticks value at which to spawn the next alien
    Ended     As Boolean         Rem NOT "Over" — OVER is a stack builtin and would shadow the accessor

Def NewGame() As Game
    Game(gameW / 2, 0, {}, {}, 0, 0, False)

Rem ---- simulation ----------------------------------------------------

Def MoveCannon(g As Game) As Game
    With(g, Cx = Clamp(Cx(g) + Vel(g) * cannonStep, gutter, gameW - gutter))

Rem Advance lasers up the screen; drop any that leave the top.
Def MoveLasers(g As Game) As Game
    Let flown = Map(Lasers(g), Fn(l) => Laser(Lx(l), Ly(l) - laserSpeed))
    With(g, Lasers = Filter(flown, Fn(l) => Ly(l) > -20))

Rem Advance aliens down the screen; reaching the cannon line ends the game.
Def MoveAliens(g As Game) As Game
    Let fallen = Map(Aliens(g), Fn(a) => Alien(Ax(a), Ay(a) + alienSpeed, Cr(a), Cg(a), Cb(a)))
    With(g, Aliens = fallen, Ended = Ended(g) Or Any(fallen, Fn(a) => Ay(a) > cannonY - cannonHalf))

Def RandomAlien() As Alien
    Alien(RandInt(gutter, gameW - gutter), 0, RandInt(120, 255), RandInt(120, 255), RandInt(120, 255))

Def MaybeSpawn(g As Game, now As Number) As Game
    If now >= NextSpawn(g) Then
        With(g, Aliens = Prepend(RandomAlien(), Aliens(g)), NextSpawn = now + spawnMs)
    Else
        g

Def Near(ax As Number, ay As Number, l As Laser) As Boolean
    Dist(ax, ay, Lx(l), Ly(l)) < hitDist

Def AlienDead(a As Alien, lasers As List Of Laser) As Boolean
    Any(lasers, Fn(l) => Near(Ax(a), Ay(a), l))

Def LaserSpent(l As Laser, aliens As List Of Alien) As Boolean
    Any(aliens, Fn(a) => Near(Ax(a), Ay(a), l))

Rem Remove every alien a laser reached and every laser that reached one;
Rem score the aliens cleared this frame.
Def Collide(g As Game) As Game
    Let liveAliens = Filter(Aliens(g), Fn(a) => Not AlienDead(a, Lasers(g)))
    Let liveLasers = Filter(Lasers(g), Fn(l) => Not LaserSpent(l, Aliens(g)))
    Let hits = Length(Aliens(g)) - Length(liveAliens)
    With(g, Aliens = liveAliens, Lasers = liveLasers, Score = Score(g) + hits)

Def Advance(g As Game, now As Number) As Game
    If Ended(g) Then
        g
    Else
        Collide(MoveAliens(MoveLasers(MoveCannon(MaybeSpawn(g, now)))))

Rem ---- input actions -------------------------------------------------

Def Fire(g As Game) As Game
    With(g, Lasers = Prepend(Laser(Cx(g), cannonY - cannonHalf), Lasers(g)))

Def ActDown(g As Game, k As GameKey) As Game
    Select Case k
        Case ArrowLeft
            With(g, Vel = -1)
        Case ArrowRight
            With(g, Vel = 1)
        Case SpaceBar
            Fire(g)
        Case Else
            g

Rem Releasing either arrow stops the cannon.
Def ActUp(g As Game, k As GameKey) As Game
    Select Case k
        Case ArrowLeft
            With(g, Vel = 0)
        Case ArrowRight
            With(g, Vel = 0)
        Case Else
            g

Def QuitKey(k As GameKey) As Boolean
    Select Case k
        Case EscKey
            True
        Case CharKey(c) Where c = Asc("Q")
            True
        Case Else
            False
