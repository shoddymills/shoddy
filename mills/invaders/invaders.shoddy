Rem ==================================================================
Rem invaders.shoddy — Space Invaders on the scribbler (window + loop).
Rem
Rem Run: mill run mills/invaders/invaders.shoddy
Rem      Left / Right arrows move the cannon, Space fires, Q or Escape
Rem      quits. Aliens descend at random; a laser that reaches one clears
Rem      both and scores. An alien reaching the cannon line ends the game.
Rem
Rem The pure model — state, simulation, input actions — is in
Rem invaders-core.shoddy and is unit-tested headless. This file is the
Rem window half: drawing, sound, and the event loop. Frames come from
Rem ScribblerTick at a fixed FPS (SetFps), so the loop sits at zero CPU
Rem between frames and input arrives on the same queue. Every branch of
Rem Loop's Select Case calls Loop directly (or closes) — a genuine SELF
Rem tail call, which CodeGen turns into a loop; a helper that called Loop
Rem back would be mutual recursion and grow the stack one frame per tick.
Rem
Rem Sound stays out of the core too: effects are inferred by comparing
Rem the game before and after a step — a laser appearing is a shot, the
Rem score rising is a hit, Ended flipping on is the end — so the pure
Rem model needs no sound hooks and still tests headless.
Rem ==================================================================

Include "invaders-core.shoddy"
Include "scribbler.shoddy"
Include "buzzer.shoddy"

Rem ---- rendering -----------------------------------------------------

Def DrawAliens(sc As Scribbler, aliens As List Of Alien) As Scribbler
    Fold(aliens, sc, Fn(s, a) => FillCircle(s, Round(Ax(a)), Round(Ay(a)), alienR, Cr(a), Cg(a), Cb(a)))

Def DrawLasers(sc As Scribbler, lasers As List Of Laser) As Scribbler
    Fold(lasers, sc, Fn(s, l) => FillRect(s, Round(Lx(l)) - 1, Round(Ly(l)) - 10, 3, 14, 255, 70, 70))

Def DrawCannon(sc As Scribbler, cx As Number) As Scribbler
    Let baseRow = FillRect(sc, Round(cx) - cannonHalf, cannonY - 6, cannonHalf * 2, 12, 210, 210, 255)
    FillRect(baseRow, Round(cx) - 2, cannonY - cannonHalf, 5, cannonHalf, 210, 210, 255)

Def ShowOver(sc As Scribbler, g As Game) As Scribbler
    If Ended(g) Then
        ScribblerText(sc, gameW / 2 - 84, gameH / 2 - 8, 3, 255, 90, 90, "GAME OVER")
    Else
        sc

Def Draw(sc As Scribbler, g As Game) As Scribbler
    Let bg = ScribblerFill(sc, 12, 12, 26)
    Let a = DrawAliens(bg, Aliens(g))
    Let la = DrawLasers(a, Lasers(g))
    Let cn = DrawCannon(la, Cx(g))
    Let hud = ScribblerText(cn, 8, 8, 2, 235, 235, 235, "SCORE " & Str(Score(g)))
    ScribblerBlit(ShowOver(hud, g))

Rem ---- sound ---------------------------------------------------------
Rem The shot is a fire-and-forget blip from the anonymous pool; the hit
Rem is a two-step falling thud queued on channel 2 (SoundQueue plays the
Rem pair in order); tunes own channel 1. Silent machines make every
Rem sound word a no-op, so the game still runs everywhere it did.

Def ShotSound(before As Game, after As Game)
    If Length(Lasers(after)) > Length(Lasers(before)) Then
        Sound(1200, 40)

Def HitThud()
    SoundQueue(2, 220, 50)
    SoundQueue(2, 130, 90)

Def GameOverTune()
    Play(1, "T100 O3 L8 E D C < A2")

Def TickSounds(before As Game, after As Game)
    If Score(after) > Score(before) Then
        HitThud()
    If Ended(after) And Not Ended(before) Then
        GameOverTune()

Rem Stop anything still queued before the window goes.
Def CloseDown(sc As Scribbler) As Scribbler
    SoundStop(1)
    SoundStop(2)
    ScribblerClose(sc)

Rem ---- the loop ------------------------------------------------------

Def Loop(sc As Scribbler, g As Game) As Scribbler
    Select Case NextEvent(sc)
        Case ScribblerTick(at)
            Let g2 = Advance(g, at)
            TickSounds(g, g2)
            Loop(Draw(sc, g2), g2)
        Case ScribblerKeyDown(key, mods, at)
            If QuitKey(ClassifyKey(key)) Then
                CloseDown(sc)
            Else
                Let g2 = ActDown(g, ClassifyKey(key))
                ShotSound(g, g2)
                Loop(sc, g2)
        Case ScribblerKeyUp(key, mods, at)
            Loop(sc, ActUp(g, ClassifyKey(key)))
        Case ScribblerQuit
            CloseDown(sc)
        Case Else
            Loop(sc, g)

Def Main()
    Let sc0 = ScribblerOpen(gameW, gameH)
    Let sc1 = ScribblerTitle(sc0, "Shoddy Invaders")
    Let sc2 = SetFps(sc1, 30)
    Play(1, "T140 O4 L16 C E G > C8")
    Print("Shoddy Invaders - Left/Right move, Space fires, Q quits")
    Let g = NewGame()
    Let done = Loop(Draw(sc2, g), g)
    Print("game over")
