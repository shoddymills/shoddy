{
  "$schema": "https://shoddymills.github.io/shoddy/schemas/mill.manifest.json",
  "name": "mungo-caverns",
  "version": "1.0",
  "core": "mungo-caverns-core.shoddy",
  "shell": "mungo-caverns.shoddy",
  "modes": [
    "T"
  ],
  "machines": [
    "seq",
    "str"
  ],
  "capabilities": {
    "terminal": true,
    "file": {
      "optional": true,
      "read": [
        "*"
      ],
      "write": [
        "*"
      ]
    }
  },
  "assets": [],
  "goldens": [
    "test.shoddy"
  ]
}
