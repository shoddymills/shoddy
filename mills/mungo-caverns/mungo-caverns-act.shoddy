Rem ===================================================================
Rem mungo-caverns-act.shoddy -- the smaller verbs.
Rem 
Rem Eat, drink, read, listen, wave, blow, and the
Rem sixteen verbs that do nothing but speak their own message.
Rem ===================================================================

Rem ---- the smaller verbs ---------------------------------------------------------
Rem Each of these is a handful of lines. They
Rem matter because between them they account for most of what a player
Rem actually types.

Rem Eating the food works; eating the livestock does
Rem not, and the game has a separate opinion about each attempt.
Def DoEat(g As Game, want As Number, msg As String) As Done
    Let food = ObjNamed("FOOD")
    Select Case want
        Case NoObject()
            If Not Here(g, food) Then
                Done(g, GoUnknown())
            Else
                Done(Destroy(VoicedId(g, msgThanksDelicious), food), GoClearObj())
        Case food
            Done(Destroy(VoicedId(g, msgThanksDelicious), food), GoClearObj())
        Case Else
            If IsLivestock(want) Then
                Done(VoicedId(g, msgLostAppetite), GoClearObj())
            Else
                Done(Voiced(g, msg), GoClearObj())

Def IsLivestock(i As Number) As Boolean
    Contains({ ObjNamed("BIRD"), ObjNamed("SNAKE"), ObjNamed("CLAM"),
               ObjNamed("OYSTER"), ObjNamed("CURMUDGEON"), ObjNamed("DRAGON"),
               ObjNamed("TROLL"), ObjNamed("BEAR"), ObjNamed("OGRE") }, i)

Rem Rubbing the lit urn is the one time it is worth
Rem doing; everything else earns a shrug.
Def DoRub(g As Game, want As Number, msg As String) As Done
    Let urn = ObjNamed("URN")
    If want = urn And PropOf(g, urn) = 2 Then
        Let amber = ObjNamed("AMBER")
        Let g1 = Destroy(g, urn)
        Let g2 = Put(g1, amber)
        Let g3 = With(g2, Props = SetNth(Props(g2), amber + 1, 1), Tally = Tally(g2) - 1)
        Done(Put(VoicedId(g3, msgUrnGenies), ObjNamed("CAVITY")), GoClearObj())
    Else
        If want <> Lamp() Then
            Done(VoicedId(g, msgPeculiarNothing), GoClearObj())
        Else
            Done(Voiced(g, msg), GoClearObj())

Def DoScore(g As Game) As Done
    Let gs = VoicedArgs(g, msgGarneredPoints, { Str(ScoreOf(g)), Str(MaxScore()),
                                                 Str(Turns(g)), Str(Turns(g)) })
    Done(gs, GoClearObj())

Rem Disturbing the curmudgeons in the repository is the
Rem last mistake anyone gets to make: they wake, and the game ends on
Rem endgame scoring.
Def CurmudgeonWake(g As Game) As Done
    Done(With(VoicedId(g, msgCurmudgeonsAwaken), Outcome = Won()), GoClearObj())

Rem Break: the mirror is out of reach until the
Rem repository, where breaking it wakes the curmudgeons; the vase is the
Rem only other thing fragile enough to answer.
Def DoBreak(g As Game, want As Number, msg As String) As Done
    If want = ObjNamed("MIRROR") Then
        If Closed(g) Then
            CurmudgeonWake(StateChange(g, ObjNamed("MIRROR"), 1))
        Else
            Done(VoicedId(g, msgTooFar), GoClearObj())
    Else
        If want = ObjNamed("VASE") And PropOf(g, ObjNamed("VASE")) = 0 Then
            BreakVase(g)
        Else
            Done(Voiced(g, msg), GoClearObj())

Def BreakVase(g As Game) As Done
    Let vase = ObjNamed("VASE")
    Let g1 = DroppedIfHeld(g, vase)
    Let g2 = StateChange(g1, vase, 2)
    Done(SetStuck(g2, vase, True), GoClearObj())

Rem Wake: only worth anything as a way to lose.
Def DoWake(g As Game, want As Number, msg As String) As Done
    If want = ObjNamed("CURMUDGEON") And Closed(g) Then
        CurmudgeonWake(VoicedId(g, msgProdCurmudgeon))
    Else
        Done(Voiced(g, msg), GoClearObj())

Rem Blasting needs the dynamite rod, found and in the
Rem closed cave; where the rod is when it goes off decides how you fare.
Def DoBlast(g As Game) As Done
    Let rod2 = ObjNamed("ROD2")
    Select Case True
        Case IsHidden(g, rod2) Or Not Closed(g)
            Done(VoicedId(g, msgRequiresDynamite), GoClearObj())
        Case Here(g, rod2)
            Done(With(VoicedId(g, msgSplatterMessage), Bonus = 1, Outcome = Won()), GoClearObj())
        Case Location(g) = LocNamed("LOC_NE")
            Done(With(VoicedId(g, msgDefeatMessage), Bonus = 2, Outcome = Won()), GoClearObj())
        Case Else
            Done(With(VoicedId(g, msgVictoryMessage), Bonus = 3, Outcome = Won()), GoClearObj())

Rem Fly. Snide remarks unless the hovering rug is
Rem here; boarding it whisks you across the chasm and back.
Def DoFly(g As Game, want As Number, msg As String) As Done
    Let rug = ObjNamed("RUG")
    Select Case True
        Case want = NoObject() And Not Here(g, rug)
            Done(VoicedId(g, msgFlapArms), GoClearObj())
        Case want = NoObject() And PropOf(g, rug) <> 2
            Done(VoicedId(g, msgRugNothing2), GoClearObj())
        Case want <> NoObject() And want <> rug
            Done(Voiced(g, msg), GoClearObj())
        Case PropOf(g, rug) <> 2
            Done(VoicedId(g, msgRugNothing1), GoClearObj())
        Case Else
            RideRug(g)

Def RideRug(g As Game) As Done
    Let cliff = LocNamed("LOC_CLIFF")
    Let ledge = LocNamed("LOC_LEDGE")
    If Location(g) <> cliff And Location(g) <> ledge Then
        Done(VoicedId(g, msgNothingHappens), GoMove())
    Else
        Done(With(VoicedId(g, RugRideWord(g, ledge)), LocationBeforeLast = PreviousLocation(g), PreviousLocation = Location(g),
                     Location = cliff + ledge - Location(g)), GoMove())

Def RugRideWord(g As Game, ledge As Number) As Number
    Select Case Location(g)
        Case ledge
            msgRugReturns
        Case Else
            msgRugGoes

Rem Finding something you are already holding, or that
Rem is right in front of you, gets a wry answer.
Def DoFind(g As Game, want As Number, msg As String) As Done
    Select Case True
        Case Toting(g, want)
            Done(VoicedId(g, msgAlreadyCarrying), GoClearObj())
        Case Closed(g)
            Done(VoicedId(g, msgNeededNearby), GoClearObj())
        Case FindsIt(g, want)
            Done(VoicedId(g, msgYouHaveit), GoClearObj())
        Case Else
            Done(Voiced(g, msg), GoClearObj())

Def FindsIt(g As Game, want As Number) As Boolean
    (At(g, want)
     Or (Liquid(g) = want And At(g, ObjNamed("BOTTLE")))
     Or (want = LiqLoc(g) And want <> NoObject())
     Or (want = ObjNamed("CURMUDGEON") And CurmudgeonsHere(g) > 0))

Rem Brief mode: stop volunteering the long room text.
Def DoBrief(g As Game) As Done
    Done(With(VoicedId(g, msgBriefConfirm), AbbrevInterval = 10000, Detail = 3), GoClearObj())

Rem Feeding is mostly a way of finding out what will
Rem not eat, but the snake will take the bird, and the curmudgeons take
Rem offence at being offered anything at all.
Def DoFeed(g As Game, want As Number, msg As String) As Done
    Let bird = ObjNamed("BIRD")
    Let snake = ObjNamed("SNAKE")
    Select Case True
        Case want = bird
            Done(VoicedId(g, msgBirdPining), GoClearObj())
        Case want = snake And Here(g, bird)
            Done(Destroy(VoicedId(g, msgBirdDevoured), bird), GoClearObj())
        Case want = ObjNamed("TROLL")
            Done(VoicedId(g, msgTrollVices), GoClearObj())
        Case Else
            FedOthers(g, want, msg)

Rem Each creature refuses in its own way, and only the
Rem bear is actually interested -- feeding it the food is what tames it
Rem and frees the axe.
Def FedOthers(g As Game, want As Number, msg As String) As Done
    Let food = ObjNamed("FOOD")
    Select Case want
        Case ObjNamed("CURMUDGEON")
            If Here(g, food) Then
                Done(With(VoicedId(g, msgReallyMad), CurmudgeonActivation = CurmudgeonActivation(g) + 2), GoClearObj())
            Else
                Done(Voiced(g, msg), GoClearObj())
        Case ObjNamed("DRAGON")
            Done(VoicedId(g, DragonReply(g)), GoClearObj())
        Case ObjNamed("BEAR")
            FedBear(g, want, msg, food)
        Case ObjNamed("OGRE")
            If Here(g, food) Then
                Done(VoicedId(g, msgOgreFull), GoClearObj())
            Else
                Done(Voiced(g, msg), GoClearObj())
        Case ObjNamed("SNAKE")
            Done(VoicedId(g, msgNothingEdible), GoClearObj())
        Case Else
            Done(VoicedId(g, msgAmGame), GoClearObj())

Def DragonReply(g As Game) As Number
    If PropOf(g, ObjNamed("DRAGON")) <> 0 Then
        msgRidiculousAttempt
    Else
        msgNothingEdible


Def FedBear(g As Game, bear As Number, msg As String, food As Number) As Done
    Select Case True
        Case PropOf(g, bear) = 3
            Done(VoicedId(g, msgRidiculousAttempt), GoClearObj())
        Case PropOf(g, bear) <> 0
            Done(Voiced(g, msg), GoClearObj())
        Case Not Here(g, food)
            Done(VoicedId(g, msgNothingEdible), GoClearObj())
        Case Else
            Let g1 = Destroy(g, food)
            Let axe = ObjNamed("AXE")
            Let g2 = SetStuck(With(g1, Props = SetNth(Props(g1), axe + 1, 0)), axe, False)
            Done(StateChange(g2, bear, 1), GoClearObj())

Rem Reading needs light and something written on.
Rem A bare "read" never reaches the read handler at all: the intransitive
Rem branch hands back GO_UNKNOWN first, so the game asks "Read what?" rather
Rem than complaining it cannot see a thing called read. The darkness only
Rem matters once you have named something to read.
Rem Bare "read" looks round for something to read: one
Rem readable thing to hand and it reads that, nothing or several and it asks
Rem which. So the rod with the rusty star answers for itself.
Def Readable(g As Game, i As Number) As Boolean
    (Here(g, i) And Not IsEmpty(Texts(ObjAt(i))) And Not IsHidden(g, i))

Def ReadTarget(g As Game, i As Number, n As Number, found As Number) As Number
    If i > n Then
        found
    Else
        ReadTarget2(g, i, n, found)

Def ReadTarget2(g As Game, i As Number, n As Number, found As Number) As Number
    If Readable(g, i) Then
        If found = NoObject() Then
            ReadTarget(g, i + 1, n, i)
        Else
            Rem two things to read is as good as none: it asks which
            NoObject()
    Else
        ReadTarget(g, i + 1, n, found)

Def DoRead(g As Game, want As Number, msg As String, raw As String) As Done
    If want = NoObject() Then
        ReadAround(g, msg, raw)
    Else
        DoRead2(g, want, msg, raw)

Def ReadAround(g As Game, msg As String, raw As String) As Done
    Rem nothing is legible in a pitch-dark room, so there is nothing for the
    Rem search to settle on and the game asks which thing you meant
    Let t = ReadTargetLit(g)
    If t = NoObject() Then
        Done(g, GoUnknown())
    Else
        DoRead2(g, t, msg, raw)

Def DoRead2(g As Game, want As Number, msg As String, raw As String) As Done
    Let o = ObjAt(want)
    Select Case True
        Case IsDarkHere(g)
            Done(Voiced(g, Render(Nth(messages, msgNoSee + 1), { raw })), GoClearObj())
        Case want = ObjNamed("OYSTER")
            ReadOyster(g, msg)
        Case IsEmpty(Texts(o)) Or IsHidden(g, want)
            Done(Voiced(g, msg), GoClearObj())
        Case Else
            Rem SpeakFlat("") prints nothing; the text stands alone.
            Done(Voiced(g, TextOf(g, o, want)), GoClearObj())

Rem The oyster's engraving is the endgame clue, and
Rem reading it costs ten points -- once agreed to, it stays bought.
Def ReadOyster(g As Game, msg As String) As Done
    Select Case True
        Case Not Toting(g, ObjNamed("OYSTER")) Or Not Closed(g)
            Done(VoicedId(g, msgDontUnderstand), GoClearObj())
        Case Not ReadEndgameClue(g)
            Let took = YesNo(Nth(messages, msgClueQuery + 1),
                             Nth(messages, msgWayoutClue + 1),
                             Nth(messages, msgOkMan + 1))
            Done(With(g, ReadEndgameClue = took), GoClearObj())
        Case Else
            Done(Voiced(g, Nth(Sounds(ObjAt(ObjNamed("OYSTER"))), 2)), GoClearObj())

Def TextOf(g As Game, o As Obj, want As Number) As String
    Let p = PropOf(g, want)
    If p >= 0 And p < Length(Texts(o)) Then
        Nth(Texts(o), p + 1)
    Else
        First(Texts(o))

Rem Listening reports the room's own noise and then
Rem anything here that has something to say. The bird is special: once
Rem you have drunk the dragon's blood you understand it, which is a whole
Rem second set of sounds three states along -- and its last remark is the
Rem one after which it is gone.
Def DoListen(g As Game) As Done
    Let g1 = RoomNoise(g)
    Let roomSpoke = Noise(RoomAt(g)) >= 0
    Let t = ListenAll(g1, 1, Length(objects) - 1, roomSpoke)
    If Not Heard(t) Then
        Done(VoicedId(LState(t), msgAllSilent), GoClearObj())
    Else
        Done(LState(t), GoClearObj())

Type Listened
    LState As Game
    Heard  As Boolean

Def RoomNoise(g As Game) As Game
    If Noise(RoomAt(g)) < 0 Then
        g
    Else
        VoicedId(g, Noise(RoomAt(g)))

Def ListenAll(g As Game, i As Number, n As Number, heard As Boolean) As Listened
    If i > n Then
        Listened(g, heard)
    Else
        Let o = ObjAt(i)
        If Not Here(g, i) Or IsEmpty(Sounds(o)) Or IsHidden(g, i) Then
            ListenAll(g, i + 1, n, heard)
        Else
            Let mi = SoundState(g, i)
            ListenAll(Silenced(Voiced(g, SoundOf(g, o, mi)), i, mi), i + 1, n, True)

Def SoundState(g As Game, i As Number) As Number
    If i = ObjNamed("BIRD") And Blooded(g) Then
        PropOf(g, i) + 3
    Else
        PropOf(g, i)

Def SoundOf(g As Game, o As Obj, mi As Number) As String
    If mi >= 0 And mi < Length(Sounds(o)) Then
        Replace(Nth(Sounds(o), mi + 1), "%s", MagicWord(g))
    Else
        First(Sounds(o))

Rem The bird's last word is its farewell.
Def Silenced(g As Game, i As Number, mi As Number) As Game
    If i = ObjNamed("BIRD") And mi = Length(Sounds(ObjAt(i))) - 1 Then
        Destroy(g, i)
    Else
        g

Rem Throwing is dropping, unless it is the axe, and
Rem then it is attacking -- the only way to actually kill a curmudgeon. A
Rem treasure thrown at the troll buys passage.
Def DoThrow(g As Game, obj As Number, msg As String) As Done
    Let troll = ObjNamed("TROLL")
    Select Case True
        Case Not Toting(g, obj)
            Done(Voiced(g, msg), GoClearObj())
        Case Treasure(ObjAt(obj)) And At(g, troll)
            Done(PaidTheToll(VoicedId(g, msgTrollSatisfied), obj, troll), GoClearObj())
        Case obj = ObjNamed("FOOD") And Here(g, ObjNamed("BEAR"))
            DoFeed(g, ObjNamed("BEAR"), msg)
        Case obj <> ObjNamed("AXE")
            DoDrop(g, obj, msg)
        Case Else
            ThrowAxe(g, msg)

Def PaidTheToll(g As Game, obj As Number, troll As Number) As Game
    Let troll2 = ObjNamed("TROLL2")
    Let ps = Places(ObjAt(troll))
    Let g1 = Destroy(g, obj)
    Let g2 = Destroy(g1, troll)
    Let g3 = Relocated(g2, troll2, First(ps))
    Juggled(PlaceSecond(g3, troll2, ps), ObjNamed("CHASM"))

Rem A curmudgeon in the room is a target; otherwise the axe lands wherever it
Rem was going to land and the usual attack applies.
Def ThrowAxe(g As Game, msg As String) As Done
    If CurmudgeonsHere(g) <= 0 Then
        ThrowAxeAtBeast(g, msg)
    Else
        Let missed = RollOf(g, NCurmudgeons() + 1) < CurmudgeonActivation(g)
        Let g1 = Stepped(g)
        Rem throw_support drops the axe and hands back
        Rem GO_MOVE, a null motion whose only job is to describe the room
        Rem again -- so after the smoke clears you see where you are and the
        Rem axe lying where it fell.
        If missed Then
            Done(Landed(VoicedId(g1, msgCurmudgeonDodges)), GoMove())
        Else
            Done(Landed(Slain(With(VoicedId(g1, KillMessage(g1)), CurmudgeonsKilled = CurmudgeonsKilled(g1) + 1))), GoMove())

Def KillMessage(g As Game) As Number
    If CurmudgeonsKilled(g) = 0 Then
        msgCurmudgeonSmoke
    Else
        msgKilledCurmudgeon

Rem With no curmudgeon about, the axe finds the dragon,
Rem the troll, the ogre or the bear before anything else does.
Def ThrowAxeAtBeast(g As Game, msg As String) As Done
    Select Case True
        Case At(g, ObjNamed("DRAGON")) And PropOf(g, ObjNamed("DRAGON")) = 0
            Done(Landed(VoicedId(g, msgDragonScales)), GoMove())
        Case At(g, ObjNamed("TROLL"))
            Done(Landed(VoicedId(g, msgTrollReturns)), GoMove())
        Case At(g, ObjNamed("OGRE"))
            Done(Landed(VoicedId(g, msgOgreDodge)), GoMove())
        Case Here(g, ObjNamed("BEAR")) And PropOf(g, ObjNamed("BEAR")) = 0
            AxeAtBear(g)
        Case Else
            DoAttack(g, NoObject(), True, msg)

Rem This'll teach him to throw the axe at the bear:
Rem it lands out of reach until the bear is dealt with.
Def AxeAtBear(g As Game) As Done
    Let axe = ObjNamed("AXE")
    Let g1 = SetStuck(Put(g, axe), axe, True)
    Let g2 = Juggled(g1, ObjNamed("BEAR"))
    Done(StateChange(g2, axe, 1), GoClearObj())

Def Slain(g As Game) As Game
    SlayFirst(g, 1, NCurmudgeons() - 1)

Def SlayFirst(g As Game, i As Number, n As Number) As Game
    If i > n Then
        g
    Else
        Let d = Nth(Curmudgeons(g), i)
        If DLoc(d) = Location(g) Then
            With(g, Curmudgeons = SetNth(Curmudgeons(g), i, With(d, DLoc = 0, DSeen = False)))
        Else
            SlayFirst(g, i + 1, n)

Rem However the throw turns out, the axe ends up on
Rem the floor here.
Def Landed(g As Game) As Game
    Let axe = ObjNamed("AXE")
    If Toting(g, axe) Then
        Put(g, axe)
    Else
        g

Rem Thirteen verbs whose transitive case is nothing but
Rem speak(actions[verb].message) -- their handlers live only on the
Rem intransitive side.
Def ReadTargetLit(g As Game) As Number
    If IsDarkHere(g) Then
        NoObject()
    Else
        ReadTarget(g, 1, Length(objects) - 1, NoObject())
