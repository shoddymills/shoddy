Rem ===================================================================
Rem mungo-caverns-locations.shoddy -- the cave itself. Hand-edited source.
Rem Graded against the C original's recorded games; see tests/README.
Rem
Rem 185 locations, in declaration order, LOC_NOWHERE first.
Rem Conds carries the condition flags by name rather than packed into
Rem a bitmask, which there is no reason to do.
Rem Noise indexes messages, -1 when the room is silent.
Rem ===================================================================

Type Room
    Tag   As String
    Long  As String
    Short As String
    Conds As List
    Noise As Number
    Loud  As Boolean
    RoomHints As List

Let locations = {
      Rem 0  LOC_NOWHERE  
      Room("LOC_NOWHERE",
          "",
          "",
          { },
          -1, False, { }),

      Rem 1  LOC_START  FLUID ABOVE LIT
      Room("LOC_START",
              "You are standing at the end of a road before a small brick building.\n"
            & "Around you is a forest.  A small stream flows out of the building and\n"
            & "down a gully.",
          "You're in front of building.",
          { "FLUID", "ABOVE", "LIT" },
          172, False, { }),

      Rem 2  LOC_HILL  ABOVE LIT
