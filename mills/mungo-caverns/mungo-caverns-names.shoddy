Rem ===================================================================
Rem mungo-caverns-names.shoddy -- names to indexes.
Rem
Rem Objects, rooms, motions and verbs are addressed by small integer.
Rem This port keeps the names on the table
Rem rows and looks the index up, which reads better and costs a scan --
Rem so the four tag lists are lifted off the tables once, at load.
Rem
Rem Namespaced As Name, unlike the tables themselves: those stay flat
Rem because Tag is declared by Room, Obj, Vocab and Hint alike and one
Rem word serving all four is the point. Nothing here is shared that way --
Rem these are the lookups, which are rules about the data rather than the
Rem data itself.
Rem ===================================================================

Let ObjNames    = Map(Objects(),   Fn(o) => Tag(o))
Let LocNames    = Map(Locations(), Fn(l) => Tag(l))
Let MotionNames = Map(Motions(),   Fn(m) => Tag(m))
Let ActionNames = Map(Actions(),   Fn(a) => Tag(a))

Def ObjNamed(want As String) As Number
    IndexIn(ObjNames, 1, Length(ObjNames), want) - 1

Def LocNamed(want As String) As Number
    IndexIn(LocNames, 1, Length(LocNames), want) - 1

Def MotionNamed(want As String) As Number
    IndexIn(MotionNames, 1, Length(MotionNames), want) - 1

Def ActionNamed(want As String) As Number
    IndexIn(ActionNames, 1, Length(ActionNames), want) - 1

Rem ---- the three the rules ask about constantly -------------------------
Rem Every lookup above walks its list, and Objects() is seventy long.
Rem The lamp is consulted on the darkness path of every single turn, so
Rem these three resolve once here rather than seventy string compares at
Rem a time. The other lookups are cold enough not to care.
Let LampId  = ObjNamed("LAMP")
Let GrateId = ObjNamed("GRATE")
Let KeysId  = ObjNamed("KEYS")

Def Lamp() As Number
    LampId

Def Grate() As Number
    GrateId

Def Keys() As Number
    KeysId
