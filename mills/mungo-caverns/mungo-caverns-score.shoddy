Rem ===================================================================
Rem mungo-caverns-score.shoddy -- counting what you achieved.
Rem 
Rem Treasures seen, treasures brought home, deaths
Rem survived, and the rank those add up to.
Rem ===================================================================

Rem ---- scoring ---------------------------------------------------------------
Rem Only the parts a short game can reach are live; the
Rem endgame bonuses stay at zero until the closing sequence exists.

Def ChestIndex() As Number
    ObjNamed("CHEST")

Def TreasureValue(i As Number) As Number
    Select Case i
        Case ChestIndex()
            14
        Case > ChestIndex()
            16
        Case Else
            12

Def CountsForScore(o As Obj) As Boolean
    Treasure(o) And Len(Inventory(o)) > 0

Def ScoresAsTreasure(i As Number) As Boolean
    CountsForScore(ObjAt(i))

Def MaxTreasure() As Number
    Range(1, Length(Objects()) - 1)
        Filter(ScoresAsTreasure)
        Map(TreasureValue)
        Fold(0, +)

Def NDeaths() As Number
    3

Def MaxScore() As Number
    MaxTreasure() + NDeaths() * 10 + 4 + 25 + 25 + 45 + 1 + 2

Rem Two points for having laid eyes on a treasure, and the
Rem rest of its value only once it is safely back in the well house.
Def TreasureScore(g As Game) As Number
    Range(1, Length(Objects()) - 1)
        Filter(Fn(i) => IsTreasure(ObjAt(i)))
        Map(Fn(i) => TreasurePoints(g, i))
        Fold(0, +)

Def TreasurePoints(g As Game, i As Number) As Number
    If IsHidden(g, i) Then
        Rem never seen, so not even the consolation two
        0
    Else
        If (Nth(ObjectLocation(g), i + 1) = LocNamed("LOC_BUILDING")
            And PropOf(g, i) = 0) Then
            TreasureValue(i)
        Else
            2

Rem A quit or an EOF is mode quitgame, which forfeits the four points for
Rem seeing it through.
Rem Four points for having played it out to a finish
Rem rather than walking away, which is what quitting and running out of
Rem input both are.
Def SawItThrough(g As Game) As Number
    Select Case Outcome(g)
        Case Died(m)
            4
        Case Won
            4
        Case Else
            0

Rem Every hint you took comes off the total.
Def HintPenalty(g As Game) As Number
    Range(1, Length(Hints()))
        Filter(Fn(i) => Used(HintAt(g, i)))
        Map(Fn(i) => Penalty(Nth(Hints(), i)))
        Fold(0, +)

Def ScoreOf(g As Game) As Number
    Let hinted = HintPenalty(g)
    Let loot = TreasureScore(g)
    Let survived = (NDeaths() - Deaths(g)) * 10
    Let deep = DeepBonus(g)
    Let finished = SawItThrough(g)
    Rem suspending costs five points a time, so you cannot
    Rem win by saving before a fight and reloading until it goes your way.
    If Novice(g) Then
        (loot + survived + deep + finished + ClosingScore(g) + WittPoint(g)
         + 2 - 5 - TurnPenalty(g) - hinted - SavePenalty(g) - CluePenalty(g))
    Else
        (loot + survived + deep + finished + ClosingScore(g) + WittPoint(g)
         + 2 - TurnPenalty(g) - hinted - SavePenalty(g) - CluePenalty(g))

Rem The endgame clue costs ten points if taken.
Def CluePenalty(g As Game) As Number
    If ReadEndgameClue(g) Then
        10
    Else
        0

Rem Reaching closing is worth 25; how the closed cave was
Rem left decides the rest -- a mundane end 10, blowing yourself up 25,
Rem blasting at the wrong end 30, the true victory 45.
Def ClosingScore(g As Game) As Number
    ClosingPoints(g) + ClosedPoints(g)

Def ClosingPoints(g As Game) As Number
    If ClosingTime(g) Then
        25
    Else
        0

Def ClosedPoints(g As Game) As Number
    If Not Closed(g) Then
        0
    Else
        Select Case Bonus(g)
            Case 1
                25
            Case 2
                30
            Case 3
                45
            Case Else
                10

Rem One point for having come to Witt's End as you should.
Def WittPoint(g As Game) As Number
    If Nth(ObjectLocation(g), ObjNamed("MAGAZINE") + 1) = LocNamed("LOC_WITTSEND") Then
        1
    Else
        0

Def DeepBonus(g As Game) As Number
    If CurmudgeonActivation(g) <> 0 Then
        25
    Else
        0

Rem The classes are walked from one, and the first whose
Rem threshold still covers the score is the rating earned.
Rem
Rem This module returns what it has to say rather than printing it -- see
Rem the note on Voice in mungo-caverns-say.shoddy.
Def RateFrom(points As Number, i As Number, n As Number) As List Of String
    If i > n Then
        VoiceId(MsgOffScale())
    Else
        Let k = Nth(Classes(), i + 1)
        If Threshold(k) >= points Then
            Both(Voice(Message(k)), NextRung(points, k, i, n))
        Else
            RateFrom(points, i + 1, n)

Def NextRung(points As Number, k As Class, i As Number, n As Number) As List Of String
    If i < n Then
        Let nxt = Threshold(k) + 1 - points
        VoiceArgs(MsgNextHigher(), { Str(nxt), Str(nxt) })
    Else
        VoiceId(MsgNoHigher())

Rem Two backhanded compliments, for players who would have
Rem topped the scale but for dawdling or for suspending: both only fire when
Rem the penalty is what kept them off it.
Def Terminate(g As Game) As List Of String
    Let points = ScoreOf(g)
    Both(Both(TookLong(g, points), WithoutSuspends(g, points)),
         Both(VoiceArgs(MsgTotalScore(), { Str(points), Str(MaxScore()),
                                           Str(Turns(g)), Str(Turns(g)) }),
              RateFrom(points, 1, Length(Classes()) - 1)))

Def TookLong(g As Game, points As Number) As List Of String
    If (points + TurnPenalty(g) + 1 >= MaxScore() And TurnPenalty(g) <> 0) Then
        VoiceId(MsgTookLong())
    Else
        Silent()

Def WithoutSuspends(g As Game, points As Number) As List Of String
    If (points + SavePenalty(g) + 1 >= MaxScore() And SavePenalty(g) <> 0) Then
        VoiceId(MsgWithoutSuspends())
    Else
        Silent()

