Rem ===================================================================
Rem mungo-caverns-tables.shoddy -- hints, scoring, endings. Hand-edited source.
Rem The recorded transcripts are the specification.
Rem
Rem 10 hints, 11 score classes, 4 turn thresholds,
Rem 3 obituaries and the 6 curmudgeon starting rooms (the last is the pirate).
Rem ===================================================================

Type Hint
    Tag      As String
    Number   As Number
    Turns    As Number
    Penalty  As Number
    Question As String
    Text     As String

Def Hints() As List Of Hint
    {
      Rem 0  CAVE
      Hint("CAVE", 1, 4, 2,
           "Are you trying to get into the cave?",
           "The grate is very solid and has a hardened steel lock.  You cannot\nenter without a key, and there are no keys nearby.  I would recommend\nlooking elsewhere for the keys."),

      Rem 1  BIRD
      Hint("BIRD", 2, 5, 2,
           "Are you trying to catch the bird?",
           "Something about you seems to be frightening the bird.  Perhaps you\nmight figure out what it is."),

      Rem 2  SNAKE
      Hint("SNAKE", 3, 8, 2,
           "Are you trying to somehow deal with the snake?",
           "You can't kill the snake, or drive it away, or avoid it, or anything\nlike that.  There is a way to get by, but you don't have the necessary\nresources right now."),

      Rem 3  MAZE
      Hint("MAZE", 4, 75, 4,
           "Do you need help getting out of the maze?",
           "You can make the passages look less alike by dropping things."),

      Rem 4  DARK
      Hint("DARK", 5, 25, 5,
           "Are you trying to explore beyond the plover room?",
           "There is a way to explore that region without having to worry about\nfalling into a pit.  None of the objects available is immediately\nuseful in discovering the secret."),

      Rem 5  WITT
      Hint("WITT", 6, 20, 3,
           "Do you need help getting out of here?",
           "Don't go west.\n"),

      Rem 6  CLIFF
      Hint("CLIFF", 7, 8, 2,
           "Are you wondering what to do here?",
           "This section is quite advanced.  Find the cave first.\n"),

      Rem 7  WOODS
      Hint("WOODS", 8, 25, 2,
           "Would you like to be shown out of the forest?",
           "Go east ten times.  If that doesn't get you out, then go south, then\nwest twice, then south."),

      Rem 8  OGRE
      Hint("OGRE", 9, 10, 4,
           "Do you need help dealing with the ogre?",
           "There is nothing the presence of which will prevent you from defeating\nhim; thus it can't hurt to fetch everything you possibly can."),

      Rem 9  JADE
      Hint("JADE", 10, 1, 4,
           "You're missing only one other treasure.  Do you need help finding it?",
           "Once you've found all the other treasures, it is no longer possible to\nlocate the one you're now missing.")

    }

Type Klass
    Threshold As Number
    Message   As String

Def Classes() As List
    {
      Klass(0, ""),
      Klass(45, "You are obviously a rank amateur.  Better luck next time."),
      Klass(120, "Your score qualifies you as a novice class adventurer."),
      Klass(170, "You have achieved the rating: \"Experienced Adventurer\"."),
      Klass(250, "You may now consider yourself a \"Seasoned Adventurer\"."),
      Klass(320, "You have reached \"Junior Master\" status."),
      Klass(375, "Your score puts you in Master Adventurer Class C."),
      Klass(410, "Your score puts you in Master Adventurer Class B."),
      Klass(426, "Your score puts you in Master Adventurer Class A."),
      Klass(429, "All of Adventuredom gives tribute to you, Adventurer Grandmaster!"),
      Klass(9999, "Adventuredom stands in awe -- you have now joined the ranks of the\n       W O R L D   C H A M P I O N   A D V E N T U R E R S !\nIt may interest you to know that the Dungeon-Master himself has, to\nmy knowledge, never achieved this threshold in fewer than 330 turns.")
    }

Type Thresh
    Threshold As Number
    PointLoss As Number
    Message   As String

Def TurnThresholds() As List
    {
      Thresh(350, 2, "Tsk!  A wizard wouldn't have to take 350 turns.  This is going to cost\nyou a couple of points."),
      Thresh(500, 3, "500 turns?  That's another few points you've lost."),
      Thresh(1000, 5, "Are you still at it?  Five points off for exceeding 1000 turns!"),
      Thresh(2500, 10, "Good grief, don't you *EVER* give up?  Do you realize you've spent\nover 2500 turns at this?  That's another ten points off, a total of\ntwenty points lost for taking so long.")
    }

Type Obit
    Query As String
    Yes   As String

Def Obituaries() As List
    {
      Obit("Oh dear, you seem to have gotten yourself killed.  I might be able to\nhelp you out, but I've never really done this before.  Do you want me\nto try to reincarnate you?", "All right.  But don't blame me if something goes wr......\n                    --- POOF!! ---\nYou are engulfed in a cloud of orange smoke.  Coughing and gasping,\nyou emerge from the smoke and find...."),
      Obit("You clumsy oaf, you've done it again!  I don't know how long I can\nkeep this up.  Do you want me to try reincarnating you again?", "Okay, now where did I put my orange smoke?....  >POOF!<\nEverything disappears in a dense cloud of orange smoke."),
      Obit("Now you've really done it!  I'm out of orange smoke!  You don't expect\nme to do a decent reincarnation without any orange smoke, do you?", "Okay, if you're so smart, do it yourself!  I'm leaving!")
    }

Rem Curmudgeon starting rooms; the sixth is the pirate's.
Def CurmudgeonLocs() As List
    { 19, 27, 33, 44, 64, 114 }

