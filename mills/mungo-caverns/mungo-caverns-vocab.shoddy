Def Actions() As List Of Vocab
    {
      Rem 0  ACT_NULL
      Vocab("ACT_NULL", { },
            True, False,
            "", False, False, False),

      Rem 1  CARRY
      Vocab("CARRY", { "g", "carry", "take", "keep", "catch", "steal", "captu", "get", "tote", "snarf" },
            False, False,
            "You are already carrying it!", False, False, False),

      Rem 2  DROP
      Vocab("DROP", { "drop", "relea", "free", "disca", "dump" },
            True, False,
            "You aren't carrying it!", False, False, True),

      Rem 3  SAY
      Vocab("SAY", { "say", "chant", "sing", "utter", "mumbl" },
            True, False,
            "NO_MESSAGE", False, False, True),

      Rem 4  UNLOCK
      Vocab("UNLOCK", { "unloc", "open" },
            True, False,
            "I don't know how to lock or unlock such a thing.", False, False, False),

      Rem 5  NOTHING
      Vocab("NOTHING", { "z", "nothi" },
            False, False,
            "NO_MESSAGE", False, False, False),

      Rem 6  LOCK
      Vocab("LOCK", { "lock", "close" },
            True, False,
            "I don't know how to lock or unlock such a thing.", False, False, False),

      Rem 7  LIGHT
      Vocab("LIGHT", { "light", "on" },
            True, False,
            "I'm afraid I don't understand.", False, False, False),

      Rem 8  EXTINGUISH
      Vocab("EXTINGUISH", { "extin", "off" },
            True, False,
            "I'm afraid I don't understand.", False, False, False),

      Rem 9  WAVE
      Vocab("WAVE", { "wave", "shake", "swing" },
            True, False,
            "Nothing happens.", False, False, True),

      Rem 10  TAME
      Vocab("TAME", { "calm", "placa", "tame" },
            True, False,
            "I'm game.  Would you care to explain how?", False, True, True),

      Rem 11  GO
      Vocab("GO", { "walk", "run", "trave", "go", "proce", "conti", "explo", "follo", "turn" },
            True, False,
            "Where?", False, True, False),

      Rem 12  ATTACK
      Vocab("ATTACK", { "attac", "kill", "fight", "hit", "strik", "slay" },
            True, False,
            "Don't be ridiculous!", False, False, False),

      Rem 13  POUR
      Vocab("POUR", { "pour" },
            True, False,
            "You aren't carrying it!", False, False, False),

      Rem 14  EAT
      Vocab("EAT", { "eat", "devou" },
            True, False,
            "Don't be ridiculous!", False, False, False),

      Rem 15  DRINK
      Vocab("DRINK", { "drink" },
            True, False,
            "You have taken a drink from the stream.  The water tastes strongly of\nminerals, but is not unpleasant.  It is extremely cold.", False, False, False),

      Rem 16  RUB
      Vocab("RUB", { "rub" },
            True, False,
            "Rubbing the electric lamp is not particularly rewarding.  Anyway,\nnothing exciting happens.", False, False, True),

      Rem 17  THROW
      Vocab("THROW", { "throw", "toss" },
            True, False,
            "You aren't carrying it!", False, False, True),

      Rem 18  QUIT
      Vocab("QUIT", { "quit" },
            True, False,
            "Huh?", False, True, False),

      Rem 19  FIND
      Vocab("FIND", { "find", "where" },
            True, False,
            "I can only tell you what you see as you move about and manipulate\nthings.  I cannot tell you where remote things are.", False, False, True),

      Rem 20  INVENTORY
      Vocab("INVENTORY", { "i", "inven" },
            False, False,
            "I can only tell you what you see as you move about and manipulate\nthings.  I cannot tell you where remote things are.", False, False, False),

      Rem 21  FEED
      Vocab("FEED", { "feed" },
            True, False,
            "There is nothing here to eat.", False, False, True),

      Rem 22  FILL
      Vocab("FILL", { "fill" },
            True, False,
            "You can't fill that.", False, False, False),

      Rem 23  BLAST
      Vocab("BLAST", { "blast", "deton", "ignit", "blowu" },
            True, False,
            "Blasting requires dynamite.", False, False, False),

      Rem 24  SCORE
      Vocab("SCORE", { "score" },
            True, False,
            "Huh?", False, True, False),

      Rem 25  FEE
      Vocab("FEE", { "fee" },
            True, False,
            "I don't know how.", True, True, False),

      Rem 26  FIE
      Vocab("FIE", { "fie" },
            True, False,
            "I don't know how.", True, True, False),

      Rem 27  FOE
      Vocab("FOE", { "foe" },
            True, False,
            "I don't know how.", True, True, False),

      Rem 28  FOO
      Vocab("FOO", { "foo" },
            True, False,
            "I don't know how.", True, True, False),

      Rem 29  FUM
      Vocab("FUM", { "fum" },
            True, False,
            "I don't know how.", True, True, False),

      Rem 30  BRIEF
      Vocab("BRIEF", { "brief" },
            True, False,
            "On what?", False, True, False),

      Rem 31  READ
      Vocab("READ", { "read", "perus" },
            True, False,
            "I'm afraid I don't understand.", False, False, False),

      Rem 32  BREAK
      Vocab("BREAK", { "break", "shatt", "smash" },
            True, False,
            "It is beyond your power to do that.", False, False, True),

      Rem 33  WAKE
      Vocab("WAKE", { "wake", "distu" },
            True, False,
            "Don't be ridiculous!", False, False, True),

      Rem 34  SAVE
      Vocab("SAVE", { "suspe", "pause", "save" },
            True, False,
            "Huh?", False, True, False),

      Rem 35  RESUME
      Vocab("RESUME", { "resum", "resta" },
            True, False,
            "Huh?", False, True, False),

      Rem 36  FLY
      Vocab("FLY", { "fly" },
            True, False,
            "I'm game.  Would you care to explain how?", False, False, False),

      Rem 37  LISTEN
      Vocab("LISTEN", { "liste" },
            True, False,
            "I'm afraid I don't understand.", False, True, False),

      Rem 38  PART
      Vocab("PART", { "z'zzz" },
            True, False,
            "Nothing happens.", False, False, False),

      Rem 39  SEED
      Vocab("SEED", { "seed" },
            True, False,
            "Seed set to %d", False, False, False),

      Rem 40  WASTE
      Vocab("WASTE", { "waste" },
            True, False,
            "Game limit is now %d", False, False, False),

      Rem 41  ACT_UNKNOWN
      Vocab("ACT_UNKNOWN", { },
            True, False,
            "Huh?", False, False, False),

      Rem 42  THANKYOU
      Vocab("THANKYOU", { "thank" },
            True, True,
            "You're quite welcome.", False, False, False),

      Rem 43  INVALIDMAGIC
      Vocab("INVALIDMAGIC", { "sesam", "opens", "abra", "abrac", "shaza", "hocus", "pocus" },
            True, True,
            "Good try, but that is an old worn-out magic word.", False, False, False),

      Rem 44  HELP
      Vocab("HELP", { "help", "?" },
            True, True,
            "I know of places, actions, and things.  Most of my vocabulary\ndescribes places and is used to move you there.  To move, try words\nlike forest, building, downstream, enter, east, west, north, south,\nup, or down.  I know about a few special objects, like a black rod\nhidden in the cave.  These objects can be manipulated using some of\nthe action words that I know.  Usually you will need to give both the\nobject and action words (in either order), but sometimes I can infer\nthe object from the verb alone.  Some objects also imply verbs; in\nparticular, \"inventory\" implies \"take inventory\", which causes me to\ngive you a list of what you're carrying.  Some objects have unexpected\neffects; the effects are not always desirable!  Usually people having\ntrouble moving just need to try a few more words.  Usually people\ntrying unsuccessfully to manipulate an object are attempting something\nbeyond their (or my!) capabilities and should try a completely\ndifferent tack.  One point often confusing to beginners is that, when\nthere are several ways to go in a certain direction (e.g., if there\nare several holes in a wall), choosing that direction in effect\nchooses one of the ways at random; often, though, by specifying the\nplace you want to reach you can guarantee choosing the right path.\nAlso, to speed the game you can sometimes move long distances with a\nsingle word.  For example, \"building\" usually gets you to the building\nfrom anywhere above ground except when lost in the forest.  Also, note\nthat cave passages and forest paths turn a lot, so leaving one place\nheading north doesn't guarantee entering the next from the south.\nHowever (another important point), except when you've used a \"long\ndistance\" word such as \"building\", there is always a way to go back\nwhere you just came from unless I warn you to the contrary, even\nthough the direction that takes you back might not be the reverse of\nwhat got you here.  Good luck, and have fun!", False, False, False),

      Rem 45  NO
      Vocab("NO", { "no" },
            True, True,
            "OK", False, False, False),

      Rem 46  TREE
      Vocab("TREE", { "tree", "trees" },
            True, True,
            "The trees of the forest are large hardwood oak and maple, with an\noccasional grove of pine or spruce.  There is quite a bit of under-\ngrowth, largely birch and ash saplings plus nondescript bushes of\nvarious sorts.  This time of year visibility is quite restricted by\nall the leaves, but travel is quite easy if you detour around the\nspruce and berry bushes.", False, False, False),

      Rem 47  DIG
      Vocab("DIG", { "dig", "excav" },
            True, True,
            "Digging without a shovel is quite impractical.  Even with a shovel\nprogress is unlikely.", False, False, False),

      Rem 48  LOST
      Vocab("LOST", { "lost" },
            True, True,
            "I'm as confused as you are.", False, False, False),

      Rem 49  MIST
      Vocab("MIST", { "mist" },
            True, True,
            "Mist is a white vapor, usually water, seen from time to time in\ncaverns.  It can be found anywhere but is frequently a sign of a deep\npit leading down to water.", False, False, False),

      Rem 50  FBOMB
      Vocab("FBOMB", { "fuck" },
            True, True,
            "Watch it!", False, False, False),

      Rem 51  STOP
      Vocab("STOP", { "stop" },
            True, True,
            "I don't know the word \"stop\".  Use \"quit\" if you want to give up.", False, False, False),

      Rem 52  INFO
      Vocab("INFO", { "info", "infor" },
            True, True,
            "For a summary of the most recent changes to the game, say \"news\".\nIf you want to end your adventure early, say \"quit\".  To suspend your\nadventure such that you can continue later, say \"suspend\" (or \"pause\"\nor \"save\").  To see how well you're doing, say \"score\".  To get full\ncredit for a treasure, you must have left it safely in the building,\nthough you get partial credit just for locating it.  You lose points\nfor getting killed, or for quitting, though the former costs you more.\nThere are also points based on how much (if any) of the cave you've\nmanaged to explore; in particular, there is a large bonus just for\ngetting in (to distinguish the beginners from the rest of the pack),\nand there are other ways to determine whether you've been through some\nof the more harrowing sections.  If you think you've found all the\ntreasures, just keep exploring for a while.  If nothing interesting\nhappens, you haven't found them all yet.  If something interesting\n*DOES* happen (incidentally, there *ARE* ways to hasten things along),\nit means you're getting a bonus and have an opportunity to garner many\nmore points in the Master's section.  I may occasionally offer hints\nif you seem to be having trouble.  If I do, I'll warn you in advance\nhow much it will affect your score to accept the hints.  Finally, to\nsave time, you may specify \"brief\", which tells me never to repeat the\nfull description of a place unless you explicitly ask me to.", False, False, False),

      Rem 53  SWIM
      Vocab("SWIM", { "swim" },
            True, True,
            "I don't know how.", False, False, False),

      Rem 54  WIZARD
      Vocab("WIZARD", { "wizar" },
            True, True,
            "Wizards are not to be disturbed by such as you.", False, False, False),

      Rem 55  YES
      Vocab("YES", { "yes" },
            True, True,
            "Guess again.", False, False, False),

      Rem 56  NEWS
      Vocab("NEWS", { "news" },
            True, True,
            "Open Adventure is an author-approved open-source release of\nVersion 2.5 with, as yet, no gameplay changes.\nVersion 2.5 was essentially the same as Version II; the cave and the\nhazards therein are unchanged, and top score is still 430 points.\nThere are a few more hints, especially for some of the more obscure\npuzzles.  There are a few minor bugfixes and cosmetic changes.  You\ncan now save a game and resume it at once (formerly you had to wait a\nwhile first), but it now costs you a few points each time you save the\ngame.  Saved games are now stored in much smaller files than before.", False, False, False),

      Rem 57  ACT_VERSION
      Vocab("ACT_VERSION", { "versi" },
            True, True,
            "There is a puff of orange smoke; within it, fiery runes spell out:\n\nOpen Adventure %V - http://www.catb.org/esr/open-adventure/", False, False, False)

    }

