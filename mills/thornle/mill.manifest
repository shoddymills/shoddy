{
  "$schema": "https://shoddymills.github.io/shoddy/schemas/mill.manifest.json",
  "name": "thornle",
  "version": "1.0",
  "core": "thornle-core.shoddy",
  "shell": "thornle.shoddy",
  "modes": [
    "T"
  ],
  "machines": [
    "math",
    "seq",
    "str",
    "vt100"
  ],
  "capabilities": {
    "terminal": true,
    "vt100": true,
    "random": true,
    "file": {
      "read": [
        "files/words.txt"
      ]
    }
  },
  "assets": [
    "files/words.txt"
  ],
  "goldens": [
    "test.shoddy"
  ]
}
