<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- Part C's shipped console consumer (C8): the host that discharges
       Part A's Mode T, refusal and instrumented-weave proofs, so Part A
       never builds a throwaway test-only host. ProjectReference and
       relative Import per C7.1 — nothing here requires a published
       package. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows runs the published apphost; everywhere else publish
         drops 'mill' with no extension - same tool, two spellings. -->
    <ShoddyToolPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\bin\mill.exe</ShoddyToolPath>
    <ShoddyToolPath Condition="'$(ShoddyToolPath)' == ''">$(MSBuildThisFileDirectory)../../bin/mill</ShoddyToolPath>
    <!-- Debug builds compile in the Perch attach service; release
         builds provably do not (C6.2, C6.5). -->
    <ShoddyPerchProject>$(MSBuildThisFileDirectory)..\..\src\Shoddy.Perch\Shoddy.Perch.csproj</ShoddyPerchProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pure fixture: hand-built values and the record round trip. -->
    <ShoddyMill Include="..\fixtures\pure" Mode="N" />
    <!-- halifax, both modes: Mode N at engine scale, Mode T through
         RunWovenAsync — folder + manifest, source unread. The grant is
         long on purpose: it is the project's capability statement, and
         default-deny made it explicit (C2.4). -->
    <ShoddyMill Include="..\..\mills\halifax" Mode="N"
                Grant="file;terminal;clock;random;keys;vt100;scribbler;buzzer;net" />
    <ShoddyMill Include="..\..\mills\halifax" Mode="T"
                Grant="file;terminal;clock;random;keys;vt100;scribbler;buzzer;net" />
  </ItemGroup>

  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
