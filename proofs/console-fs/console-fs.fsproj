<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- The F# consumer (C4.1): the same mill through the same API with
       no wrapper assembly — CLS compliance proven by use, not by
       audit. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ShoddyToolPath>$(MSBuildThisFileDirectory)..\..\bin\mill.exe</ShoddyToolPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ShoddyMill Include="..\fixtures\pure" Mode="N" />
  </ItemGroup>

  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
