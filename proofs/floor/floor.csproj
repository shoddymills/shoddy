<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- The dependency floor (C1.3): a capability-free mill's consumer.
       Its built output must contain Shoddy.Runtime, Shoddy.Hosting and
       the woven DLL and NOTHING else — no windowing, no audio, no
       Roslyn, and no toolchain. A test in Shoddy.Tests enumerates this
       project's output and asserts the absences by name; never
       inspected by eye. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
  </ItemGroup>

  <ItemGroup>
    <!-- No Grant: a pure mill needs none, and default-deny means
         silence grants nothing. -->
    <ShoddyMill Include="..\fixtures\pure" Mode="N" />
  </ItemGroup>

  <Import Project="..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
