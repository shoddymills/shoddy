<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- Optional degradation (C8): the required capabilities granted, the
       optional ones not. The build warns per ungranted optional
       capability and proceeds; the program runs with the seams' null
       behaviour — a headless, silent calculator that still counts. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows runs the published apphost; everywhere else publish
         drops 'mill' with no extension - same tool, two spellings. -->
    <ShoddyToolPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\..\bin\mill.exe</ShoddyToolPath>
    <ShoddyToolPath Condition="'$(ShoddyToolPath)' == ''">$(MSBuildThisFileDirectory)../../../bin/mill</ShoddyToolPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ShoddyMill Include="..\..\..\mills\halifax" Mode="N" Grant="file;terminal" />
  </ItemGroup>

  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
