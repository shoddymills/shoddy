<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.props" />

  <!-- A build fixture that MUST NOT BUILD (C8's refusal proof): halifax
       requires `file` and `terminal`, and this project grants nothing.
       The test asserts the failure and its message text — the error
       names the capability, the mill and the manifest, and prints the
       exact Grant line to add (C2.4b). Not in the solution, for the
       same reason. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
    <ProjectReference Include="..\..\..\machines\Shoddy.Machines.csproj" OutputItemType="ShoddyLibrary" />
    <ProjectReference Include="..\..\..\machines\seeds\Shoddy.Machines.Seeds.csproj" OutputItemType="ShoddyLibrary" />
  </ItemGroup>

  <ItemGroup>
    <ShoddyMill Include="..\..\..\mills\halifax" Mode="N" />
  </ItemGroup>

  <Import Project="..\..\..\src\Shoddy.Build\build\Shoddy.Build.targets" />
</Project>
