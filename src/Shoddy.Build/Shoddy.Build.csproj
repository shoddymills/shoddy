<Project Sdk="Microsoft.Build.NoTargets">

  <!-- Content-only (C2.1): .props and .targets, no Compile items, no
       PackageReference, no assembly. The NoTargets SDK (pinned in
       global.json) is build machinery for THIS project file, not a
       dependency of the package or of any consumer — the .nupkg carries
       the build/ folder and nothing else. Authored as if packaged from
       day one (C7.2): consumers import by relative path until the first
       outside consumer triggers publication (C7.3). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Shoddy.Build</PackageId>
    <Description>MSBuild integration for Shoddy mills and machine libraries: the ShoddyWeave target — verify, capability-gate, weave, reference, assets, manifest embedding — over ShoddyMill items, and the library targets that build a folder of machines into one assembly.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
