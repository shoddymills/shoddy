<Project>

  <!-- Shoddy.Build: consumer-facing defaults. The interesting half is
       the .targets; this exists so ShoddyMill items declared in the
       project body evaluate with their metadata defaulted. -->

  <ItemDefinitionGroup>
    <ShoddyMill>
      <!-- Default-deny (C2.4): a project that says nothing gets pure
           mills and is refused anything else. -->
      <Grant></Grant>
      <Mode></Mode>
    </ShoddyMill>
  </ItemDefinitionGroup>

</Project>
