<Project>

  <!-- ==================================================================
       ShoddyWeave (C2): a declared mill folder becomes ordinary build
       inputs. Per <ShoddyMill Include="path" Mode="N|T" Grant="a;b">:

         verify    mill manifest         (stale machines section fails)
         gate      mill manifest gate    (default-deny; refusal names the
                                          capability and prints the fix)
         weave     mill machine / weave  (instrumented variant under Debug)
         reference woven DLL + transitive machine closure
         assets    declared assets copied beside the output
         embed     mill.manifest as an embedded resource

       The toolchain computes every name and path (mill manifest
       - -inputs); these targets only orchestrate, so there is no second
       derivation to drift. Host-blind throughout — A3.6's check runs
       over this file.
       ================================================================== -->

  <!-- Debug configurations compile in the Perch attach service (C6.2):
       the reference and the arming wiring exist only under Debug, so
       the release artifact provably carries neither (B7.4). The
       project (or template) names where Shoddy.Perch lives via
       $(ShoddyPerchProject); silence opts out entirely. -->
  <ItemGroup Condition="'$(ShoddyPerchProject)' != '' And '$(Configuration)' == 'Debug'">
    <ProjectReference Include="$(ShoddyPerchProject)" />
  </ItemGroup>

  <Target Name="_ShoddyPerchWiring" BeforeTargets="CoreCompile"
          Condition="'$(ShoddyPerchProject)' != '' And '$(Configuration)' == 'Debug' And '$(Language)' == 'C#'">
    <PropertyGroup>
      <_ShoddyPerchWirePath>$(IntermediateOutputPath)ShoddyPerchWiring.g.cs</_ShoddyPerchWirePath>
    </PropertyGroup>
    <ItemGroup>
      <_ShoddyPerchWireLine Include="// Generated by ShoddyWeave (Shoddy.Build) — Perch attach wiring, debug only." />
      <_ShoddyPerchWireLine Include="internal static class ShoddyPerchWiring" />
      <_ShoddyPerchWireLine Include="{" />
      <_ShoddyPerchWireLine Include="    [System.Runtime.CompilerServices.ModuleInitializer]" />
      <_ShoddyPerchWireLine Include="    internal static void Arm() => Shoddy.Perch.PerchService.StartFromEnvironment()%3B" />
      <_ShoddyPerchWireLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_ShoddyPerchWirePath)" Lines="@(_ShoddyPerchWireLine)"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_ShoddyPerchWirePath)" />
      <FileWrites Include="$(_ShoddyPerchWirePath)" />
    </ItemGroup>
  </Target>

  <!-- Toolchain discovery (C2.6): $(ShoddyToolPath), else the local
       .NET tool manifest, else PATH — the extension's own resolution
       order, followed rather than reinvented. No repo-relative
       assumptions: that constraint is what keeps packaging a
       graduation step (C7.2). -->
  <Target Name="ShoddyResolveTool" Condition="'@(ShoddyMill)' != ''">
    <PropertyGroup Condition="'$(ShoddyToolPath)' != ''">
      <_ShoddyMillCmd>"$(ShoddyToolPath)"</_ShoddyMillCmd>
    </PropertyGroup>
    <Exec Condition="'$(_ShoddyMillCmd)' == ''"
          Command="dotnet tool run mill -- --version"
          IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ExitCode" PropertyName="_ShoddyToolManifestProbe" />
    </Exec>
    <PropertyGroup Condition="'$(_ShoddyMillCmd)' == '' And '$(_ShoddyToolManifestProbe)' == '0'">
      <_ShoddyMillCmd>dotnet tool run mill --</_ShoddyMillCmd>
    </PropertyGroup>
    <Exec Condition="'$(_ShoddyMillCmd)' == ''"
          Command="mill --version"
          IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ExitCode" PropertyName="_ShoddyPathProbe" />
    </Exec>
    <PropertyGroup Condition="'$(_ShoddyMillCmd)' == '' And '$(_ShoddyPathProbe)' == '0'">
      <_ShoddyMillCmd>mill</_ShoddyMillCmd>
    </PropertyGroup>
    <Error Condition="'$(_ShoddyMillCmd)' == ''" Code="SHODDY1000"
           Text="the Shoddy toolchain was not found. Three routes are tried, in order: the ShoddyToolPath property (set it to a mill executable), a local .NET tool manifest carrying the 'mill' tool (dotnet tool install), and 'mill' on PATH. None answered." />
  </Target>

  <!-- Per-mill plan: verify, gate, then harvest the toolchain's own
       statement of names, inputs and artifact paths. Batches once per
       ShoddyMill item. -->
  <!-- Batches per (mill, mode): one folder may be declared twice, once
       per mode, and each declaration is its own weave. -->
  <!-- The scope a configuration's woven output lives in, under each
       mill's bin/. EMPTY BY DEFAULT, which is exactly the behaviour this
       always had: every configuration writes mills/<name>/bin.

       Set it on a lane that builds the same mill in two configurations
       at once. Windows holds a LOADED assembly's file against rename
       until the holding process exits, so a Release weave landing on a
       DLL a Debug test host has open fails its final move - and no lock
       helps, because the holder is using the file rather than competing
       for it.

       It travels as an environment variable because the mill runs as a
       separate process per Exec below, and every one of them has to
       agree: the plan step reports the output paths MSBuild uses for
       incremental build, so a plan computed at one scope and a weave
       written at another would rebuild forever.

       (Flags are named without their leading dashes here on purpose: an
       XML comment may not contain a double hyphen, and putting one in
       this file breaks every project that imports it.) -->
  <PropertyGroup>
    <ShoddyBinScope Condition="'$(ShoddyBinScope)' == ''"></ShoddyBinScope>
  </PropertyGroup>

  <Target Name="_ShoddyPlan" DependsOnTargets="ShoddyResolveTool"
          Condition="'@(ShoddyMill)' != ''"
          Outputs="%(ShoddyMill.Identity)|%(ShoddyMill.Mode)">

    <Error Condition="'%(ShoddyMill.Mode)' != 'N' And '%(ShoddyMill.Mode)' != 'T'"
           Code="SHODDY1006"
           Text="ShoddyMill '%(ShoddyMill.Identity)' needs Mode=&quot;N&quot; (native: the core as a machine DLL) or Mode=&quot;T&quot; (terminal: the woven console shell)." />

    <!-- Verify: a stale machines section is a build error naming the
         drift, exactly as at the command line. -->
    <Exec Command="$(_ShoddyMillCmd) manifest &quot;%(ShoddyMill.FullPath)&quot;"
          EnvironmentVariables="SHODDY_BIN_SCOPE=$(ShoddyBinScope)"
          CustomErrorRegularExpression="error SHODDY[0-9]+"
          CustomWarningRegularExpression="warning SHODDY[0-9]+" />

    <!-- Gate (C2.4): default-deny over the manifest's declarations.
         The refusal message is the toolchain's, verbatim — it names
         the capability, the mill, the manifest, and the Grant line to
         add, because default-deny is only humane when refusal is
         self-documenting (C2.4b). -->
    <Exec Command="$(_ShoddyMillCmd) manifest --gate &quot;%(ShoddyMill.Grant)&quot; --mode %(ShoddyMill.Mode) &quot;%(ShoddyMill.FullPath)&quot;"
          EnvironmentVariables="SHODDY_BIN_SCOPE=$(ShoddyBinScope)"
          CustomErrorRegularExpression="error SHODDY[0-9]+"
          CustomWarningRegularExpression="warning SHODDY[0-9]+" />

    <!-- Harvest the plan. Lines are kind-prefixed; anything unprefixed
         (a machine being rebuilt narrates to stderr) is ignored. -->
    <Exec Command="$(_ShoddyMillCmd) manifest --inputs &quot;%(ShoddyMill.FullPath)&quot;"
          EnvironmentVariables="SHODDY_BIN_SCOPE=$(ShoddyBinScope)"
          ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SPOut" />
    </Exec>

    <ItemGroup>
      <_SPL Remove="@(_SPL)" />
      <_SPL Include="$(_SPOut)" />
      <_SPNameL Remove="@(_SPNameL)" />
      <_SPNameL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('name|'))" />
      <_SPCoreL Remove="@(_SPCoreL)" />
      <_SPCoreL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('core|'))" />
      <_SPShellL Remove="@(_SPShellL)" />
      <_SPShellL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('shell|'))" />
      <_SPOutNL Remove="@(_SPOutNL)" />
      <_SPOutNL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('outn|'))" />
      <_SPOutNDL Remove="@(_SPOutNDL)" />
      <_SPOutNDL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('outndebug|'))" />
      <_SPOutTL Remove="@(_SPOutTL)" />
      <_SPOutTL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('outt|'))" />
      <_SPManifestL Remove="@(_SPManifestL)" />
      <_SPManifestL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('manifest|'))" />
      <_SPSourceL Remove="@(_SPSourceL)" />
      <_SPSourceL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('source|'))" />
      <_SPMachineL Remove="@(_SPMachineL)" />
      <_SPMachineL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('machine|'))" />
      <_SPMachineSrcL Remove="@(_SPMachineSrcL)" />
      <_SPMachineSrcL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('machinesrc|'))" />
      <_SPAssetL Remove="@(_SPAssetL)" />
      <_SPAssetL Include="@(_SPL)" Condition="$([System.String]::new('%(Identity)').StartsWith('asset|'))" />
    </ItemGroup>

    <PropertyGroup>
      <!-- Item expansions do not evaluate inside property-function
           arguments, so each value goes raw into a property first and
           the prefix comes off in a second step. -->
      <_SPNameRaw>@(_SPNameL)</_SPNameRaw>
      <_SPCoreRaw>@(_SPCoreL)</_SPCoreRaw>
      <_SPShellRaw>@(_SPShellL)</_SPShellRaw>
      <_SPOutNRaw>@(_SPOutNL)</_SPOutNRaw>
      <_SPOutNDRaw>@(_SPOutNDL)</_SPOutNDRaw>
      <_SPOutTRaw>@(_SPOutTL)</_SPOutTRaw>
      <_SPManifestRaw>@(_SPManifestL)</_SPManifestRaw>
      <_SPName></_SPName>
      <_SPCore></_SPCore>
      <_SPShell></_SPShell>
      <_SPOutN></_SPOutN>
      <_SPOutND></_SPOutND>
      <_SPOutT></_SPOutT>
      <_SPManifest></_SPManifest>
      <_SPName Condition="'$(_SPNameRaw)' != ''">$(_SPNameRaw.Substring(5))</_SPName>
      <_SPCore Condition="'$(_SPCoreRaw)' != ''">$(_SPCoreRaw.Substring(5))</_SPCore>
      <_SPShell Condition="'$(_SPShellRaw)' != ''">$(_SPShellRaw.Substring(6))</_SPShell>
      <_SPOutN Condition="'$(_SPOutNRaw)' != ''">$(_SPOutNRaw.Substring(5))</_SPOutN>
      <_SPOutND Condition="'$(_SPOutNDRaw)' != ''">$(_SPOutNDRaw.Substring(10))</_SPOutND>
      <_SPOutT Condition="'$(_SPOutTRaw)' != ''">$(_SPOutTRaw.Substring(5))</_SPOutT>
      <_SPManifest Condition="'$(_SPManifestRaw)' != ''">$(_SPManifestRaw.Substring(9))</_SPManifest>

      <!-- The list-valued facts: strip each kind prefix across the
           whole ;-joined list in one regex — item transforms do not
           evaluate property functions, property definitions do. -->
      <_SPSourcesRaw>@(_SPSourceL)</_SPSourcesRaw>
      <_SPMachinesRaw>@(_SPMachineL)</_SPMachinesRaw>
      <_SPMachineSrcsRaw>@(_SPMachineSrcL)</_SPMachineSrcsRaw>
      <_SPAssetsRaw>@(_SPAssetL)</_SPAssetsRaw>
      <_SPSources>$([System.Text.RegularExpressions.Regex]::Replace('$(_SPSourcesRaw)', '(^|;)source\|', '$1'))</_SPSources>
      <_SPMachines>$([System.Text.RegularExpressions.Regex]::Replace('$(_SPMachinesRaw)', '(^|;)machine\|', '$1'))</_SPMachines>
      <_SPMachineSrcs>$([System.Text.RegularExpressions.Regex]::Replace('$(_SPMachineSrcsRaw)', '(^|;)machinesrc\|', '$1'))</_SPMachineSrcs>
      <_SPAssets>$([System.Text.RegularExpressions.Regex]::Replace('$(_SPAssetsRaw)', '(^|;)asset\|', '$1'))</_SPAssets>

      <!-- Which artifact this configuration builds: the instrumented
           machine weave under Debug (C2.3, A6.2), the plain one
           otherwise; Mode T weaves the shell either way. -->
      <_SPWeaveIn></_SPWeaveIn>
      <_SPWeaveOut></_SPWeaveOut>
      <_SPVerb></_SPVerb>
      <_SPWeaveIn Condition="'%(ShoddyMill.Mode)' == 'N'">$(_SPCore)</_SPWeaveIn>
      <_SPWeaveIn Condition="'%(ShoddyMill.Mode)' == 'T'">$(_SPShell)</_SPWeaveIn>
      <_SPWeaveOut Condition="'%(ShoddyMill.Mode)' == 'N' And '$(Configuration)' != 'Debug'">$(_SPOutN)</_SPWeaveOut>
      <_SPWeaveOut Condition="'%(ShoddyMill.Mode)' == 'N' And '$(Configuration)' == 'Debug'">$(_SPOutND)</_SPWeaveOut>
      <_SPWeaveOut Condition="'%(ShoddyMill.Mode)' == 'T'">$(_SPOutT)</_SPWeaveOut>
      <_SPVerb Condition="'%(ShoddyMill.Mode)' == 'N' And '$(Configuration)' != 'Debug'">machine</_SPVerb>
      <_SPVerb Condition="'%(ShoddyMill.Mode)' == 'N' And '$(Configuration)' == 'Debug'">machine --debug</_SPVerb>
      <_SPVerb Condition="'%(ShoddyMill.Mode)' == 'T'">weave</_SPVerb>
    </PropertyGroup>

    <!-- The manifest is part of the project (C2.5): when the closure
         grows, every up-to-date check keyed on MSBuildAllProjects — the
         deps file, compile — must go stale with it. Without this, an
         incremental build copies the new machine DLL beside the output
         but GenerateBuildDependencyFile skips, deps.json never lists
         the assembly, and the host's Assembly.Load refuses a file that
         is sitting right there. -->
    <PropertyGroup Condition="'$(_SPManifest)' != ''">
      <MSBuildAllProjects>$(MSBuildAllProjects);$(_SPManifest)</MSBuildAllProjects>
    </PropertyGroup>

    <Error Condition="'$(_SPWeaveIn)' == ''" Code="SHODDY1007"
           Text="mill '%(ShoddyMill.Identity)': the manifest declares no %(ShoddyMill.Mode)-mode entry file." />

    <ItemGroup>
      <ShoddyPlanned Include="%(ShoddyMill.Identity)">
        <Folder>%(ShoddyMill.FullPath)</Folder>
        <Mode>%(ShoddyMill.Mode)</Mode>
        <Grant>%(ShoddyMill.Grant)</Grant>
        <Name>$(_SPName)</Name>
        <WeaveIn>$(_SPWeaveIn)</WeaveIn>
        <OutDll>$(_SPWeaveOut)</OutDll>
        <Verb>$(_SPVerb)</Verb>
        <ManifestPath>$(_SPManifest)</ManifestPath>
        <Inputs>$([MSBuild]::Unescape('$(_SPSources);$(_SPMachines);$(_SPMachineSrcs);$(_SPManifest)'))</Inputs>
      </ShoddyPlanned>

      <!-- The consuming build's items, minted here where the per-mill
           properties are in scope (metadata expansions never re-split
           on semicolons; property expansions do). References are the
           woven artifact plus the transitive closure, all copy-local —
           the manifest is the complete statement of what to link
           (A3.2), and this is where it pays. -->
      <Reference Include="$(_SPWeaveOut)">
        <Private>true</Private>
      </Reference>
      <Reference Include="$([MSBuild]::Unescape('$(_SPMachines)'))" Condition="'$(_SPMachines)' != ''">
        <Private>true</Private>
      </Reference>
      <_ShoddyManifestToEmbed Include="$(_SPManifest)">
        <LogicalName>$(_SPName).mill.manifest</LogicalName>
      </_ShoddyManifestToEmbed>
      <_ShoddyAsset Include="$([MSBuild]::Unescape('$(_SPAssets)'))" Condition="'$(_SPAssets)' != ''">
        <MillFolder>%(ShoddyMill.FullPath)</MillFolder>
      </_ShoddyAsset>
    </ItemGroup>
  </Target>

  <!-- The weave itself, incremental per mill (C2.5): Inputs are the
       mill's sources, its transitive machine closure (DLLs and their
       sources) and the manifest; Outputs the woven artifact. An
       untouched mill launches nothing; a touched dependency re-weaves
       what depends on it. -->
  <Target Name="_ShoddyWeaveEach" DependsOnTargets="_ShoddyPlan"
          Condition="'@(ShoddyMill)' != ''"
          Inputs="%(ShoddyPlanned.Inputs)" Outputs="%(ShoddyPlanned.OutDll)">
    <Exec Command="$(_ShoddyMillCmd) %(ShoddyPlanned.Verb) &quot;%(ShoddyPlanned.WeaveIn)&quot;"
          EnvironmentVariables="SHODDY_BIN_SCOPE=$(ShoddyBinScope)" />
  </Target>

  <!-- Wire the artifacts into the consuming build: references (woven
       DLL plus the closure, all copy-local), declared assets beside
       the output under the mill's own relative layout, and the
       manifest embedded as NAME.mill.manifest for hosts that read
       their mills at runtime. -->
  <Target Name="ShoddyWeave" DependsOnTargets="_ShoddyWeaveEach"
          Condition="'@(ShoddyMill)' != ''"
          BeforeTargets="ResolveAssemblyReferences;AssignTargetPaths">
    <ItemGroup Condition="'@(_ShoddyAsset)' != ''">
      <None Include="@(_ShoddyAsset)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>$([MSBuild]::MakeRelative('%(_ShoddyAsset.MillFolder)', '%(_ShoddyAsset.Identity)'))</Link>
      </None>
    </ItemGroup>
    <!-- The manifest embeds once per mill, however many modes declared
         it — a folder claimed for N and T is still one mill. -->
    <RemoveDuplicates Inputs="@(_ShoddyManifestToEmbed)" Condition="'@(_ShoddyManifestToEmbed)' != ''">
      <Output TaskParameter="Filtered" ItemName="_ShoddyManifestDeduped" />
    </RemoveDuplicates>
    <ItemGroup Condition="'@(_ShoddyManifestDeduped)' != ''">
      <EmbeddedResource Include="@(_ShoddyManifestDeduped)" />
    </ItemGroup>
  </Target>

  <!-- Generated grant wiring, compiled into C# consumers (C2.4a/c):
       a Mode T mill granted `net` arms the process for its lifetime —
       the R2 resolution, all-or-nothing per process, exactly as the
       desktop mill's allow-net flag behaves — and a `file` grant registers the
       fail-fast: a ShoddyHost.Load that supplies no root dies at
       startup naming the mill, never by writing beside the
       executable. -->
  <Target Name="_ShoddyWiring" DependsOnTargets="_ShoddyPlan"
          BeforeTargets="CoreCompile"
          Condition="'@(ShoddyMill)' != '' And '$(Language)' == 'C#'">
    <ItemGroup>
      <_ShoddyNetT Include="@(ShoddyPlanned)"
          Condition="'%(ShoddyPlanned.Mode)' == 'T' And $([System.String]::new(';%(ShoddyPlanned.Grant);').ToLowerInvariant().Contains(';net;'))" />
      <_ShoddyFileMill Include="@(ShoddyPlanned)"
          Condition="$([System.String]::new(';%(ShoddyPlanned.Grant);').ToLowerInvariant().Contains(';file;'))" />
    </ItemGroup>
    <PropertyGroup>
      <_ShoddyWirePath>$(IntermediateOutputPath)ShoddyWiring.g.cs</_ShoddyWirePath>
      <_ShoddyWireAny>@(_ShoddyNetT)@(_ShoddyFileMill)</_ShoddyWireAny>
    </PropertyGroup>
    <ItemGroup Condition="'$(_ShoddyWireAny)' != ''">
      <_ShoddyWireLine Include="// Generated by ShoddyWeave (Shoddy.Build) — grant wiring. Do not edit." />
      <_ShoddyWireLine Include="internal static class ShoddyGrantWiring" />
      <_ShoddyWireLine Include="{" />
      <_ShoddyWireLine Include="    [System.Runtime.CompilerServices.ModuleInitializer]" />
      <_ShoddyWireLine Include="    internal static void Arm()" />
      <_ShoddyWireLine Include="    {" />
      <_ShoddyWireLine Condition="'@(_ShoddyNetT)' != ''"
          Include="        // Mode T `net`: the woven program constructs its own engine," />
      <_ShoddyWireLine Condition="'@(_ShoddyNetT)' != ''"
          Include="        // so arming is process-wide for the process lifetime (R2)." />
      <_ShoddyWireLine Condition="'@(_ShoddyNetT)' != ''"
          Include="        System.Environment.SetEnvironmentVariable(%22SHODDY_ALLOW_NET%22, %221%22)%3B" />
      <_ShoddyWireLine Include="@(_ShoddyFileMill->'        Shoddy.Hosting.ShoddyHost.RequireFileRoot(%22%(Name)%22)%3B')" />
      <_ShoddyWireLine Include="    }" />
      <_ShoddyWireLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile Condition="'$(_ShoddyWireAny)' != ''"
        File="$(_ShoddyWirePath)" Lines="@(_ShoddyWireLine)"
        Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'$(_ShoddyWireAny)' != ''">
      <Compile Include="$(_ShoddyWirePath)" />
      <FileWrites Include="$(_ShoddyWirePath)" />
    </ItemGroup>
  </Target>

</Project>
