<!-- The trimmer descriptor (C4.3, B4.3). The manifest reader is
     reflective — machine manifests are assembly attributes, and Mode T
     entry points are found as `Woven` by name — so a trimmed or
     AOT-compiled consumer must keep what reflection reads. The woven
     assemblies themselves are the consumer's to root (ShoddyWeave and
     the templates emit DynamicDependency for them); this file keeps the
     shared attribute and engine surface that every read goes through. -->
<linker>
  <assembly fullname="Shoddy.Hosting" preserve="all" />
  <assembly fullname="Shoddy.Runtime">
    <type fullname="Shoddy.Runtime.ShoddyMachineAttribute" preserve="all" />
    <type fullname="Shoddy.Runtime.ShoddyDefAttribute" preserve="all" />
    <type fullname="Shoddy.Runtime.ShoddyDependsOnAttribute" preserve="all" />
    <type fullname="Shoddy.Runtime.ShoddyTypeAttribute" preserve="all" />
    <type fullname="Shoddy.Runtime.Engine" preserve="all" />
  </assembly>
</linker>
