<Project Sdk="Microsoft.NET.Sdk">

  <!-- The thin facade any .NET host consumes a mill through: manifest-
       driven word lookup, ShoddyValue construction and destructuring, and
       RunWovenAsync for piping a woven console mill. Plain net10.0, zero
       package references, references Shoddy.Runtime alone — it is in
       every consumer's dependency floor (C1.3) and must never thicken
       it. Host-blind by construction; A3.6's check runs over it.
       CLS-compliant (C4.1): consumable from C#, F# and VB with no
       wrappers — the F# proof project is the acceptance test. -->

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Runtime\Shoddy.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The trimmer descriptor (C4.3): the manifest reader is reflective,
         and a trimmed consumer must keep what it reads. -->
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
