<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless build of the mill: the pure verbs only — weave,
       machine, manifest, gen, lex — with compile-time stubs for run and
       dap that refuse by name. No Silk.NET reference, no natives, no
       probe or dynamic load that could drag them back: a build that
       cannot reference the window stack cannot load it, which is what
       lets the full weave run in a minimal container with no X11 and no
       audio device. Both builds are called mill (C3); this one ships as
       the Shoddy.Mill.Headless package. -->

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Devil\Shoddy.Devil.csproj" />
    <ProjectReference Include="..\Shoddy.Runtime\Shoddy.Runtime.csproj" />
    <ProjectReference Include="..\Shoddy.Compiler\Shoddy.Compiler.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mill</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships as a .NET tool (C3.7, C7.4): `dotnet tool install
         Shoddy.Mill.Headless` puts `mill` in a project's tool manifest,
         which is the second stop in ShoddyWeave's discovery order.
         Publication waits for the first consumer outside this repo
         (C7.3); packing is proven in CI so graduation stays a
         packaging step. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mill</ToolCommandName>
    <PackageId>Shoddy.Mill.Headless</PackageId>
  </PropertyGroup>

</Project>
