<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Devil\Shoddy.Devil.csproj" />
    <ProjectReference Include="..\Shoddy.Runtime\Shoddy.Runtime.csproj" />
    <ProjectReference Include="..\Shoddy.Compiler\Shoddy.Compiler.csproj" />
  </ItemGroup>

  <!-- The scribbler's window/GL stack. Presentation only: the runtime draws
       into a plain byte[] and the mill blits it as one textured quad. GLFW
       natives ride in transitively via Silk.NET.Windowing. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.*" />
    <PackageReference Include="Silk.NET.Input" Version="2.*" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.*" />
  </ItemGroup>

  <!-- The buzzer's audio stack. OpenAL Soft rides in as a native the same
       way GLFW does: the runtime validates and calls through
       BuzzerRegistry; only the mill touches OpenAL. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" Version="2.*" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.*" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mill</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OpenAL device/context handles are raw pointers in Silk.NET -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
