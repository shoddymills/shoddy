<Project Sdk="Microsoft.NET.Sdk">

  <!-- The perch, extracted (D5): the DAP protocol server — breakpoints,
       stepping, stack and variable views, the IDebugSink — parameterized
       over a transport Stream pair, so a host can serve it over TCP as
       readily as the mill serves it over stdio. Plain net10.0,
       references Shoddy.Runtime only: loadable by any host without
       Shoddy.Mill (A6.3). Host-blind; A3.6's check runs over it. -->

  <ItemGroup>
    <ProjectReference Include="..\Shoddy.Runtime\Shoddy.Runtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
