<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The full mill carries the standard library in lib/ and its
         sources in machines/, and both travel into this test host's
         output with it, so in-process tests resolve the library the way
         the mill does. -->
    <ProjectReference Include="..\Shoddy.Mill\Shoddy.Mill.csproj" />
    <!-- Build-order only, and Private="false" so its mill.deps.json and
         runtimeconfig (it is also called mill) never land here beside
         the full mill's. -->
    <ProjectReference Include="..\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Shoddy.Devil\Shoddy.Devil.csproj" />
    <ProjectReference Include="..\Shoddy.Runtime\Shoddy.Runtime.csproj" />
    <ProjectReference Include="..\Shoddy.Compiler\Shoddy.Compiler.csproj" />
    <ProjectReference Include="..\Shoddy.Hosting\Shoddy.Hosting.csproj" />
  </ItemGroup>

</Project>
