{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: launch host (perch armed)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "shoddy: build (debug — weaves the instrumented core)",
      "program": "${workspaceFolder}/bin/Debug/net10.0/ShoddyConsoleApp.dll",
      "cwd": "${workspaceFolder}",
      "env": { "SHODDY_PERCH": "4711" },
      "console": "internalConsole"
    },
    {
      "name": "Shoddy: attach to the perch",
      "type": "shoddy",
      "request": "attach",
      "host": "127.0.0.1",
      "port": 4711
    }
  ],
  "compounds": [
    {
      "name": "F5: debug host + Shoddy",
      "configurations": [
        ".NET: launch host (perch armed)",
        "Shoddy: attach to the perch"
      ],
      "stopAll": true
    }
  ]
}
