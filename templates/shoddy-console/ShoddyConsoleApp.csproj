<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="SHODDY-BUILD-DIR\Shoddy.Build.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Toolchain discovery: ShoddyToolPath, else a local dotnet tool
         manifest carrying `mill`, else PATH. Uncomment to pin:
    <ShoddyToolPath>path\to\mill</ShoddyToolPath> -->
    <!-- Debug builds compile in the Perch attach service; point this at
         Shoddy.Perch (project or package) to debug the Shoddy side:
    <ShoddyPerchProject>path\to\Shoddy.Perch.csproj</ShoddyPerchProject> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Until Shoddy's packages publish, reference the checkout: -->
    <ProjectReference Include="SHODDY-BUILD-DIR\..\..\Shoddy.Hosting\Shoddy.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mill. Grants are this project's capability statement:
         default-deny, and the refusal prints the exact line to add. -->
    <ShoddyMill Include="SHODDY-MILL-PATH" Mode="N" Grant="SHODDY-MILL-GRANTS" />
  </ItemGroup>

  <Import Project="SHODDY-BUILD-DIR\Shoddy.Build.targets" />
</Project>
