<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="SHODDY-BUILD-DIR\Shoddy.Build.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Until Shoddy's packages publish, reference the checkout: the
         hosting facade, the toolchain that weaves (built, never linked),
         and the machine library the mill includes. -->
    <ProjectReference Include="SHODDY-BUILD-DIR\..\..\Shoddy.Hosting\Shoddy.Hosting.csproj" />
    <ProjectReference Include="SHODDY-BUILD-DIR\..\..\Shoddy.Mill.Headless\Shoddy.Mill.Headless.csproj"
                      ReferenceOutputAssembly="false" Private="false" OutputItemType="ShoddyTool" />
    <ProjectReference Include="SHODDY-BUILD-DIR\..\..\..\machines\Shoddy.Machines.csproj" OutputItemType="ShoddyLibrary" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mill. Grants are this project's capability statement:
         default-deny, and the refusal prints the exact line to add. -->
    <ShoddyMill Include="SHODDY-MILL-PATH" Mode="N" Grant="SHODDY-MILL-GRANTS" />
  </ItemGroup>

  <Import Project="SHODDY-BUILD-DIR\Shoddy.Build.targets" />
</Project>
