Rem ==================================================================
Rem cryptotest.shoddy — test program for machines/crypto.shoddy
Rem
Rem Assert-driven, in the randomtest.shoddy / neuraltest.shoddy pattern:
Rem contract checks rather than golden bytes, ending with
Rem ALL ASSERTIONS PASSED.
Rem
Rem The assertions that earn their keep are the ones a broken cipher
Rem passes anyway. An earlier version of this machine round-tripped
Rem perfectly while encrypting NOTHING — its round function overflowed
Rem past 2^53 and returned 0 forever, so every round was a bare swap and
Rem four of them were the identity. A round-trip test alone is therefore
Rem worthless here. THE CIPHERTEXT MUST DIFFER FROM THE MESSAGE, THE KEY
Rem MUST CHANGE IT, AND THE WRONG KEY MUST NOT RECOVER IT. Those three
Rem are the point of this file.
Rem
Rem What cannot be tested here: the aborting half of each guard pair.
Rem CryptEncrypt on an out-of-field value and CryptDecrypt on an altered
Rem message both call Error, which would end this run — the same
Rem limitation isamtest documents. The total halves (CryptDecryptOr,
Rem CryptVerify, CryptIsField) are exercised instead, which is why they
Rem exist.
Rem
Rem Build (once): build.cmd build
Rem Run:          bin\mill run tst\cryptotest.shoddy
Rem ==================================================================

Include "../machines/crypto.shoddy"

Rem Deep equality: = compares Lists by identity, so two structurally
Rem identical lists are never = each other. Walked rather than Zipped,
Rem because Zip indexes with Nth and would be quadratic on the long
Rem message at the end.
Def Same(xs As List Of Number, ys As List Of Number) As Boolean
    If IsEmpty(xs) Then
        IsEmpty(ys)
    Else
        If IsEmpty(ys) Then
            False
        Else
            If First(xs) <> First(ys) Then
                False
            Else
                Same(Rest(xs), Rest(ys))

Rem A message of n distinct field values, built without Append.
Def Spread(n As Number) As List Of Number
    Map(Range(1, n), Fn(k) => CryptWrap(k * 7919))

Def Main()
    Let key = { 91, 3355, 17, 40213 }
    Let msg = { 11, 22, 33, 44, 55, 66 }
    Let cipher = CryptEncrypt(msg, key)

    Print("--- the field ---")
    Print(CryptModulus())                               Rem 67108859
    Print(CryptRounds())                                Rem 4
    Assert(CryptModulus() < 67108864, "THE MODULUS IS BELOW 2^26")
    Assert(CryptModulus() * CryptModulus() < 9007199254740992, "SO ITS SQUARE IS EXACT IN A DOUBLE")
    Assert(CryptIsField(0), "ZERO IS IN THE FIELD")
    Assert(CryptIsField(CryptModulus() - 1), "SO IS THE TOP ELEMENT")
    Assert(Not CryptIsField(CryptModulus()), "THE MODULUS ITSELF IS NOT")
    Assert(Not CryptIsField(0 - 1), "NOR IS A NEGATIVE")
    Assert(Not CryptIsField(1.5), "NOR IS A FRACTION")
    Assert(CryptAllField({ 0, 5, 67108858 }), "CRYPTALLFIELD ACCEPTS")
    Assert(Not CryptAllField({ 0, 5, 67108859 }), "AND REJECTS")
    Assert(CryptAllField({ }), "VACUOUSLY TRUE FOR THE EMPTY MESSAGE")

    Print("--- CryptWrap ---")
    Print(CryptWrap(0))                                 Rem 0
    Print(CryptWrap(CryptModulus()))                    Rem 0
    Print(CryptWrap(CryptModulus() + 7))                Rem 7
    Print(CryptWrap(0 - 1))                             Rem 67108858
    Assert(CryptWrap(0 - CryptModulus()) = 0, "A NEGATIVE MULTIPLE WRAPS TO ZERO")
    Assert(CryptWrap(0 - 5) = CryptModulus() - 5, "AND A NEGATIVE COMES BACK POSITIVE")
    Assert(CryptIsField(CryptWrap(0 - 12345678)), "WRAP ALWAYS LANDS IN THE FIELD")

    Print("--- it round-trips ---")
    Assert(Same(CryptDecrypt(cipher, key), msg), "AN EVEN-LENGTH MESSAGE")
    Assert(Same(CryptDecrypt(CryptEncrypt({ 7, 8, 9 }, key), key), { 7, 8, 9 }), "AN ODD-LENGTH MESSAGE")
    Assert(Same(CryptDecrypt(CryptEncrypt({ 5 }, key), key), { 5 }), "A SINGLE VALUE")
    Assert(Same(CryptDecrypt(CryptEncrypt({ }, key), key), { }), "THE EMPTY MESSAGE")
    Assert(Same(CryptDecrypt(CryptEncrypt({ 0, CryptModulus() - 1 }, key), key), { 0, CryptModulus() - 1 }), "BOTH ENDS OF THE FIELD")
    Assert(Same(CryptDecrypt(CryptEncrypt({ 0, 0, 0, 0 }, key), key), { 0, 0, 0, 0 }), "A MESSAGE OF ZEROS")
    Assert(Length(cipher) = Length(msg) + 1, "THE CIPHERTEXT CARRIES ONE EXTRA VALUE, THE TAG")
    Assert(CryptAllField(cipher), "AND EVERY VALUE OF IT IS IN THE FIELD")

    Print("--- and it actually encrypts ---")
    Rem The three that a degenerate round function would fail.
    Assert(Not Same(CryptBody(cipher), msg), "THE CIPHERTEXT IS NOT THE MESSAGE")
    Assert(Not Same(CryptEncrypt(msg, { 91, 3355, 17, 40214 }), cipher), "CHANGING ONE KEY VALUE CHANGES IT")
    Assert(Not Same(CryptDecryptOr(cipher, { 91, 3355, 17, 40214 }, { }), msg), "THE WRONG KEY DOES NOT RECOVER THE MESSAGE")
    Rem A message of zeros must not come out as zeros.
    Let zeros = CryptEncrypt({ 0, 0, 0, 0 }, key)
    Assert(Not Same(CryptBody(zeros), { 0, 0, 0, 0 }), "ZEROS DO NOT ENCRYPT TO ZEROS")
    Rem Changing one value changes the block it sits in.
    Assert(Not Same(CryptEncrypt({ 12, 22, 33, 44, 55, 66 }, key), cipher), "ONE CHANGED VALUE CHANGES THE CIPHERTEXT")
    Rem And the lone tail of an odd message must not sit there in clear.
    Let oc = CryptEncrypt({ 7, 8, 9 }, key)
    Assert(Nth(oc, 3) <> 9, "THE UNPAIRED TAIL IS PADDED, NOT PASSED THROUGH")
    Rem Deterministic: no hidden state, no clock, no Rnd.
    Assert(Same(CryptEncrypt(msg, key), cipher), "ENCRYPTING TWICE GIVES THE SAME CIPHERTEXT")

    Print("--- the round function ---")
    Assert(CryptMix(1, 1) <> 0, "THE MIX IS NOT DEGENERATE")
    Assert(CryptMix(0, 0) <> 0, "NOT EVEN AT THE ORIGIN")
    Assert(CryptIsField(CryptMix(0, 0)), "AND IT LANDS IN THE FIELD")
    Assert(CryptIsField(CryptMix(CryptModulus() - 1, CryptModulus() - 1)), "EVEN AT THE TOP OF THE FIELD")
    Assert(CryptMix(2, 1) <> CryptMix(1, 1), "A DIFFERENT VALUE MIXES DIFFERENTLY")
    Assert(CryptMix(1, 2) <> CryptMix(1, 1), "A DIFFERENT KEY MIXES DIFFERENTLY")
    Rem A Feistel round is invertible whatever the round function does;
    Rem these two are exact inverses of one another.
    Let fwd = CryptRoundFwd(11, 22, 33)
    Let back = CryptRoundBack(Fst(fwd), Snd(fwd), 33)
    Assert(Fst(back) = 11 And Snd(back) = 22, "THE DECRYPTING ROUND INVERTS THE ENCRYPTING ONE")

    Print("--- the key schedule ---")
    Assert(CryptKeyAt(key, 1) = 91, "THE FIRST KEY VALUE")
    Assert(CryptKeyAt(key, 4) = 40213, "THE LAST")
    Assert(CryptKeyAt(key, 5) = 91, "AND THEN IT WRAPS ROUND")
    Assert(CryptKeyAt(key, 9) = 91, "TWICE ROUND")
    Assert(CryptKeyAt({ 7 }, 12345) = 7, "A ONE-VALUE KEY REPEATS FOREVER")

    Print("--- the tag ---")
    Print(CryptChecksum({ }))                           Rem 0
    Assert(CryptChecksum({ }) = 0, "THE EMPTY MESSAGE HAS TAG ZERO")
    Assert(CryptChecksum({ 1, 2 }) <> CryptChecksum({ 2, 1 }), "THE TAG NOTICES ORDER")
    Assert(CryptChecksum({ 1, 2 }) = CryptChecksum({ 1, 2 }), "AND IS A FUNCTION OF THE MESSAGE")
    Assert(CryptIsField(CryptChecksum(Spread(500))), "THE TAG IS A FIELD ELEMENT")
    Assert(CryptVerify(cipher), "A FRESH CIPHERTEXT VERIFIES")
    Assert(Not CryptVerify({ }), "AN EMPTY MESSAGE CANNOT CARRY A TAG")
    Assert(Not CryptVerify(Prepend(CryptWrap(First(cipher) + 1), Rest(cipher))), "AN EDITED VALUE IS CAUGHT")
    Assert(Not CryptVerify(Prepend(Nth(cipher, 2), Prepend(Nth(cipher, 1), DropN(cipher, 2)))), "SO IS A TRANSPOSITION")
    Assert(Not CryptVerify(CryptBody(cipher)), "SO IS A TRUNCATION")

    Print("--- the total half of each guard pair ---")
    Assert(Same(CryptDecryptOr(cipher, key, { 0 }), msg), "CRYPTDECRYPTOR ON A GOOD MESSAGE")
    Assert(Same(CryptDecryptOr({ 1, 2, 3 }, key, { 0 }), { 0 }), "FALLS BACK ON A BAD TAG")
    Assert(Same(CryptDecryptOr(cipher, { }, { 0 }), { 0 }), "FALLS BACK ON AN EMPTY KEY")
    Assert(Same(CryptDecryptOr(cipher, { 1.5 }, { 0 }), { 0 }), "FALLS BACK ON A KEY OUTSIDE THE FIELD")
    Assert(Same(CryptDecryptOr({ }, key, { 0 }), { 0 }), "FALLS BACK ON AN EMPTY CIPHERTEXT")

    Print("--- scale: 20000 values, no stack growth ---")
    Rem CryptEncList, CryptDecList, CryptSumLoop and CryptTakeN are all
    Rem self-tail-recursive, so they compile to loops. seq's Taken is not,
    Rem which is why CryptBody does not use it.
    Let big = Spread(20000)
    Let bigC = CryptEncrypt(big, key)
    Assert(Length(bigC) = 20001, "20000 VALUES IN, 20001 OUT")
    Assert(Same(CryptDecrypt(bigC, key), big), "AND THE WHOLE THING ROUND-TRIPS")
    Assert(Not Same(CryptBody(bigC), big), "HAVING ACTUALLY BEEN ENCRYPTED")
    Assert(CryptVerify(bigC), "AND IT VERIFIES")

    Print("--- a worked example: text through Asc and Chr ---")
    Rem Not the machine's business, but one Map away, and it shows what
    Rem the thing is for. NUL is the one code unit that cannot survive,
    Rem because Chr(0) is the empty string in Shoddy.
    Let text = "MEET AT THE MILL"
    Let codes = Map(Range(1, Len(text)), Fn(k) => Asc(Mid(text, k, 1)))
    Let sealed = CryptEncrypt(codes, key)
    Let opened = CryptDecrypt(sealed, key)
    Let backAgain = Fold(opened, "", Fn(a, n) => a & Chr(n))
    Print(backAgain)                                    Rem MEET AT THE MILL
    Assert(backAgain = text, "TEXT SURVIVES THE ROUND TRIP")
    Assert(Not Same(CryptBody(sealed), codes), "AND DOES NOT SURVIVE THE OUTWARD LEG")

    Print("ALL ASSERTIONS PASSED")
