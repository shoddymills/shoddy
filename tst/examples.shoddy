Rem ==================================================================
Rem examples.shoddy — a grab-bag of small self-contained defs: numeric
Rem helpers, list folds, records, and arrays. No Includes; nothing here
Rem depends on the machines.
Rem
Rem Build (once): build.ps1 build
Rem Run:          bin\mill run tst\examples.shoddy
Rem ==================================================================

Def IsEven(n As Number) As Boolean
    n Mod 2 = 0

Def Square(n As Number) As Number
    n * n

Def Hypot(a As Number, b As Number) As Number
    Sqr(Square(a) + Square(b))

Def Fact(n As Number) As Number
    If n = 0 Then
        1
    Else
        n * Fact(n - 1)

Def Quadratic(a As Number, b As Number, c As Number, x As Number) As Number
    a * Square(x) + b * x + c

Def Sum(xs As List Of Number) As Number
    Fold(xs, 0, +)

Def Average(xs As List Of Number) As Number
    Sum(xs) / Length(xs)

Def CountIf(xs As List Of t, p As [ t -- Boolean ]) As Number
    Length(Filter(xs, p))

Rem Self-hosted aggregation via the list primitives
Def MySum(xs As List Of Number) As Number
    If IsEmpty(xs) Then
        0
    Else
        First(xs) + MySum(Rest(xs))

Rem Pipeline chaining: adjacency is stack flow
Def EvenSquareSum(n As Number) As Number
    Range(1, n)
        Filter(IsEven)
        Map(Square)
        Fold(0, +)

Def FizzWord(n As Number) As String
    If n Mod 15 = 0 Then
        "FIZZBUZZ"
    Else
        If n Mod 3 = 0 Then
            "FIZZ"
        Else
            If n Mod 5 = 0 Then
                "BUZZ"
            Else
                Str(n)

Rem Concatenative style remains legal, with a stack-effect signature
Def Doubled ( List Of Number -- List Of Number )
    [ 2 * ] Map

Rem ---- records ------------------------------------------------------

Type Person
    Name As String
    Age  As Number

Def IsAdult(p As Person) As Boolean
    Age(p) >= 18

Def Main()
    Print("HELLO FROM SHODDY")
    Print(Hypot(3, 4))                              Rem 5
    Print(Fact(10))                                 Rem 3628800
    Print(Quadratic(1, -3, 2, 5))                   Rem 25 - 15 + 2 = 12
    Let sales = { 120, 95, 210, 87, 143 }
    Print("TOTAL: " & Str(Sum(sales)))              Rem 655
    Print("AVG: " & Str(Average(sales)))            Rem 131
    Print("BIG: " & Str(CountIf(sales, >=(100))))   Rem 3
    Print("MYSUM: " & Str(MySum(sales)))            Rem 655
    Print(EvenSquareSum(10))                        Rem 4+16+36+64+100 = 220
    Print(Doubled({ 1, 2, 3 }))                     Rem [ 2 4 6 ]
    Each(Range(1, 15), Fn(n) => Print(FizzWord(n)))
    Rem ---- records in action ----
    Let ann = Person("ANN", 34)
    Let bob = Person(Name = "BOB", Age = 41)
    Let people = { ann, bob, Person("CAZ", 17) }
    Print(ann)                                      Rem Person(Name = "ANN", Age = 34)
    Print(Map(people, Name))                        Rem [ "ANN" "BOB" "CAZ" ]
    Print(Length(Filter(people, IsAdult)))          Rem 2
    Print(Fold(people, 0, Fn(t, p) => t + Age(p)))  Rem 92
    Print(With(ann, Age = Age(ann) + 1))            Rem birthday: Age = 35
    Print(ann = Person("ANN", 34))                  Rem True (structural =)
    Rem ---- arrays in action ----
    Let a = ToArray(Range(1, 5))
    Print(Nth(a, 3))                                Rem 3 (o(1) on arrays)
    Print(SetNth(a, 3, 99))                         Rem Array(1, 2, 99, 4, 5)
    Print(Map(a, Square))                           Rem Array(1, 4, 9, 16, 25)
    Print(Fold(a, 0, +))                            Rem 15
    Print(Dim(3, 7))                                Rem Array(7, 7, 7)
