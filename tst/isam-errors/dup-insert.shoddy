Rem ==================================================================
Rem dup-insert.shoddy — expected-to-abort isam.shoddy error condition
Rem
Rem Error() aborts the whole program, so this can't be an Assert-based
Rem test like tst/isamtest.shoddy — it IS the test. Verified by actually
Rem running it: passing means this prints exactly
Rem     ERROR (line 424): ISAMINSERT: DUPLICATE KEY
Rem and exits with code 1. The line number is inside machines/isam.shoddy
Rem itself (where IsamInsert's Error(...) call lives), not this file.
Rem
Rem Run: bin\mill run tst\isam-errors\dup-insert.shoddy
Rem ==================================================================

Include "../../machines/isam.shoddy"

Type Kv
    K As Number
    V As String

Def RdKv(f As Number) As Kv
    Kv(GetNum(f), GetStr(f, 8))

Def WrKv(f As Number, r As Kv)
    PutNum(f, K(r))
    PutStr(f, V(r), 8)

Def KvKey(r As Kv) As Number
    K(r)

Def Main()
    If FileExists("_err_dup.tmp") Then
        DeleteFile("_err_dup.tmp")
    Let db = IsamOpen("_err_dup.tmp", 16, RdKv, WrKv, KvKey)
    Let db2 = IsamInsert(db, Kv(1, "A"))
    IsamInsert(db2, Kv(1, "B"))
