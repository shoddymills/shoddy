Rem ==================================================================
Rem next-past-end.shoddy — expected-to-abort isam.shoddy error condition
Rem
Rem Verified by actually running it: passing means this prints exactly
Rem     ERROR (line 538): ISAMNEXT: NO NEXT KEY
Rem and exits with code 1. The line number is inside machines/isam.shoddy
Rem itself (where IsamNext's Error(...) call lives), not this file.
Rem
Rem Run: bin\mill run tst\isam-errors\next-past-end.shoddy
Rem ==================================================================

Include "../../machines/isam.shoddy"

Type Kv
    K As Number
    V As String

Def RdKv(f As Number) As Kv
    Kv(GetNum(f), GetStr(f, 8))

Def WrKv(f As Number, r As Kv)
    PutNum(f, K(r))
    PutStr(f, V(r), 8)

Def KvKey(r As Kv) As Number
    K(r)

Def Main()
    If FileExists("_err_next.tmp") Then
        DeleteFile("_err_next.tmp")
    Let db = IsamOpen("_err_next.tmp", 16, RdKv, WrKv, KvKey)
    Let db2 = IsamInsert(IsamInsert(db, Kv(1, "A")), Kv(2, "B"))
    IsamNext(db2, 2)
