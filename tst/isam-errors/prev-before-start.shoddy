Rem ==================================================================
Rem prev-before-start.shoddy — expected-to-abort isam.shoddy error condition
Rem
Rem Verified by actually running it: passing means this prints exactly
Rem     ERROR (line 558): ISAMPREV: NO PREVIOUS KEY
Rem and exits with code 1. The line number is inside machines/isam.shoddy
Rem itself (where IsamPrev's Error(...) call lives), not this file.
Rem
Rem Run: bin\mill run tst\isam-errors\prev-before-start.shoddy
Rem ==================================================================

Include "../../machines/isam.shoddy"

Type Kv
    K As Number
    V As String

Def RdKv(f As Number) As Kv
    Kv(GetNum(f), GetStr(f, 8))

Def WrKv(f As Number, r As Kv)
    PutNum(f, K(r))
    PutStr(f, V(r), 8)

Def KvKey(r As Kv) As Number
    K(r)

Def Main()
    If FileExists("_err_prev.tmp") Then
        DeleteFile("_err_prev.tmp")
    Let db = IsamOpen("_err_prev.tmp", 16, RdKv, WrKv, KvKey)
    Let db2 = IsamInsert(IsamInsert(db, Kv(1, "A")), Kv(2, "B"))
    IsamPrev(db2, 1)
