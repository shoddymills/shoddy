Rem ==================================================================
Rem isamfixture.shoddy — shared record shape for the isam.shoddy tests
Rem
Rem Included by both isamtest.shoddy (which builds the file) and
Rem isamdump.shoddy (a separate program that reopens it afterward) so
Rem the two agree byte-for-byte on the on-disk layout. Not a machines/
Rem library file — this is test-only fixture code, kept in tst/.
Rem ==================================================================

Type Item
    Id          As Number
    Description As String
    Available   As Boolean
    Price       As Number

Rem the file both isamtest.shoddy and isamdump.shoddy open
Let itemFile = "_isamtest.tmp"

Rem fixed width of the Description field on disk
Let itemDescWidth = 20

Rem Id (8) + Description (20) + Available (1) + Price (8) = 37 bytes;
Rem must exactly match what RdItem reads and WrItem writes below.
Let itemRecSize = 37

Def RdItem(f As Number) As Item
    Item(GetNum(f), GetStr(f, itemDescWidth), GetBool(f), GetNum(f))

Def WrItem(f As Number, it As Item)
    PutNum(f, Id(it))
    PutStr(f, Description(it), itemDescWidth)
    PutBool(f, Available(it))
    PutNum(f, Price(it))

Def ItemKey(it As Item) As Number
    Id(it)

Rem short, fixed-shape description that always fits itemDescWidth
Def MakeDesc(id As Number) As String
    "ITEM " & Str(id)
