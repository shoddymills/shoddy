Rem Plotter demo: the five classroom charts, one window each. Run with
Rem     mill run tst/plotter-demo.shoddy
Rem Same "open, draw, blit, return" shape as the turtle demo — no event
Rem loop; Main returns once all five are blitted and the windows stay
Rem up until closed. Seeded, so every run draws the same picture.

Include "../machines/seq.shoddy"
Include "../machines/plotter.shoddy"

Def Main()
    Seed(7)
    Let heights = Map(Range(1, 120), Fn(k) => 150 + Floor(Rnd() * 41))
    Let h1 = ScribblerBlit(PlotTitle(Histogram(ScribblerTitle(NewPlot(360, 260), "PLOTTER - HISTOGRAM"), heights, 8), "HEIGHTS, CM"))
    Let days = { "MON", "TUE", "WED", "THU", "FRI" }
    Let h2 = ScribblerBlit(PlotTitle(BarChart(ScribblerTitle(NewPlot(360, 260), "PLOTTER - BAR"), days, { 12, 19, 8, 15, 22 }), "MUFFINS SOLD"))
    Let h3 = ScribblerBlit(PlotTitle(PieChart(ScribblerTitle(NewPlot(360, 260), "PLOTTER - PIE"), { "CATS", "DOGS", "BIRDS" }, { 9, 7, 4 }), "CLASS PETS"))
    Let h4 = ScribblerBlit(PlotTitle(BoxPlot(ScribblerTitle(NewPlot(360, 200), "PLOTTER - BOX"), Append(heights, 320)), "HEIGHTS, ONE TALL TALE"))
    Let xs = Map(Range(1, 40), Fn(k) => k)
    Let ys = Map(xs, Fn(x) => 2 * x + Floor(Rnd() * 20))
    Let h5 = ScribblerBlit(PlotTitle(ScatterPlot(ScribblerTitle(NewPlot(360, 260), "PLOTTER - SCATTER"), xs, ys), "Y VS X"))
    Print("plotter demo done")
