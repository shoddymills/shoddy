Rem ==================================================================
Rem seedephemeristest.shoddy — test program for seedephemeris.shoddy
Rem
Rem Assert-driven, in the cuttletest / reckonertest / seedtest pattern:
Rem it prints what it is doing and stops the run at the first assertion
Rem that fails, ending with ALL ASSERTIONS PASSED when it does not.
Rem
Rem WHAT IS GRADED HERE. ephemeris.shoddy's arithmetic has its own
Rem known-answer suite (tst/ephemeris.shoddy) — the eclipse, the
Rem oppositions, Polaris. What is graded here is the BRIDGE: that the
Rem sky reaches the prompt in seedgeo's list shapes, that the one
Rem library abort (EPHPLANET's chooser) is refused instead, and that
Rem every malformed argument is a refusal with the stack intact.
Rem
Rem The Julian dates below are literals because this suite folds no
Rem calendar seed on purpose — the numbers were worked from
Rem tst/julian.shoddy's own fixtures: 2024-04-08 (the eclipse) is
Rem 2460408.5, 2024-12-15 (the standstill full moon) is 2460659.5,
Rem 2026-08-12 is 2461264.5.
Rem
Rem Every refusal is walked in the seed suite's two-part shape — the
Rem line refuses for the stated reason with the state as it was, AND a
Rem further line evaluates afterwards.
Rem
Rem Run: bin\mill run tst\seedephemeristest.shoddy   (from the repo root)
Rem ==================================================================

Include "../machines/cuttle.shoddy"
Include "../machines/reckoner.shoddy"
Include "../machines/seq.shoddy"
Include "../machines/str.shoddy"
Include "../machines/seeds/seedephemeris.shoddy"

Rem ---- reading an answer ------------------------------------------------

Def Ran(st As RckState, line As String) As RckState
    Select Case RckEval(st, line)
        Case RckNext(st2, out)
            st2
        Case RckStop(st2, why, out)
            st2
        Case Else
            st

Def Bad(st As RckState, line As String) As Boolean
    Select Case RckEval(st, line)
        Case RckStop(st2, why, out)
            True
        Case Else
            False

Def Why(st As RckState, line As String) As String
    Select Case RckEval(st, line)
        Case RckStop(st2, why, out)
            why
        Case Else
            ""

Def Text(st As RckState) As String
    Join(Map(CutCells(RckStack(st)), Fn(c) => CutShow(c, RckFmt(st))), " | ")

Def Deep(st As RckState) As Number
    CutDepth(RckStack(st))

Def TopNum(st As RckState) As Number
    If Deep(st) < 1 Then
        0 - 999999
    Else
        NumOf(First(CutCells(RckStack(st))))

Def NumOf(c As Cell) As Number
    Select Case c
        Case CutNum(x)
            x
        Case Else
            0 - 999999

Def Got(st As RckState, line As String) As Number
    TopNum(Ran(st, line))

Def Close(a As Number, b As Number, tol As Number) As Boolean
    Abs(a - b) <= tol

Rem How many items the top LIST holds — the way the Option encoding is
Rem read without folding a second seed for a LENGTH word.
Def TopCount(st As RckState) As Number
    If CutDepth(RckStack(st)) < 1 Then
        -1
    Else
        CountOf(First(CutCells(RckStack(st))))

Def CountOf(c As Cell) As Number
    Select Case c
        Case CutList(xs)
            Length(xs)
        Case Else
            -1

Def Q(s As String) As String
    Chr(34) & s & Chr(34)

Def Refuses(st As RckState, line As String, part As String) As Boolean
    Bad(st, line) And Instr(Why(st, line), part) > 0 And Text(Ran(st, line)) = Text(st) And Text(Ran(Ran(st, line), "1 1 +")) = Text(Ran(st, "1 1 +"))

Def Main()
    Let s0 = RckSeedEphemeris(RckNew())
    Let g = Ran(s0, "1 2")

    Print("--- the words are registered, pure, and carry their metadata ---")
    Assert(RckKnows(s0, "EPHSUN") And RckKnows(s0, "EPHMOON") And RckKnows(s0, "EPHPLANET"), "THE BODIES ARE IN THE DICTIONARY")
    Assert(RckKnows(s0, "EPHALTAZ") And RckKnows(s0, "EPHSEPARATION") And RckKnows(s0, "EPHSIDEREAL"), "AND THE OBSERVER'S WORDS")
    Assert(RckKnows(s0, "EPHMOONRISE") And RckKnows(s0, "EPHMOONSET") And RckKnows(s0, "EPHMOONPHASE"), "AND THE MOON'S DIARY")
    Assert(All(RckDict(s0), Fn(e) => WordEffect(e) <> "" And WordDesc(e) <> ""), "NO WORD IS WITHOUT AN EFFECT LINE AND A DESCRIPTION")
    Assert(All(RckDict(s0), Fn(e) => Length(RckHelp(s0, WordName(e))) = 3), "AND HELP ANSWERS FOR EVERY ONE OF THEM")
    Rem An ephemeris reaches no clock: the date is an argument, which is
    Rem the machine's own claim carried through to the prompt.
    Assert(All(RckDict(s0), Fn(e) => Not RckTouches(e)), "AND NOTHING IN THE WHOLE SEED TOUCHES THE WORLD")

    Print("--- the sky, against the fixtures the library suite pinned ---")
    Assert(Close(Got(s0, "2451544.5 12 EPHSIDEREAL"), 280.4606, 0.01), "SIDEREAL TIME AT J2000.0 IS THE EPOCH CONSTANT")
    Assert(Close(Got(s0, "{ 0 0 } { 180 0 } EPHSEPARATION"), 180, 0.0001), "OPPOSITE POINTS ON THE CELESTIAL EQUATOR ARE 180 APART")
    Assert(Got(s0, "2460408.5 18 EPHMOON 2460408.5 18 EPHSUN EPHSEPARATION") < 2,
           "AT 18:00 UT ON ECLIPSE DAY THE MOON WAS CROSSING THE SUN")
    Assert(Got(s0, "2460408.5 0 EPHMOONPHASE") < 0.02, "A SOLAR ECLIPSE HAPPENS AT NEW MOON")
    Assert(Got(s0, "2460408.5 18 EPHMOONDIST") > 356000000 And Got(s0, "2460408.5 18 EPHMOONDIST") < 407000000,
           "THE MOON'S DISTANCE SITS BETWEEN PERIGEE AND APOGEE")
    Assert(Got(s0, "EPHMERCURY 2461264.5 0 EPHPLANET 2461264.5 0 EPHSUN EPHSEPARATION") < 29,
           "MERCURY NEVER LEAVES THE SUN'S SIDE")
    Assert(Got(s0, "EPHMARS") = 4, "AND THE CHOOSERS KEEP THE EARTH'S SEAT: MARS IS 4")

    Print("--- the moon's diary answers as one-cell lists ---")
    Assert(TopCount(Ran(s0, "{ 89 0 } 2460659.5 EPHMOONRISE")) = 0,
           "AT THE STANDSTILL FULL MOON A DEGREE FROM THE POLE THERE IS NO MOONRISE")
    Assert(CutDepth(RckStack(Ran(s0, "{ 89 0 } 2460659.5 EPHMOONRISE"))) = 1,
           "STILL EXACTLY ONE CELL, WHICH IS WHAT UNDO COUNTS ON")
    Assert(TopCount(Ran(s0, "{ 89 0 } 2460659.5 EPHMOONSET")) = 0, "AND NO MOONSET")
    Assert(TopCount(Ran(s0, "{ 51.5074 -0.1278 } 2461264.5 EPHMOONRISE")) +
           TopCount(Ran(s0, "{ 51.5074 -0.1278 } 2461265.5 EPHMOONRISE")) >= 1,
           "TWO CONSECUTIVE LONDON DAYS HAVE AT LEAST ONE MOONRISE BETWEEN THEM")

    Print("--- the guards: the library's one abort is a refusal here ---")
    Assert(Refuses(g, "3 2461264.5 0 EPHPLANET", "WHERE YOU ARE STANDING"), "THE EARTH, WHICH EPHEMERIS ITSELF WOULD ABORT ON")
    Assert(Refuses(g, "9 2461264.5 0 EPHPLANET", "THERE IS NO PLANET"), "AND A PLANET THE TABLE DOES NOT CARRY")
    Assert(Refuses(g, "2.5 2461264.5 0 EPHPLANET", "THERE IS NO PLANET"), "AND HALF A PLANET")
    Assert(Refuses(g, "{ 1 } { 0 0 } EPHSEPARATION", "needs a sky position"), "A ONE-ELEMENT SKY LIST")
    Assert(Refuses(g, "{ 0 91 } { 0 0 } EPHSEPARATION", "OUTSIDE -90..90"), "A DECLINATION PAST THE POLE - PROBABLY A POINT IN A SKY'S PLACE")
    Assert(Refuses(g, "{ 91 0 } { 37.95 89.264 } 2461264.5 0 EPHALTAZ", "EPHALTAZ"), "AN OBSERVER OFF THE PLANET")
    Assert(Refuses(g, Q("noon") & " 12 EPHSIDEREAL", "needs"), "A STRING WHERE THE DATE SHOULD BE")
    Assert(Refuses(g, "{ 51.5 0 } " & Q("today") & " EPHMOONRISE", "needs"), "AND ONE WHERE THE DATE OF A MOONRISE SHOULD BE")

    Print("--- nothing above cost the session anything ---")
    Assert(Text(Ran(g, "1 1 +")) = "2 | 2 | 1", "THE STACK IS STILL THERE AND STILL EVALUATING")

    Print("")
    Print("ALL ASSERTIONS PASSED")
