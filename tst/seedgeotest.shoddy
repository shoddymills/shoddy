Rem ==================================================================
Rem seedgeotest.shoddy — test program for seeds/seedgeo.shoddy
Rem
Rem Assert-driven, in the cuttletest / reckonertest / seedtest pattern:
Rem it prints what it is doing and stops the run at the first assertion
Rem that fails, ending with ALL ASSERTIONS PASSED when it does not.
Rem
Rem WHAT IS GRADED HERE IS THE BRIDGE, NOT THE ARITHMETIC. Every number
Rem geo computes is already pinned in tst/geo.shoddy against
Rem independently worked values; repeating that here would be a second
Rem set of fixtures to keep in step with the first. What only shows up
Rem once the words are in a dictionary is the part this file is for:
Rem
Rem   * the shape of an argument at a prompt — a point is a two-element
Rem     LIST and a route is a LIST of them
Rem   * that NOTHING KEYABLE ABORTS. Every guard geo performs with Error
Rem     has to come back as a refusal instead, and a refused line has to
Rem     leave the stack exactly as it was. That is the contract the
Rem     whole reckoner rests on and it is most of the assertions below.
Rem   * that an Option arrives as a one-cell LIST, empty for None
Rem   * that every word is registered, grouped and documented
Rem
Rem THE ABORT-SAFETY BLOCK IS THE POINT OF THIS FILE. geo aborts on a
Rem latitude outside -90..90, on an empty route where bounds are wanted,
Rem on a polygon of fewer than three distinct points, on a geohash
Rem length below one and on a locator length that is not 2, 4, 6 or 8.
Rem Each of those is keyed below and asserted to REFUSE — and if any one
Rem of them ever reaches the abort instead, this suite does not fail, it
Rem dies, which is itself the signal.
Rem
Rem Run: bin\mill run tst\seedgeotest.shoddy      (from the repo root)
Rem ==================================================================

Include "../machines/cuttle.shoddy"
Include "../machines/reckoner.shoddy"
Include "../machines/seq.shoddy"
Include "../machines/str.shoddy"
Include "../machines/seeds/seedgeo.shoddy"

Rem ---- reading an answer ------------------------------------------------

Def Ran(st As RckState, line As String) As RckState
    Select Case RckEval(st, line)
        Case RckNext(st2, out)
            st2
        Case RckStop(st2, why, out)
            st2
        Case Else
            st

Def Bad(st As RckState, line As String) As Boolean
    Select Case RckEval(st, line)
        Case RckStop(st2, why, out)
            True
        Case Else
            False

Def Text(st As RckState) As String
    Join(Map(CutCells(RckStack(st)), Fn(c) => CutShow(c, RckFmt(st))), " | ")

Def TopNum(st As RckState) As Number
    If CutDepth(RckStack(st)) < 1 Then
        0 - 999999
    Else
        NumOf(First(CutCells(RckStack(st))))

Def NumOf(c As Cell) As Number
    Select Case c
        Case CutNum(x)
            x
        Case Else
            0 - 999999

Def TopText(st As RckState) As String
    If CutDepth(RckStack(st)) < 1 Then
        ""
    Else
        TextOf(First(CutCells(RckStack(st))))

Def TextOf(c As Cell) As String
    Select Case c
        Case CutStr(t)
            t
        Case Else
            ""

Rem How many cells the top LIST holds, or -1 if the top is not a LIST.
Def TopCount(st As RckState) As Number
    If CutDepth(RckStack(st)) < 1 Then
        -1
    Else
        CountOf(First(CutCells(RckStack(st))))

Def CountOf(c As Cell) As Number
    Select Case c
        Case CutList(xs)
            Length(xs)
        Case Else
            -1

Def Q(s As String) As String
    Chr(34) & s & Chr(34)

Def Near(a As Number, b As Number, tol As Number) As Boolean
    Abs(a - b) <= tol

Def Main()
    Let s0 = RckSeedGeo(RckNew())

    Print("--- the seed is in the dictionary, grouped and documented ---")
    Assert(RckKnows(s0, "GEODIST"), "THE FIRST WORD IS THERE")
    Assert(RckKnows(s0, "GEOHORIZON"), "AND THE LAST ONE")
    Assert(Contains(RckWords(s0), "-- seed-geo --"), "AND IT HAS A GROUP OF ITS OWN")
    Assert(Length(RckHelp(s0, "GEODIST")) = 3, "AND HELP ANSWERS FOR IT")
    Assert(RckKnows(s0, "GEOJULIAN"), "GEOJULIAN IS BRIDGED, OR THE SUN WORDS COULD NOT BE REACHED")

    Print("--- a point at a prompt is a two-element LIST ---")
    Let d1 = Ran(s0, "{ 53.72 -1.86 } { 51.5074 -0.1278 } GEODIST")
    Assert(Near(TopNum(d1), 250000, 30000), "LEEDS TO LONDON IS ABOUT 250 KM")
    Assert(CutDepth(RckStack(d1)) = 1, "AND IT LEAVES EXACTLY ONE CELL")

    Let b1 = Ran(s0, "{ 51.5074 -0.1278 } { 48.8566 2.3522 } GEOBEARING")
    Assert(Near(TopNum(b1), 148.1156169, 0.0001), "LONDON TO PARIS BEARS 148 DEGREES")

    Print("--- a route is a LIST of them ---")
    Let r1 = Ran(s0, "{ { 51.5074 -0.1278 } { 48.8566 2.3522 } } GEOROUTELEN")
    Assert(Near(TopNum(r1), 343556.5349, 1), "A TWO-POINT ROUTE IS ONE LEG")
    Let r2 = Ran(s0, "{ } GEOROUTELEN")
    Assert(TopNum(r2) = 0, "AND AN EMPTY ROUTE IS ZERO LONG, NOT A REFUSAL")

    Print("--- a point comes back in the shape it went in ---")
    Let m1 = Ran(s0, "{ 0 179 } { 0 -179 } GEOMID")
    Assert(TopCount(m1) = 2, "GEOMID ANSWERS A TWO-ELEMENT LIST")
    Let d2 = Ran(s0, "{ 51.5074 -0.1278 } 90 1000 GEODEST")
    Assert(TopCount(d2) = 2, "AND SO DOES GEODEST")
    Let sq = Ran(Ran(s0, "{ 51.5074 -0.1278 } 90 1000 GEODEST"), "{ 51.5074 -0.1278 } SWAP GEODIST")
    Assert(Near(TopNum(sq), 1000, 0.001), "AND WHAT GEODEST ANSWERS IS A THOUSAND METRES AWAY")

    Print("--- the box is five cells, and the flag is one of them ---")
    Let x1 = Ran(s0, "{ { 0 179 } { 0 -179 } } GEOBOUNDS")
    Assert(TopCount(x1) = 5, "SOUTH, NORTH, WEST, EAST AND WHETHER IT WRAPS")

    Print("--- text in, text out ---")
    Let t1 = Ran(s0, "53.72 1 GEODMS")
    Assert(TopText(t1) = "53" & Chr(176) & "43'12.0" & Chr(34), "GEODMS WRITES AN ANGLE OUT")
    Let t2 = Ran(s0, Q("53 43 12 N, 1 51 36 W") & " GEOPARSE")
    Assert(TopCount(t2) = 2, "GEOPARSE READS A WRITTEN COORDINATE BACK AS A POINT")
    Let t3 = Ran(s0, "{ 51.5074 -0.1278 } 6 GEOLOCATOR")
    Assert(TopText(t3) = "IO91wm", "GEOLOCATOR ANSWERS LONDON'S GRID SQUARE")
    Let t4 = Ran(s0, "{ 51.5 -0.1 } 5 GEOHASH")
    Assert(Left(TopText(t4), 1) = "g", "AND GEOHASH PUTS LONDON IN CELL G")
    Let t5 = Ran(s0, "22.5 GEOCOMPASS")
    Assert(TopText(t5) = "NNE", "GEOCOMPASS NAMES A BEARING")

    Print("--- an Option is one cell holding a LIST ---")
    Let j1 = Ran(s0, "2024 6 20 GEOJULIAN")
    Assert(Near(TopNum(j1), 2460481.5, 0.000001), "GEOJULIAN ANSWERS A JULIAN DATE")
    Let u1 = Ran(s0, "{ 51.5074 -0.1278 } 2460481.5 GEOSUNRISE")
    Assert(TopCount(u1) = 1, "A SUNRISE THAT HAPPENS IS A ONE-ITEM LIST")
    Let u2 = Ran(s0, "{ 70 0 } 2460481.5 GEOSUNRISE")
    Assert(TopCount(u2) = 0, "AND ONE THAT DOES NOT IS AN EMPTY LIST, NOT A REFUSAL")
    Assert(CutDepth(RckStack(u2)) = 1, "STILL EXACTLY ONE CELL, WHICH IS WHAT UNDO COUNTS ON")
    Let u3 = Ran(s0, "{ 70 0 } 2460481.5 GEODAYLENGTH")
    Assert(Near(TopNum(u3), 24, 0.000001), "AND THE DAY IS TWENTY-FOUR HOURS LONG THERE")

    Print("--- NOTHING KEYABLE ABORTS: every geo guard, asked ---")
    Assert(Bad(s0, "{ 91 0 } { 0 0 } GEODIST"), "A LATITUDE OF 91 REFUSES")
    Assert(Bad(s0, "{ 0 181 } { 0 0 } GEODIST"), "AND A LONGITUDE OF 181")
    Assert(Bad(s0, "{ 53.72 } { 0 0 } GEODIST"), "AND A POINT OF ONE NUMBER")
    Assert(Bad(s0, "{ 53.72 -1.86 0 } { 0 0 } GEODIST"), "AND A POINT OF THREE")
    Assert(Bad(s0, "{ " & Q("north") & " -1.86 } { 0 0 } GEODIST"), "AND A POINT MADE OF TEXT")
    Assert(Bad(s0, "53.72 { 0 0 } GEODIST"), "AND A BARE NUMBER WHERE A POINT BELONGS")
    Assert(Bad(s0, "{ } GEOBOUNDS"), "AN EMPTY ROUTE HAS NO BOUNDS, AND SAYS SO")
    Assert(Bad(s0, "{ { 0 0 } { 0 1 } } GEOAREA"), "TWO POINTS ARE NOT A POLYGON")
    Assert(Bad(s0, "{ { 0 0 } { 0 1 } { 0 0 } } GEOAREA"), "AND NOR IS A RING WITH ONLY TWO DISTINCT CORNERS")
    Assert(Bad(s0, "{ 51.5 -0.1 } 0 GEOHASH"), "A GEOHASH OF NO CHARACTERS REFUSES")
    Assert(Bad(s0, "{ 51.5 -0.1 } 5 GEOLOCATOR"), "AND A LOCATOR OF FIVE")
    Assert(Bad(s0, "{ 51.5 -0.1 } 3 GEOLOCATOR"), "AND ONE OF THREE")
    Assert(Bad(s0, "2024 13 1 GEOJULIAN"), "AND A THIRTEENTH MONTH")
    Assert(Bad(s0, Q("nowhere in particular") & " GEOPARSE"), "TEXT THAT IS NOT A COORDINATE REFUSES")
    Assert(Bad(s0, "{ 0 0 } GEODIST"), "AND SO DOES A LINE WITH TOO FEW ARGUMENTS")

    Print("--- a refused line leaves the stack exactly as it was ---")
    Let keep = Ran(s0, "1 2 3")
    Assert(Text(Ran(keep, "{ 91 0 } { 0 0 } GEODIST")) = Text(keep), "THE THREE NUMBERS ARE STILL THERE AFTER A REFUSAL")
    Assert(CutDepth(RckStack(Ran(keep, "{ } GEOBOUNDS"))) = 3, "AND THE DEPTH IS UNCHANGED")

    Print("--- the corners of the domain are inside it ---")
    Assert(Not Bad(s0, "{ 90 180 } { -90 -180 } GEODIST"), "BOTH POLES AND BOTH ENDS OF THE DATE LINE ARE LEGAL")
    Assert(Near(TopNum(Ran(s0, "{ 90 0 } { -90 0 } GEODIST")), 20015114, 100), "AND POLE TO POLE IS HALF THE WAY ROUND")

    Print("ALL ASSERTIONS PASSED")
