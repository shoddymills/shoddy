Rem Shaker demo: sealing a high-score table so it cannot be edited in a
Rem text editor. Run with
Rem     mill run tst/shaker-demo.shoddy
Rem It writes _shaker-demo.tmp, reads it back, then shows what happens
Rem when the file is tampered with and when the key is wrong — the two
Rem cases the guard pair exists for. Deletes its file on the way out.
Rem
Rem Obfuscation, not secrecy: see the header of machines/shaker.shoddy.

Include "../machines/shaker.shoddy"
Include "../machines/file.shoddy"

Rem The key would normally be built into the program rather than sitting
Rem here in plain sight, which tells you most of what you need to know
Rem about how much this protects.
Def DemoKey() As List Of Number
    { 4021, 55117, 903, 31337, 12289 }

Rem A score table as a flat list: name length, the name's code units,
Rem then the score. Flat because the machine deals in Numbers only.
Def PackEntry(who As String, score As Number) As List Of Number
    Concat(Prepend(Len(who), Map(Range(1, Len(who)), Fn(k) => Asc(Mid(who, k, 1)))), { score })

Def ShowEntry(xs As List Of Number)
    Let n = First(xs)
    Let who = Fold(Map(Range(1, n), Fn(k) => Nth(xs, k + 1)), "", Fn(a, c) => a & Chr(c))
    Print("  " & PadRight(who, 10) & PadLeft(Str(Nth(xs, n + 2)), 8))

Rem Walk the flat table entry by entry. A void base case wants a bodiless
Rem If — padding it with a dummy call is how written output gets corrupted.
Def ShowAll(xs As List Of Number)
    If Not IsEmpty(xs) Then
        Let n = First(xs)
        ShowEntry(Taken(xs, n + 2))
        ShowAll(DropN(xs, n + 2))

Def Main()
    Let table = Concat(Concat(PackEntry("ADA", 96000), PackEntry("GRACE", 88250)), PackEntry("LIN", 78400))
    Print("the table, in the clear:")
    Print(table)
    ShowAll(table)

    Let sealed = ShakeEncrypt(table, DemoKey())
    Print("")
    Print("sealed (" & Str(Length(sealed)) & " values, the last one the tag):")
    Print(sealed)

    Rem Store it as text, one number per line — the point being that what
    Rem lands on disk carries no readable trace of ADA or 96000.
    WriteLines("_shaker-demo.tmp", Map(sealed, Str))
    Print("")
    Print("on disk, first four lines:")
    Each(Taken(ReadLines("_shaker-demo.tmp"), 4), Fn(l) => Print("  " & l))

    Let loaded = Map(ReadLines("_shaker-demo.tmp"), Val)
    Let opened = ShakeDecrypt(loaded, DemoKey())
    Print("")
    Print("read back and opened:")
    ShowAll(opened)

    Rem Someone edits the file. The tag catches it, and the total word
    Rem hands back the fallback instead of a table of nonsense.
    Let edited = Prepend(ShakeWrap(First(loaded) + 1), Rest(loaded))
    Print("")
    Print("after a single edited value:")
    Print("  verifies:  " & Ifte(ShakeVerify(edited), "yes", "no"))
    Print("  recovered: " & Str(Length(ShakeDecryptOr(edited, DemoKey(), { }))) & " values (the fallback)")

    Rem The right file, the wrong key: the tag still matches, because the
    Rem tag is over the ciphertext and knows nothing about the key. What
    Rem comes back is rubbish, and it is rubbish you must be ready for.
    Print("")
    Print("with the wrong key, the tag still passes:")
    Print("  verifies:  " & Ifte(ShakeVerify(loaded), "yes", "no"))
    Print("  recovered: ")
    Print(ShakeDecryptOr(loaded, { 1, 2, 3 }, { }))

    DeleteFile("_shaker-demo.tmp")
