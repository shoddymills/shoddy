<?xml version="1.0" encoding="UTF-8"?>
<!-- Every node type xml.shoddy knows, in one document. Hand-written, and
     deliberately NOT canonical: the single-quoted attribute, the numeric
     character references and the &#x41; below all come back as their
     canonical spelling, which is what makes this the round-trip test
     that sitemap.xml cannot be. -->
<?display mode="compact" width="72"?>
<catalogue xmlns:m="urn:mill" count="3" open="yes">
  <mill id="m1" m:grade="shoddy">
    <name>Batley</name>
    <note>Rags &amp; bones, 1 &lt; 2, said "so" 'twice'</note>
    <built year="1854"/>
  </mill>
  <mill id="m2" m:grade="mungo">
    <name>Dewsbury</name>
    <note>A A and a B walk in</note>
    <built year="1861"/>
  </mill>
  <mill id="m3" m:grade="shoddy">
    <name>Ossett</name>
    <note>Mixed content: the <em>emphasis</em> and the text around it must
    not be re-indented, or the spacing changes.</note>
    <built year="1872"/>
    <recipe><![CDATA[if (a < b && c > d) { keep("this <raw>"); }]]></recipe>
  </mill>
  <!-- a trailing remark -->
</catalogue>
