Rem ==================================================================
Rem Headless checks for the pure half. No window opens, so this runs
Rem anywhere — including a build server — which is the whole reason the
Rem geometry lives apart from the drawing.
Rem
Rem Run: mill run test.shoddy   (or ./build.sh test)
Rem
Rem Assert stops the program on the first failure and prints the
Rem message, so a silent run that reaches the last line is a pass.
Rem ==================================================================

Include "seq.shoddy"
Include "spiro-core.shoddy"

Def InRange(v As Number) As Boolean
    v >= 0 And v <= 255

Def Main()
    Let p = Plan(DefaultSteps())

    Assert(Length(p) = DefaultSteps(), "THE PLAN HAS ONE STEP PER TURN")

    Rem A colour channel outside 0..255 would abort the drawing at the
    Rem first bad step, and only ever at the step that overflowed — so
    Rem the plan is checked all at once, here, instead.
    Assert(All(p, Fn(s) => InRange(Red(s))), "RED STAYS IN RANGE")
    Assert(All(p, Fn(s) => InRange(Green(s))), "GREEN STAYS IN RANGE")
    Assert(All(p, Fn(s) => InRange(Blue(s))), "BLUE STAYS IN RANGE")

    Rem The spiral opens because every step reaches further than the one
    Rem before it.
    Assert(Ahead(First(p)) < Ahead(Last(p)), "THE SPIRAL OPENS OUTWARD")
    Assert(All(p, Fn(s) => Ahead(s) > 0), "EVERY STEP DRAWS SOMETHING")

    Rem And it precesses because the turn never divides a full circle.
    Assert(All(p, Fn(s) => Turn(s) = TurnAngle()), "EVERY TURN IS THE SAME ANGLE")
    Assert(360 Mod TurnAngle() <> 0, "THE ANGLE MISSES THE CORNER")

    Print("ALL SPIRO CHECKS PASSED")
