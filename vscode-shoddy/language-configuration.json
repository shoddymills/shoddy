{
    "comments": { "lineComment": "'" },
    "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]
    ],
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?i:(Def\\b.*|Type\\s+[A-Za-z_]\\w*\\s*$|If\\b.*\\bThen\\s*$|If\\s*$|Else\\s*$|Select\\s+Case\\b.*|Case\\b.*))$",
        "decreaseIndentPattern": "^\\s*(?i:(Else|Case\\b.*))\\s*$"
    }
}
