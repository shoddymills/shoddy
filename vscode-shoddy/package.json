{
    "name": "vscode-shoddy",
    "displayName": "Shoddy",
    "description": "Shoddy language support: highlighting, snippets, and mill commands — run, weave, build machine, show generated C#.",
    "version": "0.9.4",
    "publisher": "shoddy-mill",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "https://github.com/stephenvfoster/shoddy.git",
        "directory": "vscode-shoddy"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "main": "./extension.js",
    "activationEvents": [],
    "contributes": {
        "languages": [
            {
                "id": "shoddy",
                "aliases": [
                    "Shoddy",
                    "shoddy"
                ],
                "extensions": [
                    ".shoddy"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "shoddy",
                "scopeName": "source.shoddy",
                "path": "./syntaxes/shoddy.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "shoddy",
                "path": "./snippets/shoddy.json"
            }
        ],
        "breakpoints": [
            {
                "language": "shoddy"
            }
        ],
        "debuggers": [
            {
                "type": "shoddy",
                "label": "Shoddy (perch)",
                "languages": [
                    "shoddy"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the .shoddy program to debug.",
                                "default": "${file}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Pause on the first line.",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "shoddy",
                        "request": "launch",
                        "name": "Perch: debug current file",
                        "program": "${file}",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Shoddy: Perch (debug current file)",
                        "body": {
                            "type": "shoddy",
                            "request": "launch",
                            "name": "Perch: debug current file",
                            "program": "^\"\\${file}\"",
                            "stopOnEntry": true
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "shoddy.run",
                "title": "Run File",
                "category": "Shoddy",
                "icon": "$(play)"
            },
            {
                "command": "shoddy.weave",
                "title": "Weave File (compile)",
                "category": "Shoddy"
            },
            {
                "command": "shoddy.machine",
                "title": "Build Machine from File",
                "category": "Shoddy"
            },
            {
                "command": "shoddy.gen",
                "title": "Show Generated C#",
                "category": "Shoddy"
            }
        ],
        "keybindings": [
            {
                "command": "shoddy.run",
                "key": "ctrl+r",
                "when": "editorLangId == shoddy && editorTextFocus"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "command": "shoddy.run",
                    "when": "resourceLangId == shoddy",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "shoddy.run",
                    "when": "resourceLangId == shoddy",
                    "group": "shoddy@1"
                },
                {
                    "command": "shoddy.weave",
                    "when": "resourceLangId == shoddy",
                    "group": "shoddy@2"
                },
                {
                    "command": "shoddy.machine",
                    "when": "resourceLangId == shoddy",
                    "group": "shoddy@3"
                },
                {
                    "command": "shoddy.gen",
                    "when": "resourceLangId == shoddy",
                    "group": "shoddy@4"
                }
            ]
        },
        "configuration": {
            "title": "Shoddy",
            "properties": {
                "shoddy.millPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the mill executable. Empty: use bin/mill in the workspace if present, else `mill` on PATH."
                }
            }
        }
    }
}
