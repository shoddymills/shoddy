{
    "Def (expression body)": {
        "prefix": "def",
        "body": [
            "Def ${1:Name}(${2:x} As ${3:Number}) As ${4:Number}",
            "    $0"
        ],
        "description": "Applicative definition with typed parameters"
    },
    "Def (stack body)": {
        "prefix": "sdef",
        "body": [
            "Def ${1:Name} ( ${2:a} -- ${3:b} )",
            "    $0"
        ],
        "description": "Concatenative definition with a stack-effect signature"
    },
    "Def Main": {
        "prefix": "main",
        "body": [
            "Def Main()",
            "    $0"
        ],
        "description": "The program entry point"
    },
    "Type (record)": {
        "prefix": "type",
        "body": [
            "Type ${1:Name}",
            "    ${2:Field} As ${3:Number}",
            "    ${4:Other} As ${5:String}",
            "$0"
        ],
        "description": "Record type declaration"
    },
    "Type (sum)": {
        "prefix": "sum",
        "body": [
            "Type ${1:Name} = ${2:Some}(${3:value}) | ${4:None}"
        ],
        "description": "Sum type: each variant is a constructor and a pattern"
    },
    "If / Else": {
        "prefix": "if",
        "body": [
            "If ${1:cond} Then",
            "    ${2}",
            "Else",
            "    $0"
        ],
        "description": "Conditional expression"
    },
    "Select Case": {
        "prefix": "select",
        "body": [
            "Select Case ${1:expr}",
            "    Case ${2:value}",
            "        ${3}",
            "    Case Else",
            "        $0"
        ],
        "description": "Value matching: equality, ranges, comparisons, patterns"
    },
    "Case pattern with guard": {
        "prefix": "casew",
        "body": [
            "Case ${1:Type}(${2:x}) Where ${3:guard}",
            "    $0"
        ],
        "description": "Destructuring pattern clause; a failing Where falls through"
    },
    "Fn lambda": {
        "prefix": "fn",
        "body": ["Fn(${1:x}) => $0"],
        "description": "Inline lambda (compiles to a quotation)"
    },
    "Let": {
        "prefix": "let",
        "body": ["Let ${1:name} = $0"],
        "description": "Bind once; top level Lets run before Main"
    },
    "Each with lambda": {
        "prefix": "each",
        "body": ["Each(${1:xs}, Fn(${2:x}) => ${0:Print(${2:x})})"],
        "description": "Iterate a list or array for effect"
    },
    "Include": {
        "prefix": "include",
        "body": ["Include \"${1:machines/seq.shoddy}\""],
        "description": "Splice a source file, or link its machine DLL if built"
    }
}
