{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Shoddy",
    "scopeName": "source.shoddy",
    "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#def-header" },
        { "include": "#type-header" },
        { "include": "#include" },
        { "include": "#keywords" },
        { "include": "#word-operators" },
        { "include": "#constants" },
        { "include": "#builtins" },
        { "include": "#number" },
        { "include": "#effect" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "name": "comment.line.apostrophe.shoddy",
                    "match": "'.*$"
                },
                {
                    "name": "comment.line.rem.shoddy",
                    "match": "(?i)(?<![\\w])Rem\\b.*$"
                }
            ]
        },
        "string": {
            "name": "string.quoted.double.shoddy",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.shoddy",
                    "match": "\\\\[\\\\\"ntr]"
                }
            ]
        },
        "def-header": {
            "match": "(?i)^\\s*(Def)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.declaration.function.shoddy" },
                "2": { "name": "entity.name.function.shoddy" }
            }
        },
        "type-header": {
            "match": "(?i)^\\s*(Type)\\s+([A-Za-z_]\\w*)",
            "captures": {
                "1": { "name": "keyword.declaration.type.shoddy" },
                "2": { "name": "entity.name.type.shoddy" }
            }
        },
        "include": {
            "match": "(?i)^\\s*(Include)\\b",
            "name": "keyword.control.import.shoddy"
        },
        "keywords": {
            "match": "(?i)\\b(If|Then|Else|Select|Case|To|Is|Where|Take|Let|Fn|As|Def|Type)\\b",
            "name": "keyword.control.shoddy"
        },
        "word-operators": {
            "match": "(?i)\\b(And|Or|Not|Mod)\\b",
            "name": "keyword.operator.word.shoddy"
        },
        "constants": {
            "match": "(?i)\\b(True|False|Pi)\\b",
            "name": "constant.language.shoddy"
        },
        "builtins": {
            "match": "(?i)\\b(Dup|Drop|Swap|Over|Rot|Nip|Tuck|Depth|Negate|Abs|Min|Max|Sqr|Floor|Ceil|Round|Sin|Cos|Tan|Atn|Exp|Log|Rnd|Error|Assert|Instr|Len|Str|Val|Left|Right|Mid|Chr|Asc|Upper|Lower|Print|ReadFile|WriteFile|AppendFile|FileExists|DeleteFile|BOpen|BClose|Seek|BPos|BSize|PutNum|GetNum|PutBool|GetBool|PutStr|GetStr|Input|Call|Ifte|Map|Filter|Fold|Each|Times|Range|Length|Reverse|Concat|IsEmpty|First|Nth|SetNth|Dim|ToArray|ToList|Rest|Prepend|With)\\b",
            "name": "support.function.builtin.shoddy"
        },
        "number": {
            "match": "(?<![\\w.])-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b",
            "name": "constant.numeric.shoddy"
        },
        "effect": {
            "match": "--",
            "name": "keyword.operator.effect.shoddy"
        },
        "operators": {
            "match": "<>|<=|>=|=>|[-+*/^&=<>|]",
            "name": "keyword.operator.shoddy"
        },
        "punctuation": {
            "patterns": [
                {
                    "match": "[\\[\\]]",
                    "name": "punctuation.section.quotation.shoddy"
                },
                {
                    "match": "[{}]",
                    "name": "punctuation.section.list.shoddy"
                },
                {
                    "match": "[(),]",
                    "name": "punctuation.shoddy"
                }
            ]
        }
    }
}
